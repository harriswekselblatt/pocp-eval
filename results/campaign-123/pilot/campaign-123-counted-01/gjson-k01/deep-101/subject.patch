+// parseBoolString reads a string as a bool like strconv.ParseBool, ignoring
+// case. ok is false when the string is not a bool.
+func parseBoolString(s string) (value, ok bool) {
+	b, err := strconv.ParseBool(strings.ToLower(s))
+	return b, err == nil
+}
+
 func nullish(t Result) bool {
 	return t.Type == Null

+			if (isResolved) {
+				return;
+			}
+
 			isRejected = true;
 			isResolved = true;
 			reject_(reason);
 			cleanup();
+
+			if (!isIterableDone) {
+				closeIterator(iterator);
+			}
 		};
 
 		if (signal) {
@@ -285,16 +293,18 @@ export function pMapIterable(

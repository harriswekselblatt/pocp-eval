-	modifiers[name] = fn
+	if stockModifiers[name] != nil {
+		// User wants to overwrite stock modifier. Ignore request
+	} else {
+		userModifiersLock.Lock()
+		userModifiers[name] = fn
+		userModifiersLock.Unlock()
+	}

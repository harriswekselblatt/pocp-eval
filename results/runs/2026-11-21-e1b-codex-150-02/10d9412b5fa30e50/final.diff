diff --git a/solution.py b/solution.py
index 6e6d26a..2aa0451 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,26 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    modulus = 998244353
+    if W > H:
+        grid = list(zip(*grid))
+        H, W = W, H
+
+    # The frontier holds the most recently assigned color in each column.
+    counts = {(0,) * W: 1}
+    for row in grid:
+        for column, cell in enumerate(row):
+            colors = (1, 2, 3) if cell == '?' else (int(cell),)
+            next_counts = {}
+            for frontier, count in counts.items():
+                above = frontier[column]
+                left = frontier[column - 1] if column else 0
+                for color in colors:
+                    if color != above and color != left:
+                        updated = frontier[:column] + (color,) + frontier[column + 1:]
+                        next_counts[updated] = (next_counts.get(updated, 0) + count) % modulus
+            counts = next_counts
+            if not counts:
+                return 0
+
+    return sum(counts.values()) % modulus

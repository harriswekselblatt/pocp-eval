--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,6 @@
+from collections import deque
+
+
 def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     """ Given two strings s and t of length n consisting of 'B' and 'W' characters,
     determine the minimum number of operations needed to transform the initial configuration s
@@ -29,4 +32,32 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    pass
+    if s == t:
+        return 0
+    if s.count('B') != t.count('B'):
+        return -1
+
+    start = s + '..'
+    target = t + '..'
+    queue = deque([(start, n, 0)])
+    visited = {start}
+
+    while queue:
+        board, empty, distance = queue.popleft()
+        for pair in range(n + 1):
+            if abs(pair - empty) < 2:
+                continue
+
+            left, right = sorted((pair, empty))
+            moved = (
+                board[:left] + board[right:right + 2]
+                + board[left + 2:right] + board[left:left + 2]
+                + board[right + 2:]
+            )
+            if moved == target:
+                return distance + 1
+            if moved not in visited:
+                visited.add(moved)
+                queue.append((moved, pair, distance + 1))
+
+    return -1

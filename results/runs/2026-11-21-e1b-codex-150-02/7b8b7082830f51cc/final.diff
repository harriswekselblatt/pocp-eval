+from math import gcd
+
+
 def can_color_all_points(n: int, k: int) -> bool:
     """ Alice and Bob are on a circle with n equally spaced points numbered 0 to n-1.
     Alice is at point 0, Bob is at point k. Initially all points are white.
@@ -22,4 +25,13 @@ def can_color_all_points(n: int, k: int) -> bool:
     >>> can_color_all_points(6, 1)
     True
     """
-    pass
+    # The two reflections form paths and cycles. A move either starts at a
+    # fixed point or colors the reflection of the previous move, so cycles
+    # cannot be started. Composing the reflections rotates by 2*k.
+    #
+    # Odd n has one path, which must span the circle. Even n has two
+    # paths, which must span the two parity classes. When n is divisible
+    # by four, Alice's two fixed points are both even. If Bob's are odd,
+    # Alice's path would have even length but need to start and end on
+    # her turn. If Bob's are even, the odd class has no fixed point.
+    return n % 4 != 0 and gcd(n, 2 * k) == gcd(n, 2)

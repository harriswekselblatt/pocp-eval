@@ -1,4 +1,5 @@
 from typing import List, Tuple
+from functools import lru_cache
 
 
 def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
@@ -24,4 +25,39 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    full_grid = (1 << (h * w)) - 1
+    shapes = [tuple(sorted(tile)) for tile in tiles[:n]]
+    areas = [a * b for a, b in shapes]
+
+    @lru_cache(maxsize=None)
+    def search(occupied: int, remaining: int, uncovered_area: int) -> bool:
+        if not uncovered_area:
+            return True
+        if sum(area for i, area in enumerate(areas) if remaining & (1 << i)) < uncovered_area:
+            return False
+
+        # Any tile covering the first empty cell must start there, since
+        # cells above it or to its left in the same row are already occupied.
+        empty = full_grid ^ occupied
+        start = (empty & -empty).bit_length() - 1
+        row, col = divmod(start, w)
+        tried = set()
+
+        for i, (a, b) in enumerate(shapes):
+            tile_bit = 1 << i
+            if not remaining & tile_bit or (a, b) in tried or areas[i] > uncovered_area:
+                continue
+            tried.add((a, b))
+            orientations = ((a, b),) if a == b else ((a, b), (b, a))
+            for height, width in orientations:
+                if row + height > h or col + width > w:
+                    continue
+                row_bits = (1 << width) - 1
+                placement = sum(row_bits << (start + offset * w) for offset in range(height))
+                if not occupied & placement and search(
+                    occupied | placement, remaining ^ tile_bit, uncovered_area - areas[i]
+                ):
+                    return True
+        return False
+
+    return search(0, (1 << len(shapes)) - 1, h * w)

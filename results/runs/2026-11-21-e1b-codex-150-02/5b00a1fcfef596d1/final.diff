diff --git a/solution.py b/solution.py
index 6e6d26a..2b40ee7 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,31 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    if W > H:
+        grid = ["".join(column) for column in zip(*grid)]
+
+    modulus = 998244353
+    color_bits = {"?": 0b1110, "1": 0b0010, "2": 0b0100, "3": 0b1000}
+    counts = {0: 1}
+    for row in grid:
+        for column, cell in enumerate(row):
+            shift = 2 * column
+            allowed = color_bits[cell]
+            next_counts = {}
+            # Each two-bit slot holds the most recently assigned color in its column.
+            # Zero represents a missing neighbor above the first row.
+            for state, count in counts.items():
+                above = (state >> shift) & 3
+                left = (state >> (shift - 2)) & 3 if column else 0
+                choices = allowed & ~((1 << above) | (1 << left))
+                cleared = state ^ (above << shift)
+                while choices:
+                    bit = choices & -choices
+                    choices ^= bit
+                    color = bit.bit_length() - 1
+                    updated = cleared | (color << shift)
+                    next_counts[updated] = (next_counts.get(updated, 0) + count) % modulus
+            if not next_counts:
+                return 0
+            counts = next_counts
+    return sum(counts.values()) % modulus

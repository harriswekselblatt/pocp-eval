+from functools import lru_cache
 from typing import List, Tuple
 
 
@@ -24,4 +25,41 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    full = (1 << (h * w)) - 1
+    shapes = sorted(tuple(sorted(tile)) for tile in tiles)
+    orientations = [
+        tuple((height, width) for height, width in {(a, b), (b, a)}
+              if height <= h and width <= w)
+        for a, b in shapes
+    ]
+
+    @lru_cache(maxsize=None)
+    def search(covered: int, remaining: int) -> bool:
+        if covered == full:
+            return True
+
+        empty = full ^ covered
+        # A tile covering the first empty cell must start there.
+        row, col = divmod((empty & -empty).bit_length() - 1, w)
+        previous = None
+        for i, shape in enumerate(shapes):
+            bit = 1 << i
+            if not remaining & bit or shape == previous:
+                continue
+            previous = shape
+            for height, width in orientations[i]:
+                if row + height > h or col + width > w:
+                    continue
+                strip = ((1 << width) - 1) << col
+                placement = sum(strip << (r * w) for r in range(row, row + height))
+                if not covered & placement and search(covered | placement, remaining ^ bit):
+                    return True
+        return False
+
+    # Only try subsets whose area matches the board.
+    for subset in range(1, 1 << n):
+        area = sum(a * b for i, (a, b) in enumerate(shapes)
+                   if subset & (1 << i))
+        if area == h * w and search(0, subset):
+            return True
+    return False

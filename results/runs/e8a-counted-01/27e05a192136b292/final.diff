+from math import isqrt
+
+_MOD = 998244353
+
+
+def _sigma_ok(p, k):
+    if p % 3 == 1:
+        return (k + 1) % 3 != 0
+    if p % 3 == 2:
+        return k % 2 == 0
+    return True
+
+
+def _min25(N, M, sq, primes, ghi, glo, use_sigma):
+    mod = _MOD
+    ehi = ghi[:]
+    elo = glo[:]
+    for p in reversed(primes):
+        pp = p * p
+        if pp > N:
+            continue
+        fk = [1]
+        b = 1
+        k = 1
+        while True:
+            b = b * ((k + M - 1) % mod) % mod * pow(k, mod - 2, mod) % mod
+            fk.append(b if (not use_sigma or _sigma_ok(p, k)) else 0)
+            if p ** (k + 1) > N:
+                break
+            k += 1
+        kmax = k
+        gp = glo[p]
+        limhi = min(sq, N // pp)
+        inchi = None
+        inclo = None
+        pk = 1
+        for k in range(1, kmax):
+            pk *= p
+            f0 = fk[k]
+            f1 = fk[k + 1]
+            top = pk * p
+            lim = min(sq, N // top)
+            if lim >= 1:
+                bb = min(lim, sq // pk)
+                src = ehi[pk:bb * pk + 1:pk]
+                if lim > bb:
+                    src += [elo[N // (i * pk)] for i in range(bb + 1, lim + 1)]
+                if f0:
+                    t = [f0 * (e - gp) + f1 for e in src]
+                else:
+                    t = [f1] * lim
+                if inchi is None:
+                    inchi = t
+                else:
+                    for i in range(lim):
+                        inchi[i] += t[i]
+        # lo increments, aligned at pp
+        if pp <= sq:
+            n = sq - pp + 1
+            inclo = [0] * n
+            pk = 1
+            for k in range(1, kmax):
+                pk *= p
+                top = pk * p
+                if top > sq:
+                    break
+                f0 = fk[k]
+                f1 = fk[k + 1]
+                off = top - pp
+                if f0:
+                    t = [f0 * (elo[w // pk] - gp) + f1 for w in range(top, sq + 1)]
+                else:
+                    t = [f1] * (sq - top + 1)
+                if off == 0:
+                    inclo = [(a + b) for a, b in zip(inclo, t)]
+                else:
+                    for j in range(len(t)):
+                        inclo[off + j] += t[j]
+            elo[pp:sq + 1] = [(e + d) % mod for e, d in zip(elo[pp:sq + 1], inclo)]
+        if inchi is not None:
+            L = len(inchi)
+            ehi[1:L + 1] = [(e + d) % mod for e, d in zip(ehi[1:L + 1], inchi)]
+    return (ehi[1] + 1) % mod
+

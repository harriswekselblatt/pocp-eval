+from collections import deque
 from typing import List, Tuple
 
 
@@ -25,4 +26,79 @@ def max_shortest_distance(n: int, m: int, k: int, edges: List[Tuple[int, int]])
     >>> max_shortest_distance(2, 2, 1, [(1, 2), (1, 2)])
     0
     """
-    pass
+    def feasible(distance: int) -> bool:
+        # Layer i represents the assertion that a vertex's label is at least i.
+        # Source-side nodes are true. Labels must rise by at most one along
+        # each edge, and each rise costs one edge of the budget.
+        source = n * distance
+        sink = source + 1
+        graph = [[] for _ in range(sink + 1)]
+        hard = k + 1
+
+        def add_arc(start: int, end: int, capacity: int) -> None:
+            graph[start].append([end, len(graph[end]), capacity])
+            graph[end].append([start, len(graph[start]) - 1, 0])
+
+        for layer in range(distance):
+            offset = layer * n
+            add_arc(offset, sink, hard)
+            add_arc(source, offset + n - 1, hard)
+            if layer:
+                for vertex in range(n):
+                    add_arc(offset + vertex, offset + vertex - n, hard)
+            for u, v in edges:
+                add_arc(offset + v - 1, offset + u - 1, 1)
+                if layer:
+                    add_arc(offset + v - 1, offset + u - 1 - n, hard)
+
+        # Find a minimum cut with Dinic's algorithm, stopping once its cost
+        # is known to exceed the budget.
+        flow = 0
+        while flow <= k:
+            levels = [-1] * len(graph)
+            levels[source] = 0
+            queue = deque([source])
+            while queue:
+                vertex = queue.popleft()
+                for neighbor, _, capacity in graph[vertex]:
+                    if capacity and levels[neighbor] == -1:
+                        levels[neighbor] = levels[vertex] + 1
+                        queue.append(neighbor)
+            if levels[sink] == -1:
+                return True
+
+            next_arc = [0] * len(graph)
+
+            def send(vertex: int, limit: int) -> int:
+                if vertex == sink:
+                    return limit
+                while next_arc[vertex] < len(graph[vertex]):
+                    arc = graph[vertex][next_arc[vertex]]
+                    neighbor, reverse, capacity = arc
+                    if capacity and levels[neighbor] == levels[vertex] + 1:
+                        pushed = send(neighbor, min(limit, capacity))
+                        if pushed:
+                            arc[2] -= pushed
+                            graph[neighbor][reverse][2] += pushed
+                            return pushed
+                    next_arc[vertex] += 1
+                return 0
+
+            while flow <= k:
+                pushed = send(source, hard - flow)
+                if not pushed:
+                    break
+                flow += pushed
+        return False
+
+    # A feasible labeling gives a path-length lower bound by telescoping.
+    # Conversely, shortest distances capped at the target form such labels.
+    # Any unused budget can be spent without decreasing the shortest distance.
+    low, high = 0, min(n - 1, k)
+    while low < high:
+        middle = (low + high + 1) // 2
+        if feasible(middle):
+            low = middle
+        else:
+            high = middle - 1
+    return low

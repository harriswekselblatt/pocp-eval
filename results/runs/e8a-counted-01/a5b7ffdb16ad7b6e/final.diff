diff --git a/solution.py b/solution.py
index 1032d77..2c8fca6 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,24 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    counts = [0] * (n + 1)
+    cost = 0
+
+    for position, value in enumerate(permutation, start=1):
+        rank = 1
+        index = value - 1
+        while index:
+            rank += counts[index]
+            index -= index & -index
+
+        # Insertion into the sorted prefix crosses edges rank through position - 1.
+        # This total falls by at most i under any swap at edge i: for an
+        # inverted pair it falls by the left element's old prefix rank.
+        cost += (position - rank) * (position + rank - 1) // 2
+
+        index = value
+        while index <= n:
+            counts[index] += 1
+            index += index & -index
+
+    return cost

diff --git a/solution.py b/solution.py
index 571a8c1..88da326 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,37 @@ def can_transform(k: int, s: str, t: str) -> bool:
     >>> can_transform(17, 'twothousandtwentyfour', 'happynewyear')
     True
     """
-    pass
+    source_length, target_length = len(s), len(t)
+    if abs(source_length - target_length) > k:
+        return False
+
+    # Each diagonal is source index minus target index. Keep only the
+    # furthest source index reached on each diagonal for this edit count.
+    frontier = {0: 0}
+    for edits in range(k + 1):
+        next_frontier = {}
+        for diagonal, source in frontier.items():
+            target = source - diagonal
+            while source < source_length and target < target_length and s[source] == t[target]:
+                source += 1
+                target += 1
+
+            if source == source_length or target == target_length:
+                remaining = (source_length - source) + (target_length - target)
+                if remaining <= k - edits:
+                    return True
+                # The length difference also rules out earlier positions
+                # on this diagonal with the same remaining budget.
+                continue
+
+            if edits < k:
+                for next_diagonal, next_source in (
+                    (diagonal - 1, source),      # Insert
+                    (diagonal + 1, source + 1),  # Delete
+                    (diagonal, source + 1),      # Replace
+                ):
+                    if next_source > next_frontier.get(next_diagonal, -1):
+                        next_frontier[next_diagonal] = next_source
+
+        frontier = next_frontier
+    return False

diff --git a/solution.py b/solution.py
index b7192c8..029f30c 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,38 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    limit = 2 * n - 1
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % mod
+
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], mod - 2, mod)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % mod
+
+    def forests(nodes: int, roots: int) -> int:
+        if roots < 1 or roots > nodes:
+            return 0
+        # The ballot number for ordered forests with this many roots.
+        return (
+            roots
+            * factorial[2 * nodes - roots - 1]
+            * inverse_factorial[nodes]
+            * inverse_factorial[nodes - roots]
+        ) % mod
+
+    slots = 1
+    count = 0
+    for remaining, degree in zip(range(n, 0, -1), a):
+        # Removing the first node of a forest with s roots and first
+        # degree d leaves a forest with s - 1 + d roots. Raising the
+        # minimum root count from s to s + degree excludes exactly
+        # the completions whose first degree is smaller than degree.
+        count += forests(remaining, slots) - forests(remaining, slots + degree)
+        slots += degree - 1
+        if not 1 <= slots <= remaining - 1:
+            return (count + (remaining == 1 and slots == 0)) % mod
+
+    return count % mod

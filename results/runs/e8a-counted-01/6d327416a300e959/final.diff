diff --git a/solution.py b/solution.py
index fe41102..67d4140 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,20 @@ def count_paths(N: int, M: int, K: int, extra_edges: list) -> int:
     >>> count_paths(10, 0, 200000, [])
     1
     """
-    pass
+    mod = 998244353
+    if M == 0:
+        return 1
+
+    # In coordinates rotating with the cycle, taking a cycle edge leaves
+    # every count in the same slot. Only the extra edges add new paths.
+    edges = [(source - 1, destination - 2) for source, destination in extra_edges]
+    counts = [0] * N
+    counts[0] = 1
+    for step in range(K):
+        # Read all sources before updating any destinations for this move.
+        additions = [counts[(source - step) % N] for source, _ in edges]
+        for (_, destination), paths in zip(edges, additions):
+            slot = (destination - step) % N
+            counts[slot] = (counts[slot] + paths) % mod
+
+    return sum(counts) % mod

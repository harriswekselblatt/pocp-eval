diff --git a/solution.py b/solution.py
index 6e6d26a..510128c 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,25 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    MOD = 998244353
+    if W > H:
+        grid = [''.join(grid[i][j] for i in range(H)) for j in range(W)]
+        H, W = W, H
+    dp = {0: 1}
+    for i in range(H):
+        for j in range(W):
+            ch = grid[i][j]
+            options = (1, 2, 3) if ch == '?' else (int(ch),)
+            sh = 2 * j
+            mask = ~(3 << sh)
+            new = {}
+            for state, cnt in dp.items():
+                up = (state >> sh) & 3
+                left = (state >> (sh - 2)) & 3 if j > 0 else 0
+                base = state & mask
+                for c in options:
+                    if c != up and c != left:
+                        ns = base | (c << sh)
+                        new[ns] = (new.get(ns, 0) + cnt) % MOD
+            dp = new
+    return sum(dp.values()) % MOD

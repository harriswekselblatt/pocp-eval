+from bisect import bisect_left
+from functools import lru_cache
 from typing import List, Tuple
 
 def card_game_winner(n: int, m: int, l: int, takahashi_cards: List[int], aoki_cards: List[int], table_cards: List[int]) -> str:
@@ -24,4 +26,36 @@ def card_game_winner(n: int, m: int, l: int, takahashi_cards: List[int], aoki_ca
     >>> card_game_winner(1, 1, 1, [11], [5], [10])
     'Takahashi'
     """
-    pass
+    @lru_cache(maxsize=None)
+    def can_win(
+        hand: Tuple[int, ...], opponent: Tuple[int, ...], table: Tuple[int, ...]
+    ) -> bool:
+        for play_index, played in enumerate(hand):
+            if play_index and played == hand[play_index - 1]:
+                continue
+
+            remaining = hand[:play_index] + hand[play_index + 1:]
+            insertion = bisect_left(table, played)
+            after_play = table[:insertion] + (played,) + table[insertion:]
+
+            if not can_win(opponent, remaining, after_play):
+                return True
+
+            # Only the cards before the played card are strictly smaller.
+            for take_index in range(insertion):
+                taken = table[take_index]
+                if take_index and taken == table[take_index - 1]:
+                    continue
+                new_hand = tuple(sorted(remaining + (taken,)))
+                new_table = after_play[:take_index] + after_play[take_index + 1:]
+                if not can_win(opponent, new_hand, new_table):
+                    return True
+
+        return False
+
+    takahashi_wins = can_win(
+        tuple(sorted(takahashi_cards)),
+        tuple(sorted(aoki_cards)),
+        tuple(sorted(table_cards)),
+    )
+    return "Takahashi" if takahashi_wins else "Aoki"

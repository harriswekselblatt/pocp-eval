diff --git a/solution.py b/solution.py
index c0935b0..99d911e 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,5 @@
+from collections import deque
+from functools import lru_cache
 from typing import List
 
 
@@ -28,4 +30,47 @@ def max_knight_moves(kx: int, ky: int, positions: List[List[int]]) -> int:
     >>> max_knight_moves(0, 0, [[1, 2], [2, 4]])
     3
     """
-    pass
+    squares = [50 * x + y for x, y in positions]
+    squares.append(50 * kx + ky)
+    pawn_count = len(positions)
+    jumps = ((1, 2), (2, 1), (2, -1), (1, -2),
+             (-1, -2), (-2, -1), (-2, 1), (-1, 2))
+
+    distances = []
+    for start in squares:
+        steps = [-1] * 2500
+        steps[start] = 0
+        queue = deque([start])
+        while queue:
+            square = queue.popleft()
+            x, y = divmod(square, 50)
+            for dx, dy in jumps:
+                nx, ny = x + dx, y + dy
+                if 0 <= nx < 50 and 0 <= ny < 50:
+                    neighbor = 50 * nx + ny
+                    if steps[neighbor] == -1:
+                        steps[neighbor] = steps[square] + 1
+                        queue.append(neighbor)
+        distances.append([steps[target] for target in squares])
+
+    @lru_cache(maxsize=None)
+    def play(current: int, remaining: int) -> int:
+        if not remaining:
+            return 0
+
+        # Each capture removes one bit, so parity determines whose turn it is.
+        alice_turn = (pawn_count - remaining.bit_count()) % 2 == 0
+        choose = max if alice_turn else min
+        best = 2500 * pawn_count if not alice_turn else 0
+        options = remaining
+        while options:
+            bit = options & -options
+            target = bit.bit_length() - 1
+            total = distances[current][target] + play(target, remaining ^ bit)
+            best = choose(best, total)
+            options ^= bit
+        return best
+
+    result = play(pawn_count, (1 << pawn_count) - 1)
+    play.cache_clear()
+    return result

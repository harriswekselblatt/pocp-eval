diff --git a/solution.py b/solution.py
index 1249e85..85887eb 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,35 @@ def min_changes_for_semi_palindromes(s: str, k: int) -> int:
     >>> min_changes_for_semi_palindromes("aabbaa", 3)
     0
     """
-    pass
+    n = len(s)
+    max_length = n - 2 * (k - 1)
+    costs = [[0] * (n + 1) for _ in range(n)]
+
+    for length in range(2, max_length + 1):
+        divisors = [d for d in range(1, length // 2 + 1) if length % d == 0]
+        for start in range(n - length + 1):
+            end = start + length
+            best = length // 2
+            for d in divisors:
+                changes = 0
+                for offset in range(d):
+                    left, right = start + offset, end - d + offset
+                    while left < right:
+                        changes += s[left] != s[right]
+                        left += d
+                        right -= d
+                best = min(best, changes)
+            costs[start][end] = best
+
+    # previous[end] is the minimum cost for partitioning s[:end].
+    previous = [n] * (n + 1)
+    previous[0] = 0
+    for parts in range(1, k + 1):
+        current = [n] * (n + 1)
+        for end in range(2 * parts, n - 2 * (k - parts) + 1):
+            current[end] = min(
+                previous[start] + costs[start][end]
+                for start in range(2 * (parts - 1), end - 1)
+            )
+        previous = current
+    return previous[n]

@@ -20,4 +20,20 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    # Insertion sort is optimal: element at index j with m larger elements before it
+    # is swapped at positions j, j-1, ..., j-m+1.
+    tree = [0] * (n + 1)
+    total = 0
+    for j, v in enumerate(permutation):
+        smaller_or_equal = 0
+        i = v
+        while i > 0:
+            smaller_or_equal += tree[i]
+            i -= i & -i
+        m = j - smaller_or_equal
+        total += m * j - m * (m - 1) // 2
+        i = v
+        while i <= n:
+            tree[i] += 1
+            i += i & -i
+    return total

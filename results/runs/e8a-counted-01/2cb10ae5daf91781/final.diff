diff --git a/solution.py b/solution.py
index 1032d77..020aae0 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,28 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    # A Fenwick tree counts the values in the prefix already processed.
+    seen = [0] * (n + 1)
+    total = 0
+    for index, value in enumerate(permutation):
+        smaller = 0
+        rank = value - 1
+        while rank:
+            smaller += seen[rank]
+            rank -= rank & -rank
+
+        # Inserting this value into the sorted prefix swaps at positions
+        # index through smaller + 1, all expressed as 1-based swap costs.
+        # In an optimal sequence, no pair crosses twice, since removing two
+        # crossings of a pair leaves the final order unchanged and saves cost.
+        # Before its kth crossing with an earlier larger value, at least
+        # index - k + 1 earlier values still precede this value. Insertion
+        # attains that lower bound at every crossing.
+        total += (index - smaller) * (index + smaller + 1) // 2
+
+        rank = value
+        while rank <= n:
+            seen[rank] += 1
+            rank += rank & -rank
+
+    return total

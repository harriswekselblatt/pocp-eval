diff --git a/solution.py b/solution.py
index b7192c8..7613c09 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,46 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    MOD = 998244353
+    size = 2 * n + 2
+    fact = [1] * size
+    for i in range(1, size):
+        fact[i] = fact[i - 1] * i % MOD
+    inv = [1] * size
+    inv[-1] = pow(fact[-1], MOD - 2, MOD)
+    for i in range(size - 1, 0, -1):
+        inv[i - 1] = inv[i] * i % MOD
+
+    def comb(x, k):
+        if k < 0 or x < k or x < 0:
+            return 0
+        return fact[x] * inv[k] % MOD * inv[x - k] % MOD
+
+    def hockey(lo, hi, k):
+        # sum of C(m, k) for m in [lo, hi]
+        return (comb(hi + 1, k + 1) - comb(lo, k + 1)) % MOD
+
+    ans = 0
+    d = 1
+    for i in range(n):
+        r = n - i - 1
+        lo_d = d - 1
+        hi_d = d - 2 + a[i]
+        if a[i] > 0:
+            if r == 0:
+                if lo_d <= 0 <= hi_d:
+                    ans += 1
+            else:
+                lo_d = max(lo_d, 1)
+                hi_d = min(hi_d, r)
+                if lo_d <= hi_d:
+                    lo_m = 2 * r - hi_d - 1
+                    hi_m = 2 * r - lo_d - 1
+                    ans += hockey(lo_m, hi_m, r - 1) - hockey(lo_m, hi_m, r)
+            ans %= MOD
+        d += a[i] - 1
+        if d == 0:
+            if i == n - 1:
+                ans = (ans + 1) % MOD
+            break
+    return ans

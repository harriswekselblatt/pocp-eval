@@ -1,3 +1,6 @@
+from math import comb
+
+
 def count_ways_to_stair(k: int) -> int:
     """ Alice starts on stair 1 and wants to reach stair k. She has a jump value starting at 0.
     From stair i, she can perform two types of operations:
@@ -20,4 +23,15 @@ def count_ways_to_stair(k: int) -> int:
     >>> count_ways_to_stair(512)
     1
     """
-    pass
+    ways = 0
+    jumps = 0
+    stair_without_down_moves = 1
+    while stair_without_down_moves - (jumps + 1) <= k:
+        down_moves = stair_without_down_moves - k
+        if 0 <= down_moves <= jumps + 1:
+            # Each gap before, between, or after jumps can hold one down move.
+            # After j jumps at most j down moves precede that gap, and 2**j > j.
+            ways += comb(jumps + 1, down_moves)
+        jumps += 1
+        stair_without_down_moves *= 2
+    return ways

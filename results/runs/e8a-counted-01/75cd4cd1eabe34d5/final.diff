diff --git a/solution.py b/solution.py
index 3098540..0190449 100644
--- a/solution.py
+++ b/solution.py
@@ -26,4 +26,32 @@ def min_operations_to_sum(nums: List[int], target: int) -> int:
     >>> min_operations_to_sum([1, 32, 1], 35)
     -1
     """
-    pass
+    total = sum(nums)
+    if total < target:
+        return -1
+
+    counts = [0] * (total.bit_length() + 1)
+    for num in nums:
+        counts[num.bit_length() - 1] += 1
+
+    operations = 0
+    for bit in range(target.bit_length()):
+        if target & (1 << bit):
+            if counts[bit] == 0:
+                source = bit + 1
+                while counts[source] == 0:
+                    source += 1
+
+                # Split the nearest larger piece, keeping one half at each level.
+                while source > bit:
+                    counts[source] -= 1
+                    source -= 1
+                    counts[source] += 2
+                    operations += 1
+
+            counts[bit] -= 1
+
+        # Pairs of unused pieces can satisfy the next bit together for free.
+        counts[bit + 1] += counts[bit] // 2
+
+    return operations

diff --git a/solution.py b/solution.py
index 1249e85..e897ed3 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,39 @@ def min_changes_for_semi_palindromes(s: str, k: int) -> int:
     >>> min_changes_for_semi_palindromes("aabbaa", 3)
     0
     """
-    pass
+    n = len(s)
+    max_length = n - 2 * (k - 1)
+    divisors = [[] for _ in range(max_length + 1)]
+    for stride in range(1, max_length // 2 + 1):
+        for length in range(2 * stride, max_length + 1, stride):
+            divisors[length].append(stride)
+
+    # costs[length][start] is the cheapest way to fix that substring.
+    costs = [[], []]
+    for length in range(2, max_length + 1):
+        row = []
+        for start in range(n - length + 1):
+            substring = s[start:start + length]
+            best = length // 2
+            for stride in divisors[length]:
+                changes = 0
+                for offset in range(stride):
+                    group = substring[offset::stride]
+                    changes += sum(a != b for a, b in zip(group[:len(group) // 2], reversed(group)))
+                best = min(best, changes)
+                if best == 0:
+                    break
+            row.append(best)
+        costs.append(row)
+
+    # Each layer adds one substring to a previously partitioned prefix.
+    previous = [0] + [n] * n
+    for parts in range(1, k + 1):
+        current = [n] * (n + 1)
+        for end in range(2 * parts, n - 2 * (k - parts) + 1):
+            current[end] = min(
+                previous[start] + costs[end - start][start]
+                for start in range(2 * (parts - 1), end - 1)
+            )
+        previous = current
+    return previous[n]

diff --git a/solution.py b/solution.py
index 1249e85..636e809 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,38 @@ def min_changes_for_semi_palindromes(s: str, k: int) -> int:
     >>> min_changes_for_semi_palindromes("aabbaa", 3)
     0
     """
-    pass
+    n = len(s)
+    INF = float("inf")
+
+    def cost(i, j):
+        sub = s[i:j + 1]
+        m = len(sub)
+        best = INF
+        for d in range(1, m):
+            if m % d:
+                continue
+            c = 0
+            for r in range(d):
+                part = sub[r::d]
+                L = len(part)
+                for a in range(L // 2):
+                    if part[a] != part[L - 1 - a]:
+                        c += 1
+            best = min(best, c)
+        return best
+
+    costs = [[INF] * n for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            costs[i][j] = cost(i, j)
+
+    dp = [[INF] * (n + 1) for _ in range(k + 1)]
+    dp[0][0] = 0
+    for p in range(1, k + 1):
+        for j in range(2 * p, n + 1):
+            for i in range(2 * (p - 1), j - 1):
+                if dp[p - 1][i] < INF:
+                    v = dp[p - 1][i] + costs[i][j - 1]
+                    if v < dp[p][j]:
+                        dp[p][j] = v
+    return dp[k][n]

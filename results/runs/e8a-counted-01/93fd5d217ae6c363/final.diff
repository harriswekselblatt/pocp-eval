+from itertools import permutations
 from typing import List, Optional
 
 
@@ -23,9 +24,36 @@ def min_operations_to_match_grids(H: int, W: int, A: List[List[int]], B: List[Li
     
     >>> min_operations_to_match_grids(2, 2, [[2, 1], [1, 2]], [[1, 2], [2, 1]])
     1
-    >>> min_operations_to_match_grids(2, 2, [[1, 1], [1, 1]], [[1, 1], [1, 1000000000]])
+    >>> print(min_operations_to_match_grids(2, 2, [[1, 1], [1, 1]], [[1, 1], [1, 1000000000]]))
     None
     >>> min_operations_to_match_grids(3, 3, [[8, 1, 6], [3, 5, 7], [4, 9, 2]], [[8, 1, 6], [3, 5, 7], [4, 9, 2]])
     0
     """
-    pass
+    def inversion_count(order: tuple) -> int:
+        return sum(
+            left > right
+            for i, left in enumerate(order)
+            for right in order[i + 1:]
+        )
+
+    # Each inversion requires one adjacent swap. Row and column costs add
+    # because a swap on either axis leaves the order on the other axis alone.
+    column_orders = [
+        (order, inversion_count(order)) for order in permutations(range(W))
+    ]
+    best = None
+    for rows in permutations(range(H)):
+        row_cost = inversion_count(rows)
+        for columns, column_cost in column_orders:
+            cost = row_cost + column_cost
+            if best is not None and cost >= best:
+                continue
+            if all(
+                A[row][column] == B[i][j]
+                for i, row in enumerate(rows)
+                for j, column in enumerate(columns)
+            ):
+                if cost == 0:
+                    return 0
+                best = cost
+    return best

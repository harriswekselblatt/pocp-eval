+            j = i + d - k
+            if j < 0 or j > m:
+                continue
+            if j == 0:
+                best = i
+            else:
+                best = prev[d] + (si != t[j - 1])
+                if d + 1 < width:
+                    best = min(best, prev[d + 1] + 1)
+                if d > 0:
+                    best = min(best, cur[d - 1] + 1)
+            cur[d] = best if best < inf else inf
+        prev = cur
+    d = m - n + k
+    return prev[d] <= k

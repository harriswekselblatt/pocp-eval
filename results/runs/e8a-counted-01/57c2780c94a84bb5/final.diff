@@ -21,4 +21,31 @@ def can_transform(k: int, s: str, t: str) -> bool:
     >>> can_transform(17, 'twothousandtwentyfour', 'happynewyear')
     True
     """
-    pass
+    n, m = len(s), len(t)
+    if abs(n - m) > k:
+        return False
+    inf = k + 1
+    width = 2 * k + 1
+    # prev[d] holds the distance for cell (i, i + d - k), clamped to inf
+    prev = [inf] * width
+    for j in range(0, min(m, k) + 1):
+        prev[j + k] = j
+    for i in range(1, n + 1):
+        cur = [inf] * width

@@ -1,3 +1,6 @@
+from math import comb
+
+
 def count_balanced_graphs(n: int, p: int) -> list[int]:
     """ Given an even positive integer n and a prime number p, for each M from n-1 to n*(n-1)//2,
     count the number of undirected connected simple graphs with n vertices (labeled 1 to n) and M edges
@@ -16,4 +19,43 @@ def count_balanced_graphs(n: int, p: int) -> list[int]:
     >>> count_balanced_graphs(6, 924844033)
     [810, 2100, 3060, 3030, 2230, 1210, 450, 100, 10, 0, 0]
     """
-    pass
+    half = n // 2
+    max_edges = comb(n, 2)
+
+    # Pack polynomial coefficients into integer digits. Every coefficient
+    # counts a subset of the at most 2**max_edges simple graphs.
+    digit_bits = max_edges + 1
+    x = 1 << digit_bits
+    digit_mask = x - 1
+    within_layer = [(1 + x) ** comb(size, 2) for size in range(half + 1)]
+    # Each new vertex needs a nonempty set of neighbors in the previous layer.
+    extensions = [
+        [((1 + x) ** previous - 1) ** size * within_layer[size]
+         for size in range(half + 1)]
+        for previous in range(half + 1)
+    ]
+
+    # Fix the even and odd label sets for now. Vertices in layers separated
+    # by more than one step cannot share an edge.
+    layers = [{} for _ in range(n + 1)]
+    layers[1][(1, 0, 1, 0)] = 1
+    for total in range(1, n):
+        for (even, odd, previous, parity), polynomial in layers[total].items():
+            available = half - (odd if parity == 0 else even)
+            for size in range(1, available + 1):
+                if parity == 0:
+                    state = (even, odd + size, size, 1)
+                else:
+                    state = (even + size, odd, size, 0)
+                destination = layers[total + size]
+                ways = comb(available, size) * extensions[previous][size]
+                destination[state] = destination.get(state, 0) + polynomial * ways
+        layers[total].clear()
+
+    polynomial = sum(layers[n].values()) * comb(n - 1, half - 1)
+    polynomial >>= digit_bits * (n - 1)
+    counts = []
+    for _ in range(n - 1, max_edges + 1):
+        counts.append((polynomial & digit_mask) % p)
+        polynomial >>= digit_bits
+    return counts

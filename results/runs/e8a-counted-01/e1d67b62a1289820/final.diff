@@ -1,3 +1,4 @@
+from math import gcd
 from typing import List
 
 
@@ -21,4 +22,16 @@ def count_subsequence_pairs(nums: List[int]) -> int:
     >>> count_subsequence_pairs([1, 1, 1, 1])
     50
     """
-    pass
+    modulus = 10**9 + 7
+    # A zero GCD represents an empty subsequence.
+    counts = {(0, 0): 1}
+    for num in nums:
+        # Copy the counts for the choice to leave this index unused.
+        next_counts = counts.copy()
+        for (first, second), count in counts.items():
+            for pair in ((gcd(first, num), second), (first, gcd(second, num))):
+                next_counts[pair] = (next_counts.get(pair, 0) + count) % modulus
+        counts = next_counts
+
+    return sum(count for (first, second), count in counts.items()
+               if first == second and first != 0) % modulus

diff --git a/solution.py b/solution.py
index bf56b72..ef5b8e5 100644
--- a/solution.py
+++ b/solution.py
@@ -23,4 +23,17 @@ def count_good_arrays(n: int, m: int, k: int) -> int:
     >>> count_good_arrays(5, 2, 0)
     2
     """
-    pass
+    modulus = 10**9 + 7
+    gaps = n - 1
+    unequal_gaps = gaps - k
+    chosen = min(k, unequal_gaps)
+
+    # Choose the equal gaps using a binomial coefficient modulo a prime.
+    numerator = denominator = 1
+    for i in range(1, chosen + 1):
+        numerator = numerator * (gaps - i + 1) % modulus
+        denominator = denominator * i % modulus
+    arrangements = numerator * pow(denominator, modulus - 2, modulus) % modulus
+
+    # The first value has m choices, and every unequal gap has m - 1.
+    return m * arrangements * pow(m - 1, unequal_gaps, modulus) % modulus

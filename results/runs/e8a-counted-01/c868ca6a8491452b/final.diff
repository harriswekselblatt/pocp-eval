diff --git a/solution.py b/solution.py
index 6dad4f0..1234a13 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,41 @@ def sum_of_powers(nums: List[int], k: int) -> int:
     >>> sum_of_powers([4, 3, -1], 2)
     10
     """
-    pass
+    modulus = 10**9 + 7
+    values = sorted(nums)
+    size = len(values)
+    max_gap = (values[-1] - values[0]) // (k - 1)
+
+    # In sorted order the smallest pairwise difference is an adjacent gap.
+    # Only positive gaps can contribute to the sum.
+    gaps = {
+        values[right] - values[left]
+        for right in range(size)
+        for left in range(right)
+        if 0 < values[right] - values[left] <= max_gap
+    }
+
+    total = 0
+    previous_gap = 0
+    for gap in sorted(gaps):
+        # For each ending position, count the eligible predecessors.
+        eligible = []
+        left = 0
+        for value in values:
+            while value - values[left] >= gap:
+                left += 1
+            eligible.append(left)
+
+        # prefix[i] counts selections ending within the first i positions.
+        prefix = list(range(size + 1))
+        for _ in range(2, k + 1):
+            next_prefix = [0]
+            for count in eligible:
+                next_prefix.append((next_prefix[-1] + prefix[count]) % modulus)
+            prefix = next_prefix
+
+        # Each selection with power at least gap contributes this increment.
+        total = (total + (gap - previous_gap) * prefix[-1]) % modulus
+        previous_gap = gap
+
+    return total

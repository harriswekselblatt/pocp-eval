diff --git a/solution.py b/solution.py
index fe41102..a7ca568 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,23 @@ def count_paths(N: int, M: int, K: int, extra_edges: list) -> int:
     >>> count_paths(10, 0, 200000, [])
     1
     """
-    pass
+    if M == 0:
+        return 1
+
+    modulus = 998244353
+    ways = [0] * N
+    ways[0] = 1
+    total = 1
+    offset = 0
+
+    # Rotating the vertex-to-index mapping accounts for every cycle edge.
+    for _ in range(K):
+        contributions = [ways[(source - 1 - offset) % N]
+                         for source, _ in extra_edges]
+        offset = (offset + 1) % N
+        for (_, destination), count in zip(extra_edges, contributions):
+            index = (destination - 1 - offset) % N
+            ways[index] = (ways[index] + count) % modulus
+        total = (total + sum(contributions)) % modulus
+
+    return total

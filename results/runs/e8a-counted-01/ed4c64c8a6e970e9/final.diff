diff --git a/solution.py b/solution.py
index 21dc05f..cc85a8d 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,26 @@ def count_valid_permutations(n: int, requirements: List[List[int]]) -> int:
     >>> count_valid_permutations(2, [[0, 0], [1, 0]])
     1
     """
-    pass
+    mod = 10**9 + 7
+    required = dict(requirements)
+    target = required[n - 1]
+    ways = [1] + [0] * target
+
+    for end in range(n):
+        maximum = min(target, end * (end + 1) // 2)
+        count = required.get(end)
+        if count is not None and count > maximum:
+            return 0
+
+        next_ways = [0] * (target + 1)
+        window = 0
+        # The new element's rank determines how many inversions it adds, from 0 to end.
+        for inversions in range(maximum + 1):
+            window += ways[inversions]
+            if inversions > end:
+                window -= ways[inversions - end - 1]
+            if count is None or inversions == count:
+                next_ways[inversions] = window % mod
+        ways = next_ways
+
+    return ways[target]

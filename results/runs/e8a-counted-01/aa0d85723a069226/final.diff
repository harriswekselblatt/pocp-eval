+from math import gcd
 from typing import List
 
 
@@ -21,4 +22,24 @@ def count_subsequence_pairs(nums: List[int]) -> int:
     >>> count_subsequence_pairs([1, 1, 1, 1])
     50
     """
-    pass
+    modulus = 10**9 + 7
+    # A GCD of zero represents an empty subsequence.
+    counts = {(0, 0): 1}
+    gcd_values = range(max(nums) + 1)
+    gcd_by_value = {
+        value: [gcd(value, previous) for previous in gcd_values]
+        for value in set(nums)
+    }
+
+    for value in nums:
+        next_counts = counts.copy()  # Skip this index.
+        updated_gcd = gcd_by_value[value]
+        for (first, second), count in counts.items():
+            # Assign this index to exactly one of the two subsequences.
+            first_pair = (updated_gcd[first], second)
+            second_pair = (first, updated_gcd[second])
+            next_counts[first_pair] = (next_counts.get(first_pair, 0) + count) % modulus
+            next_counts[second_pair] = (next_counts.get(second_pair, 0) + count) % modulus
+        counts = next_counts
+
+    return sum(counts.get((value, value), 0) for value in gcd_values[1:]) % modulus

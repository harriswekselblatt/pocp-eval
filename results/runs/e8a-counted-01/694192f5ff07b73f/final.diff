diff --git a/solution.py b/solution.py
index 21dc05f..2e7783a 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,30 @@ def count_valid_permutations(n: int, requirements: List[List[int]]) -> int:
     >>> count_valid_permutations(2, [[0, 0], [1, 0]])
     1
     """
-    pass
+    modulus = 10**9 + 7
+    required = dict(requirements)
+    total = required[n - 1]
+    counts = [1] + [0] * total
+
+    for end in range(n):
+        # The new element can contribute any number of inversions from 0
+        # through end, depending on its rank in the extended prefix.
+        next_counts = [0] * (total + 1)
+        window = 0
+        for inversions in range(total + 1):
+            window += counts[inversions]
+            if inversions > end:
+                window -= counts[inversions - end - 1]
+            window %= modulus
+            next_counts[inversions] = window
+
+        if end in required:
+            target = required[end]
+            if target > total or next_counts[target] == 0:
+                return 0
+            ways = next_counts[target]
+            next_counts = [0] * (total + 1)
+            next_counts[target] = ways
+        counts = next_counts
+
+    return counts[total]

@@ -1,20 +1,41 @@
+from functools import lru_cache
+
+
+@lru_cache(maxsize=None)
+def _achievable_unfixed(n: int) -> int:
+    """Bitmask of possible counts of non-fixed cells in an n x n binary matrix.
+
+    Non-fixed cells form disjoint a_i x b_i blocks (a_i, b_i >= 2) over disjoint
+    row and column sets, so the count is a sum of a_i * b_i.
+    """
+    dp = [[0] * (n + 1) for _ in range(n + 1)]
+    for r in range(n + 1):
+        for c in range(n + 1):
+            m = 1
+            for a in range(2, r + 1):
+                for b in range(2, c + 1):
+                    m |= dp[r - a][c - b] << (a * b)
+            dp[r][c] = m
+    return dp[n][n]
+
+

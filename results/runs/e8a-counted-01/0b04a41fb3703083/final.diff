diff --git a/solution.py b/solution.py
index 44ed031..3bd5692 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,25 @@ def max_subsequence_value(nums: List[int], k: int) -> int:
     >>> max_subsequence_value([4, 2, 5, 6, 7], 2)
     2
     """
-    pass
+    if k == 0:
+        return 0
+
+    def reachable_ors(values):
+        by_size = [{0}] + [set() for _ in range(k)]
+        for size, value in enumerate(values, 1):
+            # Descending sizes keep this element from being selected twice.
+            for count in range(min(size, k), 0, -1):
+                by_size[count].update(mask | value for mask in by_size[count - 1])
+            yield by_size[k].copy()
+
+    suffix_ors = list(reachable_ors(reversed(nums)))
+    best = 0
+    for split, left_ors in enumerate(reachable_ors(nums), 1):
+        if split > len(nums) - k:
+            break
+        if split >= k:
+            right_ors = suffix_ors[len(nums) - split - 1]
+            best = max(best, max(left ^ right for left in left_ors for right in right_ors))
+            if best == 127:
+                break
+    return best

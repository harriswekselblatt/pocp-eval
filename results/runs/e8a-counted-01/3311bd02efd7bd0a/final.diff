diff --git a/solution.py b/solution.py
index 686fc0b..6f5596b 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,23 @@ def min_team_switches(people: List[Tuple[int, int]]) -> int:
     >>> min_team_switches([(1, 1), (2, 1), (3, 1)])
     0
     """
-    pass
+    total = sum(s for _, s in people)
+    if total % 3:
+        return -1
+    target = total // 3
+    # state: (sum of team 1, sum of team 2) after assigning; team 3 is implied
+    states = {(0, 0): 0}
+    for team, strength in people:
+        nxt = {}
+        for (a, b), cost in states.items():
+            for dest in (1, 2, 3):
+                na = a + strength if dest == 1 else a
+                nb = b + strength if dest == 2 else b
+                if na > target or nb > target:
+                    continue
+                c = cost + (dest != team)
+                key = (na, nb)
+                if nxt.get(key, c + 1) > c:
+                    nxt[key] = c
+        states = nxt
+    return states.get((target, target), -1)

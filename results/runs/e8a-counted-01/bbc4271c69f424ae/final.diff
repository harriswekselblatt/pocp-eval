diff --git a/solution.py b/solution.py
index 067e101..a3cb70b 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,20 @@ def max_1122_subarray_length(n: int, a: List[int]) -> int:
     >>> max_1122_subarray_length(1, [1])
     0
     """
-    pass
+    best = 0
+    for parity in (0, 1):
+        left = parity
+        last_pair_start = {}
+        for right in range(parity, n - 1, 2):
+            value = a[right]
+            if value != a[right + 1]:
+                left = right + 2
+                continue
+
+            previous = last_pair_start.get(value)
+            if previous is not None and previous >= left:
+                left = previous + 2
+            last_pair_start[value] = right
+            best = max(best, right - left + 2)
+
+    return best

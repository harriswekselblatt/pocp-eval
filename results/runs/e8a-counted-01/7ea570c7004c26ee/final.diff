diff --git a/solution.py b/solution.py
index 56103cf..c4c58c0 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,31 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    pass
+    if any(int(digit) > limit for digit in s):
+        return 0
+
+    # Every candidate is prefix * place + suffix.
+    place = 10 ** len(s)
+    suffix = int(s)
+    minimum_prefix = int(s.startswith("0"))
+
+    def count_through(bound: int) -> int:
+        max_prefix = (bound - suffix) // place
+        if max_prefix < minimum_prefix:
+            return 0
+
+        digits = str(max_prefix)
+        base = limit + 1
+        combinations = base ** len(digits)
+        count = 0
+        # Padding prefixes with zeros gives every prefix the same width.
+        for char in digits:
+            combinations //= base
+            digit = int(char)
+            count += min(digit, base) * combinations
+            if digit > limit:
+                return count - minimum_prefix
+
+        return count + 1 - minimum_prefix
+
+    return count_through(finish) - count_through(start - 1)

diff --git a/solution.py b/solution.py
index 3ea4e88..c3a68e3 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,20 @@
+from functools import lru_cache
+
+
+@lru_cache(maxsize=None)
+def _changeable_counts(rows: int, columns: int) -> int:
+    """Return a bitset of achievable counts using the given row and column budgets."""
+    # Zero is possible with every budget by leaving all entries fixed.
+    counts = [[1 for _ in range(columns + 1)] for _ in range(rows + 1)]
+    for row_budget in range(2, rows + 1):
+        for column_budget in range(2, columns + 1):
+            for height in range(2, row_budget + 1):
+                for width in range(2, column_budget + 1):
+                    remaining = counts[row_budget - height][column_budget - width]
+                    counts[row_budget][column_budget] |= remaining << (height * width)
+    return counts[rows][columns]
+
+
 def matrix_with_k_fixed_elements_exists(n: int, k: int) -> bool:
     """ Given an integer n (size of matrix) and k (number of fixed elements),
     determine if there exists an n×n binary matrix with exactly k fixed elements.
@@ -22,4 +39,15 @@ def matrix_with_k_fixed_elements_exists(n: int, k: int) -> bool:
     >>> matrix_with_k_fixed_elements_exists(3, 7)
     False
     """
-    pass
+    # Orient each row-column edge according to its entry. An entry can change
+    # exactly when its edge is on a directed cycle: reversing a cycle preserves
+    # the margins, and the edges changed by any equal-margin matrix form cycles.
+    #
+    # Each nontrivial strongly connected component therefore contributes its
+    # entire row-by-column rectangle, with at least two vertices on each side.
+    # Conversely, each such rectangle can start with a directed four-cycle.
+    # Give each added vertex one edge in and one edge out to the initial cycle.
+    # Orient edges between components forward in a common order, so they stay
+    # fixed. Unused rows and columns can be singleton components.
+    changeable = n * n - k
+    return bool((_changeable_counts(n, n) >> changeable) & 1)

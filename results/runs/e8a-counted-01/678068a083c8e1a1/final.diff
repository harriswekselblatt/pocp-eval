diff --git a/solution.py b/solution.py
index 56103cf..16ef0a6 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,24 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    pass
+    def count_upto(n: int) -> int:
+        if n < 0:
+            return 0
+        digits = str(n)
+        m = len(s)
+        if len(digits) < m:
+            return 0
+        if any(int(c) > limit for c in s):
+            return 0
+        k = len(digits) - m
+        total = 0
+        for i in range(k):
+            d = int(digits[i])
+            total += min(d, limit + 1) * (limit + 1) ** (k - i - 1)
+            if d > limit:
+                return total
+        if int(s) <= int(digits[k:]):
+            total += 1
+        return total
+
+    return count_upto(finish) - count_upto(start - 1)

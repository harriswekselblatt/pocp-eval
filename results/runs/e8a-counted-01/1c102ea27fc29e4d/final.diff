--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from collections import deque
 from typing import List, Tuple
 
 
@@ -25,4 +26,82 @@ def max_shortest_distance(n: int, m: int, k: int, edges: List[Tuple[int, int]])
     >>> max_shortest_distance(2, 2, 1, [(1, 2), (1, 2)])
     0
     """
-    pass
+    def feasible(distance: int) -> bool:
+        # A node (vertex, level) is on the source side when the vertex
+        # has a distance label of at least level.
+        source = n * distance
+        sink = source + 1
+        graph = [[] for _ in range(sink + 1)]
+        forbidden = k + 1
+
+        def add_arc(start: int, end: int, capacity: int) -> None:
+            graph[start].append([end, capacity, len(graph[end])])
+            graph[end].append([start, 0, len(graph[start]) - 1])
+
+        add_arc(source, n * distance - 1, forbidden)
+        add_arc(0, sink, forbidden)
+        for vertex in range(n):
+            base = vertex * distance
+            for level in range(1, distance):
+                add_arc(base + level, base + level - 1, forbidden)
+
+        # A label increase across an edge requires weight 1. A jump of
+        # more than one is forbidden even when the edge is upgraded.
+        for u, v in edges:
+            start = (v - 1) * distance
+            end = (u - 1) * distance
+            for level in range(distance):
+                add_arc(start + level, end + level, 1)
+                if level:
+                    add_arc(start + level, end + level - 1, forbidden)
+
+        # Find the minimum cut, stopping once it exceeds the budget.
+        flow = 0
+        while flow <= k:
+            layers = [-1] * len(graph)
+            layers[source] = 0
+            queue = deque([source])
+            while queue:
+                vertex = queue.popleft()
+                for target, capacity, _ in graph[vertex]:
+                    if capacity and layers[target] == -1:
+                        layers[target] = layers[vertex] + 1
+                        queue.append(target)
+            if layers[sink] == -1:
+                return True
+
+            next_arc = [0] * len(graph)
+
+            def send(vertex: int, limit: int) -> int:
+                if vertex == sink:
+                    return limit
+                while next_arc[vertex] < len(graph[vertex]):
+                    arc = graph[vertex][next_arc[vertex]]
+                    target, capacity, reverse = arc
+                    if capacity and layers[target] == layers[vertex] + 1:
+                        pushed = send(target, min(limit, capacity))
+                        if pushed:
+                            arc[1] -= pushed
+                            graph[target][reverse][1] += pushed
+                            return pushed
+                    next_arc[vertex] += 1
+                return 0
+
+            while flow <= k:
+                pushed = send(source, forbidden - flow)
+                if not pushed:
+                    break
+                flow += pushed
+        return False
+
+    # Feasible labels lower-bound every path length by telescoping. Conversely,
+    # shortest distances capped at the target give feasible labels (including
+    # for unreachable vertices). Extra upgrades can only increase distances.
+    low, high = 0, min(n - 1, k)
+    while low < high:
+        middle = (low + high + 1) // 2
+        if feasible(middle):
+            low = middle
+        else:
+            high = middle - 1
+    return low

+from itertools import permutations
 from typing import List, Optional
 
 
@@ -23,9 +24,31 @@ def min_operations_to_match_grids(H: int, W: int, A: List[List[int]], B: List[Li
     
     >>> min_operations_to_match_grids(2, 2, [[2, 1], [1, 2]], [[1, 2], [2, 1]])
     1
-    >>> min_operations_to_match_grids(2, 2, [[1, 1], [1, 1]], [[1, 1], [1, 1000000000]])
-    None
+    >>> min_operations_to_match_grids(2, 2, [[1, 1], [1, 1]], [[1, 1], [1, 1000000000]]) is None
+    True
     >>> min_operations_to_match_grids(3, 3, [[8, 1, 6], [3, 5, 7], [4, 9, 2]], [[8, 1, 6], [3, 5, 7], [4, 9, 2]])
     0
     """
-    pass
+    def count_inversions(order):
+        return sum(
+            left > right
+            for i, left in enumerate(order)
+            for right in order[i + 1:]
+        )
+
+    # Each adjacent swap changes the inversion count of one axis by one.
+    column_orders = [(order, count_inversions(order)) for order in permutations(range(W))]
+    best = None
+    for rows in permutations(range(H)):
+        row_swaps = count_inversions(rows)
+        for columns, column_swaps in column_orders:
+            swaps = row_swaps + column_swaps
+            if best is not None and swaps >= best:
+                continue
+            if all(
+                A[source_row][source_column] == B[i][j]
+                for i, source_row in enumerate(rows)
+                for j, source_column in enumerate(columns)
+            ):
+                best = swaps
+    return best

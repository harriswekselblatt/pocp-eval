+from math import lcm
 from typing import List
 
 
@@ -21,4 +22,32 @@ def kth_smallest_amount(coins: List[int], k: int) -> int:
     >>> kth_smallest_amount([5, 2], 7)
     12
     """
-    pass
+    denominations = []
+    for coin in sorted(coins):
+        if all(coin % smaller != 0 for smaller in denominations):
+            denominations.append(coin)
+
+    # Group inclusion-exclusion terms whose subsets have the same LCM.
+    coefficients = {}
+    for coin in denominations:
+        additions = {coin: 1}
+        for multiple, coefficient in coefficients.items():
+            common = lcm(multiple, coin)
+            additions[common] = additions.get(common, 0) - coefficient
+        for multiple, coefficient in additions.items():
+            combined = coefficients.get(multiple, 0) + coefficient
+            if combined:
+                coefficients[multiple] = combined
+            else:
+                coefficients.pop(multiple, None)
+
+    low, high = 1, denominations[0] * k
+    while low < high:
+        mid = (low + high) // 2
+        count = sum(coefficient * (mid // multiple)
+                    for multiple, coefficient in coefficients.items())
+        if count < k:
+            low = mid + 1
+        else:
+            high = mid
+    return low

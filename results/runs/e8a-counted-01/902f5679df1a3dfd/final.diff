diff --git a/solution.py b/solution.py
index 6dad4f0..784604f 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,31 @@ def sum_of_powers(nums: List[int], k: int) -> int:
     >>> sum_of_powers([4, 3, -1], 2)
     10
     """
-    pass
+    MOD = 10**9 + 7
+    a = sorted(nums)
+    n = len(a)
+    diffs = sorted({a[j] - a[i] for i in range(n) for j in range(i + 1, n)})
+
+    def count(d: int) -> int:
+        # subsequences of size k whose adjacent sorted gaps are all >= d
+        dp = [[0] * (k + 1) for _ in range(n)]
+        pre = [[0] * (k + 1) for _ in range(n + 1)]
+        p = 0
+        for i in range(n):
+            while p < i and a[i] - a[p] >= d:
+                p += 1
+            # p = number of indices j with a[i] - a[j] >= d (sorted prefix)
+            dp[i][1] = 1
+            for c in range(2, k + 1):
+                dp[i][c] = pre[p][c - 1]
+            for c in range(k + 1):
+                pre[i + 1][c] = (pre[i][c] + dp[i][c]) % MOD
+        return pre[n][k]
+
+    total = 0
+    prev = 0
+    for d in diffs:
+        if d > prev:
+            total = (total + (d - prev) * count(d)) % MOD
+            prev = d
+    return total

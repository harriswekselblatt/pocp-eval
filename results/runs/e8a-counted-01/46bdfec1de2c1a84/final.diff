diff --git a/solution.py b/solution.py
index 6e6d26a..db4a00e 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,27 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    MOD = 998244353
+    if W > H:
+        grid = [''.join(grid[i][j] for i in range(H)) for j in range(W)]
+        H, W = W, H
+    # Broken-profile DP; W <= 14. Each profile column stores a colour in 2 bits.
+    dp = {0: 1}
+    for i in range(H):
+        for j in range(W):
+            ch = grid[i][j]
+            options = (1, 2, 3) if ch == '?' else (int(ch),)
+            shift = 2 * j
+            clear = ~(3 << shift)
+            new = {}
+            for state, cnt in dp.items():
+                up = (state >> shift) & 3
+                left = (state >> (shift - 2)) & 3 if j else 0
+                base = state & clear
+                for c in options:
+                    if c == up or c == left:
+                        continue
+                    ns = base | (c << shift)
+                    new[ns] = (new.get(ns, 0) + cnt) % MOD
+            dp = new
+    return sum(dp.values()) % MOD

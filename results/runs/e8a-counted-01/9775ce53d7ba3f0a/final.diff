--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,30 @@ def sum_of_powers(nums: List[int], k: int) -> int:
     >>> sum_of_powers([4, 3, -1], 2)
     10
     """
-    pass
+    MOD = 10**9 + 7
+    a = sorted(nums)
+    n = len(a)
+    diffs = sorted({a[j] - a[i] for i in range(n) for j in range(i + 1, n)} - {0})
+
+    def count(d: int) -> int:
+        # subsequences of length k whose adjacent sorted gaps are all >= d
+        ptr = [0] * n
+        p = 0
+        for i in range(n):
+            while p < n and a[i] - a[p] >= d:
+                p += 1
+            ptr[i] = p
+        dp = [1] * n
+        for _ in range(k - 1):
+            pre = [0] * (n + 1)
+            for i in range(n):
+                pre[i + 1] = (pre[i] + dp[i]) % MOD
+            dp = [pre[ptr[i]] for i in range(n)]
+        return sum(dp) % MOD
+
+    total = 0
+    prev = 0
+    for d in diffs:
+        total = (total + (d - prev) * count(d)) % MOD
+        prev = d
+    return total

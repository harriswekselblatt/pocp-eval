diff --git a/solution.py b/solution.py
index 6e6d26a..d11d3bc 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,30 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    modulus = 998244353
+    if W > H:
+        grid = ["".join(column) for column in zip(*grid)]
+        W = H
+
+    # Two bits per column store the most recently assigned color.
+    counts = {0: 1}
+    for row in grid:
+        for column, cell in enumerate(row):
+            shift = 2 * column
+            clear_column = ~(3 << shift)
+            colors = (1, 2, 3) if cell == "?" else (int(cell),)
+            next_counts = {}
+            for state, count in counts.items():
+                above = (state >> shift) & 3
+                left = (state >> (shift - 2)) & 3 if column else 0
+                for color in colors:
+                    if color != above and color != left:
+                        next_state = (state & clear_column) | (color << shift)
+                        next_counts[next_state] = (
+                            next_counts.get(next_state, 0) + count
+                        ) % modulus
+            if not next_counts:
+                return 0
+            counts = next_counts
+
+    return sum(counts.values()) % modulus

-    pass
+    MOD = 998244353
+    # a[(v - shift) % N] holds the count at vertex v (0-indexed); the cycle edge is a rotation.
+    a = [0] * N
+    a[0] = 1
+    shift = 0
+    edges = [(x - 1, y - 1) for x, y in extra_edges]
+    for _ in range(K):
+        adds = [(y, a[(x - shift) % N]) for x, y in edges]
+        shift += 1
+        for y, c in adds:
+            i = (y - shift) % N
+            a[i] = (a[i] + c) % MOD
+    return sum(a) % MOD

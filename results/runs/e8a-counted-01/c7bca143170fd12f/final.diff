diff --git a/solution.py b/solution.py
index b7192c8..3268d74 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,40 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    MOD = 998244353
+    size = 2 * n + 2
+    fact = [1] * (size + 1)
+    for i in range(1, size + 1):
+        fact[i] = fact[i - 1] * i % MOD
+    inv = [1] * (size + 1)
+    inv[size] = pow(fact[size], MOD - 2, MOD)
+    for i in range(size, 0, -1):
+        inv[i - 1] = inv[i] * i % MOD
+
+    def C(top, r):
+        if r < 0 or top < r or top < 0:
+            return 0
+        return fact[top] * inv[r] % MOD * inv[top - r] % MOD
+
+    # c = number of Polish sequences still to be read; must be >= 1 before each element
+    c = 1
+    total = 0
+    for i in range(n):
+        ai = a[i]
+        m = n - i - 1
+        if m == 0:
+            if c == 1 and ai > 0:
+                total += 1
+        elif ai > 0:
+            lo = max(1, c - 1)
+            hi = min(m, c - 2 + ai)
+            if lo <= hi:
+                s = C(2 * m - lo, m) - C(2 * m - hi - 1, m)
+                s -= C(2 * m - lo, m + 1) - C(2 * m - hi - 1, m + 1)
+                total += s
+        c = c - 1 + ai
+        if c == 0:
+            if i == n - 1:
+                total += 1
+            break
+    return total % MOD

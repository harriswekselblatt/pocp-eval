+    a1_l = [(a - (x >= 3) + b) // 2 + (x >= 3) for a, b, x in zip(pi_l, chi_l, large)]
+    a1_s = [(a - (x >= 3) + b) // 2 + (x >= 3) for a, b, x in zip(pi_s, chi_s, range(r + 1))]

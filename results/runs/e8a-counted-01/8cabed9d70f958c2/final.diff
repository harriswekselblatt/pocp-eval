+from functools import lru_cache
+from math import isqrt
+
+MOD = 998244353
+
+
+@lru_cache(maxsize=4)
+def _prime_tables(N):
+    r = isqrt(N)
+    large = [0] + [N // i for i in range(1, r + 1)]
+    pi_l = [x - 1 for x in large]
+    pi_s = list(range(-1, r))
+    pi_l[0] = 0
+    pi_s[0] = 0
+    chi_l = [(1 if x % 3 == 1 else 0) - 1 for x in large]
+    chi_s = [(1 if x % 3 == 1 else 0) - 1 for x in range(r + 1)]
+    chi_l[0] = 0
+    chi_s[0] = 0
+    sieve = bytearray([1]) * (r + 1)
+    sieve[:2] = b"\x00\x00"
+    for i in range(2, isqrt(r) + 1):
+        if sieve[i]:
+            sieve[i * i::i] = bytes(len(range(i * i, r + 1, i)))
+    primes = [i for i in range(2, r + 1) if sieve[i]]
+    for p in primes:
+        pp = p * p
+        if pp > N:
+            break
+        L = min(r, N // pp)
+        k = min(L, r // p)
+        Np = N // p
+        for arr_l, arr_s, w in ((pi_l, pi_s, 1), (chi_l, chi_s, 1 if p % 3 == 1 else -1)):
+            if w == 1 and p == 3 and arr_l is chi_l:
+                continue
+            if p == 3 and arr_l is chi_l:
+                continue
+            sp = arr_s[p - 1]
+            y = arr_l[p:k * p + 1:p] + [arr_s[Np // i] for i in range(k + 1, L + 1)]
+            ys = [arr_s[v // p] for v in range(pp, r + 1)]
+            if w == 1:
+                arr_l[1:L + 1] = [a - b + sp for a, b in zip(arr_l[1:L + 1], y)]
+                arr_s[pp:] = [a - b + sp for a, b in zip(arr_s[pp:], ys)]
+            else:
+                arr_l[1:L + 1] = [a + b - sp for a, b in zip(arr_l[1:L + 1], y)]
+                arr_s[pp:] = [a + b - sp for a, b in zip(arr_s[pp:], ys)]
+    return r, primes, large, pi_l, pi_s, chi_l, chi_s
+
+
+def _dp_step(F_l, F_s, N, r, p, Gp, c):
+    pp = p * p
+    L = min(r, N // pp)
+    c1 = c[1]
+    c2 = c[2]
+    k = min(L, r // p)
+    Np = N // p
+    base = c2 - c1 * Gp
+    dl = [c1 * y + base for y in F_l[p:k * p + 1:p]]
+    dl += [c1 * F_s[Np // i] + base for i in range(k + 1, L + 1)]
+    ds = [c1 * F_s[v // p] + base for v in range(pp, r + 1)]
+    pe = pp
+    e = 2
+    while pe * p <= N:
+        ce = c[e]
+        base = c[e + 1] - ce * Gp
+        Le = min(r, N // (pe * p))
+        k = min(Le, r // pe)
+        Q = N // pe
+        ys = F_l[pe:k * pe + 1:pe] + [F_s[Q // i] for i in range(k + 1, Le + 1)]
+        for idx, y in enumerate(ys):
+            dl[idx] += ce * y + base
+        lo = pe * p
+        if lo <= r:
+            off = lo - pp
+            for idx, v in enumerate(range(lo, r + 1), off):
+                ds[idx] += ce * F_s[v // pe] + base
+        pe *= p
+        e += 1
+    F_l[1:L + 1] = [(a + d) % MOD for a, d in zip(F_l[1:L + 1], dl)]
+    F_s[pp:] = [(a + d) % MOD for a, d in zip(F_s[pp:], ds)]
+
+
+def _multiplicative_sum(N, r, primes, G_l, G_s, coef):
+    F_l = G_l[:]
+    F_s = G_s[:]
+    for p in reversed(primes):
+        if p * p > N:
+            continue
+        _dp_step(F_l, F_s, N, r, p, G_s[p], coef(p))
+    return F_l[1] % MOD
+
+

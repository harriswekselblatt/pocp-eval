diff --git a/solution.py b/solution.py
index 1ae40e6..9a481b2 100644
--- a/solution.py
+++ b/solution.py
@@ -1,8 +1,11 @@
+from collections import Counter
+
+
 def count_distinct_parenthesis_sequences(n: int, s: str) -> int:
     """ Given a valid parenthesis sequence of length n, count the number of distinct strings
     that can be obtained by performing the following operation any number of times:
-    - Choose a contiguous substring that is a valid parenthesis sequence and reverse it
-      (where reversing means swapping all '(' with ')' and vice versa).
+    - Choose a contiguous substring that is a valid parenthesis sequence, reverse its
+      character order, and swap '(' with ')' throughout the substring.
     
     Return the count modulo 998244353.
     
@@ -18,4 +21,40 @@ def count_distinct_parenthesis_sequences(n: int, s: str) -> int:
     >>> count_distinct_parenthesis_sequences(2, '()')
     1
     """
-    pass
+    modulus = 998244353
+    pairs = n // 2
+    factorial = [1] * (pairs + 1)
+    for k in range(1, pairs + 1):
+        factorial[k] = factorial[k - 1] * k % modulus
+
+    inverse_factorial = [1] * (pairs + 1)
+    inverse_factorial[pairs] = pow(factorial[pairs], modulus - 2, modulus)
+    for k in range(pairs, 0, -1):
+        inverse_factorial[k - 1] = inverse_factorial[k] * k % modulus
+
+    # Each matched pair is a node. The extra root holds the top-level pairs.
+    # Reversing a balanced substring mirrors a consecutive group of siblings.
+    # Mirroring two adjacent siblings together and then each one individually
+    # swaps them. Thus each node's children can be permuted independently.
+    stack = [[]]
+    subtree_ids = {}
+    count = 1
+    for char in s:
+        if char == '(':
+            stack.append([])
+            continue
+
+        children = stack.pop()
+        signature = tuple(sorted(children))
+        subtree_id = subtree_ids.setdefault(signature, len(subtree_ids))
+        stack[-1].append(subtree_id)
+
+        count = count * factorial[len(children)] % modulus
+        for multiplicity in Counter(children).values():
+            count = count * inverse_factorial[multiplicity] % modulus
+
+    roots = stack.pop()
+    count = count * factorial[len(roots)] % modulus
+    for multiplicity in Counter(roots).values():
+        count = count * inverse_factorial[multiplicity] % modulus
+    return count

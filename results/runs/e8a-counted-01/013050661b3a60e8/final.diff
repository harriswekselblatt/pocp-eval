     >>> paint_walls([2, 3, 4, 2], [1, 1, 1, 1])
     4
     """
-    pass
+    wall_count = len(cost)
+    # min_cost[k] is the minimum cost to cover at least k walls.
+    min_cost = [0] + [sum(cost)] * wall_count
+
+    for price, duration in zip(cost, time):
+        # The paid painter covers one wall and frees up time for duration more.
+        coverage = 1 + duration
+        # Update in reverse so each wall can be assigned to the paid painter once.
+        for required in range(wall_count, 0, -1):
+            remaining = max(0, required - coverage)
+            min_cost[required] = min(min_cost[required], price + min_cost[remaining])
+
+    return min_cost[wall_count]

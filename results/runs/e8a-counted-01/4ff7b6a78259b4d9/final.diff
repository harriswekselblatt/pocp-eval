diff --git a/solution.py b/solution.py
index 44ed031..1e30bc3 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,28 @@ def max_subsequence_value(nums: List[int], k: int) -> int:
     >>> max_subsequence_value([4, 2, 5, 6, 7], 2)
     2
     """
-    pass
+    if k == 0:
+        return 0
+    n = len(nums)
+    # pre[i][j] = set of OR values reachable choosing j items from nums[:i]
+    def sweep(arr):
+        cur = [set() for _ in range(k + 1)]
+        cur[0].add(0)
+        out = [None] * (len(arr) + 1)
+        out[0] = set(cur[k])
+        for i, v in enumerate(arr):
+            for j in range(k, 0, -1):
+                if cur[j - 1]:
+                    cur[j].update(o | v for o in cur[j - 1])
+            out[i + 1] = set(cur[k])
+        return out
+
+    pre = sweep(nums)
+    suf = sweep(nums[::-1])
+    best = 0
+    for i in range(k, n - k + 1):
+        left = pre[i]
+        right = suf[n - i]
+        if left and right:
+            best = max(best, max(a ^ b for a in left for b in right))
+    return best

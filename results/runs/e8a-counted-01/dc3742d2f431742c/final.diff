diff --git a/solution.py b/solution.py
index b7192c8..817695f 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,40 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    modulus = 998244353
+    limit = 2 * n
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % modulus
+
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], modulus - 2, modulus)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % modulus
+
+    def binomial(top: int, bottom: int) -> int:
+        if top < bottom:
+            return 0
+        return (factorial[top] * inverse_factorial[bottom]
+                * inverse_factorial[top - bottom]) % modulus
+
+    def forest_tail(nodes: int, roots: int) -> int:
+        # Sum the ballot counts for forests with at least this many roots.
+        # For k roots the count is C(2*nodes-k-1, nodes-1) -
+        # C(2*nodes-k-1, nodes). Summing gives the two binomials below.
+        top = 2 * nodes - roots
+        return binomial(top, nodes) - binomial(top, nodes + 1)
+
+    count = 0
+    slots = 1
+    for i, degree in enumerate(a):
+        remaining = n - i - 1
+        # Each node fills one pending slot and opens one per child.
+        # A smaller degree leaves between slots-1 and slots+degree-2 slots.
+        count = (count + forest_tail(remaining, slots - 1)
+                 - forest_tail(remaining, slots + degree - 1)) % modulus
+        slots += degree - 1
+        if remaining == 0:
+            return (count + (slots == 0)) % modulus
+        if slots == 0 or slots > remaining:
+            return count

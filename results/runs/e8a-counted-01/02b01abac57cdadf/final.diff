+from functools import lru_cache
+
+
+def _divisors(m: int):
+    factors = {}
+    p = 2
+    r = m
+    while p * p <= r:
+        while r % p == 0:
+            factors[p] = factors.get(p, 0) + 1
+            r //= p
+        p += 1
+    if r > 1:
+        factors[r] = factors.get(r, 0) + 1
+    divs = [1]
+    for p, e in factors.items():
+        divs = [d * p**k for d in divs for k in range(e + 1)]
+    return sorted(divs)
+
+
+@lru_cache(maxsize=None)
+def _solve(m: int):
+    s = str(m)
+    if '0' not in s and s == s[::-1]:
+        return s
+    for a in _divisors(m):
+        if a == 1:
+            continue
+        sa = str(a)
+        if '0' in sa:
+            continue
+        pair = a * int(sa[::-1])
+        if pair > m:
+            continue
+        if m % pair:
+            continue
+        rest = m // pair
+        if rest == 1:
+            return sa + '*' + sa[::-1]
+        inner = _solve(rest)
+        if inner != '-1':
+            return sa + '*' + inner + '*' + sa[::-1]
+    return '-1'
+
+

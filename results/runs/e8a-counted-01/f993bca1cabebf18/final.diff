@@ -23,4 +23,15 @@ def count_good_arrays(n: int, m: int, k: int) -> int:
     >>> count_good_arrays(5, 2, 0)
     2
     """
-    pass
+    modulus = 10**9 + 7
+    unequal_pairs = n - 1 - k
+    # Choose the equal positions, using the smaller side of the binomial.
+    choices = min(k, unequal_pairs)
+    numerator = denominator = 1
+    for i in range(1, choices + 1):
+        numerator = numerator * (n - i) % modulus
+        denominator = denominator * i % modulus
+    position_count = numerator * pow(denominator, modulus - 2, modulus) % modulus
+
+    # The first element has m choices, and each unequal pair has m - 1.
+    return m * position_count * pow(m - 1, unequal_pairs, modulus) % modulus

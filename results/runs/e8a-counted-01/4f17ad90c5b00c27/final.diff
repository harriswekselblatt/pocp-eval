diff --git a/solution.py b/solution.py
index 978a238..79e4a2b 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,35 @@ def min_spanning_tree_mod_k(n: int, m: int, k: int, edges: List[Tuple[int, int,
     >>> min_spanning_tree_mod_k(6, 5, 998244353, [(1, 2, 337361568), (1, 6, 450343304), (2, 3, 61477244), (2, 5, 745383438), (4, 5, 727360840)])
     325437688
     """
-    pass
+    if k == 1:
+        return 0
+
+    parent = list(range(n + 1))
+    best = k
+
+    def find(vertex: int) -> int:
+        while parent[vertex] != vertex:
+            vertex = parent[vertex]
+        return vertex
+
+    def search(start: int, remaining: int, total: int) -> None:
+        nonlocal best
+        if remaining == 0:
+            best = min(best, total % k)
+            return
+
+        for index in range(start, m - remaining + 1):
+            u, v, weight = edges[index]
+            root_u, root_v = find(u), find(v)
+            if root_u == root_v:
+                continue
+
+            # Each prefix is a forest. Undo the union before trying the next edge.
+            parent[root_u] = root_v
+            search(index + 1, remaining - 1, total + weight)
+            parent[root_u] = root_u
+            if best == 0:
+                return
+
+    search(0, n - 1, 0)
+    return best

diff --git a/solution.py b/solution.py
index 56103cf..538275a 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,34 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    pass
+    if any(int(digit) > limit for digit in s):
+        return 0
+
+    suffix = int(s)
+    scale = 10 ** len(s)
+    # A zero prefix is valid only when the suffix itself is a positive integer
+    # with the full suffix width in its decimal representation.
+    minimum_prefix = int(s.startswith("0"))
+    first_prefix = max(minimum_prefix, (start - suffix + scale - 1) // scale)
+    last_prefix = (finish - suffix) // scale
+    if first_prefix > last_prefix:
+        return 0
+
+    def count_prefixes(bound: int) -> int:
+        if bound < 0:
+            return 0
+
+        digits = str(bound)
+        base = limit + 1
+        place_count = base ** (len(digits) - 1)
+        count = 0
+        for character in digits:
+            digit = int(character)
+            # Each valid smaller digit leaves all remaining positions free.
+            count += min(digit, base) * place_count
+            if digit > limit:
+                return count
+            place_count //= base
+        return count + 1  # The bound itself has only valid digits.
+
+    return count_prefixes(last_prefix) - count_prefixes(first_prefix - 1)

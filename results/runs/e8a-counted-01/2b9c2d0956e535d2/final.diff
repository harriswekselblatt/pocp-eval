diff --git a/solution.py b/solution.py
index 3ea4e88..cf0314d 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,29 @@ def matrix_with_k_fixed_elements_exists(n: int, k: int) -> bool:
     >>> matrix_with_k_fixed_elements_exists(3, 7)
     False
     """
-    pass
+    # Direct each edge of the row-column bipartite graph according to its
+    # entry. Reversing a directed cycle preserves the margins, and any
+    # change preserving the margins decomposes into directed cycles.
+    # Thus the variable entries are exactly the edges inside strongly
+    # connected components.
+    #
+    # A nontrivial component needs at least two rows and two columns.
+    # Conversely, any such rectangle admits a strong orientation: start
+    # with a directed 4-cycle and give each added vertex an edge in and
+    # an edge out to the original cycle. Orient edges between components
+    # in component order. Unused rows and columns are singleton components.
+    # An a-by-b component therefore contributes exactly a*b variable entries.
+    variable = n * n - k
+    limit = (1 << (variable + 1)) - 1
+
+    # Bit v records whether v variable entries can fit within these budgets.
+    reachable = [[1] * (n + 1) for _ in range(n + 1)]
+    for rows in range(2, n + 1):
+        for cols in range(2, n + 1):
+            counts = reachable[rows - 1][cols] | reachable[rows][cols - 1]
+            for height in range(2, min(rows, variable // 2) + 1):
+                for width in range(2, min(cols, variable // height) + 1):
+                    counts |= reachable[rows - height][cols - width] << (height * width)
+            reachable[rows][cols] = counts & limit
+
+    return bool(reachable[n][n] & (1 << variable))

diff --git a/solution.py b/solution.py
index 89fc706..1c3b828 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,51 @@ def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
     >>> solve_grid(3, 'AAA', 'BBB')
     None
     """
-    pass
+    from itertools import permutations
+
+    # Each row places A, B, C in distinct columns; the leftmost placed letter must match r[i].
+    options = []
+    for cols in permutations(range(n), 3):
+        row = ['.'] * n
+        for ch, col in zip('ABC', cols):
+            row[col] = ch
+        options.append(''.join(row))
+
+    def leftmost(row: str) -> str:
+        return next(ch for ch in row if ch != '.')
+
+    row_options = [[o for o in options if leftmost(o) == r[i]] for i in range(n)]
+
+    def dfs(i: int, grid: List[str], used: List[set], top: List[Optional[str]]):
+        if i == n:
+            return grid[:] if all(top[j] == c[j] for j in range(n)) else None
+        for o in row_options[i]:
+            ok = True
+            newtop = top[:]
+            for j, ch in enumerate(o):
+                if ch == '.':
+                    continue
+                if ch in used[j]:
+                    ok = False
+                    break
+                if newtop[j] is None:
+                    if ch != c[j]:
+                        ok = False
+                        break
+                    newtop[j] = ch
+            if not ok:
+                continue
+            for j, ch in enumerate(o):
+                if ch != '.':
+                    used[j].add(ch)
+            grid.append(o)
+            res = dfs(i + 1, grid, used, newtop)
+            if res is not None:
+                return res
+            grid.pop()
+            for j, ch in enumerate(o):
+                if ch != '.':
+                    used[j].discard(ch)
+        return None
+
+    return dfs(0, [], [set() for _ in range(n)], [None] * n)

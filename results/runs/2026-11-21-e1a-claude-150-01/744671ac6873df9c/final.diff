diff --git a/solution.py b/solution.py
index 0b61e39..8e1ded9 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,36 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    if sum(a * b for a, b in tiles) < h * w:
+        return False
+    grid = [[False] * w for _ in range(h)]
+    used = [False] * n
+
+    def solve(pos: int) -> bool:
+        while pos < h * w and grid[pos // w][pos % w]:
+            pos += 1
+        if pos == h * w:
+            return True
+        r, c = divmod(pos, w)
+        for i, (a, b) in enumerate(tiles):
+            if used[i]:
+                continue
+            for th, tw in {(a, b), (b, a)}:
+                if r + th > h or c + tw > w:
+                    continue
+                if any(grid[r + dr][c + dc] for dr in range(th) for dc in range(tw)):
+                    continue
+                for dr in range(th):
+                    for dc in range(tw):
+                        grid[r + dr][c + dc] = True
+                used[i] = True
+                ok = solve(pos + 1)
+                used[i] = False
+                for dr in range(th):
+                    for dc in range(tw):
+                        grid[r + dr][c + dc] = False
+                if ok:
+                    return True
+        return False
+
+    return solve(0)

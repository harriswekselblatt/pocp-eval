@@ -1,3 +1,6 @@
+MOD = 998244353
+
+
 def count_in_degree_sequences(n: int, s: str) -> int:
     """ Given a positive integer n and a string s of length n consisting of '0' and '1',
     construct a graph G with (n+1) vertices numbered 0 to n, with the following edges:
@@ -22,4 +25,45 @@ def count_in_degree_sequences(n: int, s: str) -> int:
     >>> count_in_degree_sequences(20, '00001100111010100101')
     261339902
     """
-    pass
+    # Orient cycle edge i (between i and i+1) by x_i in {0, 1}; then
+    # d_i = 1 + (x_{i-1} - x_i) + t_i, where t_i in {0, 1} is the spoke
+    # direction (t_i = 0 when s[i] == '0'). d_n is fixed by the total edge count,
+    # so we count distinct (d_0..d_{n-1}). Determinize the NFA over x: a state is
+    # a set of (start x_{-1}, current x) pairs, encoded as a 4-bit mask.
+    def step(mask, allowed_t):
+        out = {}
+        for a in (0, 1):
+            for p in (0, 1):
+                if not mask >> (2 * a + p) & 1:
+                    continue
+                for q in (0, 1):
+                    for t in allowed_t:
+                        z = p - q + t
+                        out[z] = out.get(z, 0) | (1 << (2 * a + q))
+        return list(out.values())
+
+    start = (1 << 0) | (1 << 3)  # pairs (0,0) and (1,1)
+    trans = ({}, {})
+    seen = {start}
+    stack = [start]
+    while stack:
+        m = stack.pop()
+        for k, allowed in ((0, (0,)), (1, (0, 1))):
+            nxt = step(m, allowed)
+            trans[k][m] = nxt
+            for m2 in nxt:
+                if m2 not in seen:
+                    seen.add(m2)
+                    stack.append(m2)
+
+    dp = {start: 1}
+    for ch in s:
+        tr = trans[1 if ch == '1' else 0]
+        nd = {}
+        for m, v in dp.items():
+            for m2 in tr[m]:
+                nd[m2] = (nd.get(m2, 0) + v) % MOD
+        dp = nd
+
+    accept = (1 << 0) | (1 << 3)
+    return sum(v for m, v in dp.items() if m & accept) % MOD

+def _cell(i: int, j: int) -> int:
+    if (i + j) % 2:
+        return 1
+    return 2 if (i + j // 2 + (i + j + 1) // 2) % 2 == 0 else 0
+
+
+_P = [[0] * 3 for _ in range(5)]
+for _x in range(1, 5):
+    for _y in range(1, 3):
+        _P[_x][_y] = (_P[_x - 1][_y] + _P[_x][_y - 1] - _P[_x - 1][_y - 1]
+                      + _cell(_x - 1, _y - 1))
+
+
+def _prefix(X: int, Y: int) -> int:
+    qx, rx = divmod(X, 4)
+    qy, ry = divmod(Y, 2)
+    return qx * qy * 8 + qy * _P[rx][2] + qx * _P[4][ry] + _P[rx][ry]
+

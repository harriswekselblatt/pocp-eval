+from math import isqrt
+
+
+def _iroot(n: int, k: int) -> int:
+    x = int(round(n ** (1.0 / k)))
+    while x ** k > n:
+        x -= 1
+    while (x + 1) ** k <= n:
+        x += 1
+    return x
+
+
+def _mobius(k: int) -> int:
+    res = 1
+    p = 2
+    while p * p <= k:
+        if k % p == 0:
+            k //= p
+            if k % p == 0:
+                return 0
+            res = -res
+        p += 1
+    if k > 1:
+        res = -res
+    return res
+
+
 def count_power_representations(n: int) -> int:

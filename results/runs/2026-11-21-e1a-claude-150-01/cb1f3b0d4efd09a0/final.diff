+def _iroot(n: int, k: int) -> int:
+    r = int(round(n ** (1.0 / k)))
+    while r ** k > n:
+        r -= 1
+    while (r + 1) ** k <= n:
+        r += 1
+    return r
+
+
+def _mobius(k: int) -> int:
+    res = 1
+    p = 2
+    while p * p <= k:
+        if k % p == 0:
+            k //= p
+            if k % p == 0:
+                return 0
+            res = -res
+        p += 1
+    if k > 1:
+        res = -res
+    return res
+

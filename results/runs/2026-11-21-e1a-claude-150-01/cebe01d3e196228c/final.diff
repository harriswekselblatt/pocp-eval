-    >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
-    0
-    """
-    pass
+    """Minimum number of pair-moves to turn s into t (empties at n+1, n+2), or -1."""
+    start = s + ".."
+    goal = t + ".."

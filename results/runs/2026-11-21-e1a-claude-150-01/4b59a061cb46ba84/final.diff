+        comb = comb * (x - k + 1) % MOD * pow(k, MOD - 2, MOD) % MOD
+        fact = fact * k % MOD
+        ypow = ypow * y % MOD
+        total = (total + comb * stirling[k] % MOD * fact % MOD * ypow) % MOD
+    return total

+    MOD = 10**9 + 7
+    m = min(n, x)
+    # stirling[k] = S(i, k) for the current i
+    stirling = [0] * (m + 1)
+    stirling[0] = 1
+    for i in range(1, n + 1):
+        for k in range(min(i, m), 0, -1):
+            stirling[k] = (stirling[k - 1] + k * stirling[k]) % MOD
+        stirling[0] = 0
+    total = 0
+    comb = 1  # C(x, k)
+    fact = 1  # k factorial
+    ypow = 1  # y^k

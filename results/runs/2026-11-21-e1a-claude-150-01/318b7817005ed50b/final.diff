@@ -21,4 +21,22 @@ def count_subsequence_pairs(nums: List[int]) -> int:
     >>> count_subsequence_pairs([1, 1, 1, 1])
     50
     """
-    pass
+    from math import gcd
+    MOD = 10**9 + 7
+    m = max(nums)
+    g = [[gcd(a, b) for b in range(m + 1)] for a in range(m + 1)]
+    dp = [[0] * (m + 1) for _ in range(m + 1)]
+    dp[0][0] = 1
+    for x in nums:
+        gx = g[x]
+        new = [row[:] for row in dp]
+        for a in range(m + 1):
+            row = dp[a]
+            ga = g[a]
+            for b in range(m + 1):
+                v = row[b]
+                if v:
+                    new[a][gx[b]] = (new[a][gx[b]] + v) % MOD
+                    new[ga[x]][b] = (new[ga[x]][b] + v) % MOD
+        dp = new
+    return sum(dp[i][i] for i in range(1, m + 1)) % MOD

@@ -16,4 +16,22 @@ def max_score(grid: List[List[int]]) -> int:
     >>> max_score([[8,7,6],[8,3,2]])
     15
     """
-    pass
+    n = len(grid)
+    rows_of = {}
+    for i, row in enumerate(grid):
+        for v in set(row):
+            rows_of.setdefault(v, []).append(i)
+    dp = [-1] * (1 << n)
+    dp[0] = 0
+    for v, rows in rows_of.items():
+        new = dp[:]
+        for mask in range(1 << n):
+            if dp[mask] < 0:
+                continue
+            for r in rows:
+                if not mask >> r & 1:
+                    m = mask | 1 << r
+                    if dp[mask] + v > new[m]:
+                        new[m] = dp[mask] + v
+        dp = new
+    return max(dp)

+    M = 10**9 + 7
+    m = min(n, x)
+    # S[k] = Stirling numbers of the second kind S(i, k), rolled over i
+    S = [0] * (m + 1)
+    S[0] = 1
+    for i in range(1, n + 1):
+        for k in range(min(i, m), 0, -1):
+            S[k] = (S[k - 1] + k * S[k]) % M
+        S[0] = 0

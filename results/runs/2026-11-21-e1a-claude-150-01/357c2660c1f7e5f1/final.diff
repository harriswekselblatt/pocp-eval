+def _is_black(x4: int, y4: int) -> bool:
+    # coordinates scaled by 4
+    a = x4 // 4
+    b = y4 // 8
+    c = (x4 + y4) // 8
+    return (a + b + c) % 2 == 0
+
+
+def _cells(w: int, h: int) -> int:
+    total = 0
+    for i in range(w):
+        for j in range(h):
+            if (i + j) % 2 == 1:
+                total += _is_black(4 * i + 1, 4 * j + 1)
+                total += _is_black(4 * i + 3, 4 * j + 3)
+            else:
+                total += 2 * _is_black(4 * i + 2, 4 * j + 2)
+    return total
+
+
+def _prefix(X: int, Y: int) -> int:
+    qx, rx = divmod(X, 4)
+    qy, ry = divmod(Y, 2)
+    return 8 * qx * qy + qy * _cells(rx, 2) + qx * _cells(4, ry) + _cells(rx, ry)
+

+def _black(px, py):
+    # px, py scaled by 4 to stay in integers
+    a = px // 4
+    b = py // 8
+    c = (px + py) // 8
+    return (a + b + c) % 2 == 0
+
+
+def _cell(i, j):
+    if (i + j) % 2 == 0:
+        return 2 if _black(4 * i + 2, 4 * j + 2) else 0
+    return int(_black(4 * i + 1, 4 * j + 1)) + int(_black(4 * i + 3, 4 * j + 3))
+
+
+def _S(a, b):
+    return sum(_cell(i, j) for i in range(a) for j in range(b))
+
+
+def _G(x, y):
+    qx, rx = divmod(x, 4)
+    qy, ry = divmod(y, 2)
+    return qx * qy * _S(4, 2) + qx * _S(4, ry) + qy * _S(rx, 2) + _S(rx, ry)
+

diff --git a/solution.py b/solution.py
index 5450587..9fc3db6 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,29 @@ def count_good_string_replacements(n: int, k: int, s: str) -> int:
     >>> count_good_string_replacements(2, 1, 'CC')
     1
     """
-    pass
+    modulus = 998244353
+    if k == 0:
+        return pow(3, s.count("?"), modulus)
+
+    # A substring reduces to empty exactly when its three letter counts
+    # have the same parity. These XOR masks identify parity triples that
+    # differ by toggling all three bits.
+    masks = {"A": (1,), "B": (2,), "C": (3,), "?": (1, 2, 3)}
+    states = {(0, (1, 0, 0, 0)): 1}
+    for letter in s:
+        next_states = {}
+        for (prefix, visits), ways in states.items():
+            for mask in masks[letter]:
+                new_prefix = prefix ^ mask
+                counts = list(visits)
+                counts[new_prefix] += 1
+                state = (new_prefix, tuple(counts))
+                next_states[state] = (next_states.get(state, 0) + ways) % modulus
+        states = next_states
+
+    # Every pair of prefixes in the same class defines one good substring.
+    return sum(
+        ways
+        for (_, visits), ways in states.items()
+        if sum(count * (count - 1) // 2 for count in visits) >= k
+    ) % modulus

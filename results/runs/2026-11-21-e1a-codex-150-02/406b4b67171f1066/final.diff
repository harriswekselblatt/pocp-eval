+from collections import deque
 from typing import List, Tuple
 
 
@@ -25,4 +26,72 @@ def max_shortest_distance(n: int, m: int, k: int, edges: List[Tuple[int, int]])
     >>> max_shortest_distance(2, 2, 1, [(1, 2), (1, 2)])
     0
     """
-    pass
+    def feasible(distance: int) -> bool:
+        # Node (v, level) represents a label p[v] >= level. A cut puts
+        # true nodes on the source side. Labels range from 0 to distance.
+        graph = [[] for _ in range(n * distance)]
+        source = (distance - 1) * n + n - 1
+        sink = 0
+        hard = k + 1
+
+        def add_arc(u: int, v: int, capacity: int) -> None:
+            graph[u].append([v, len(graph[v]), capacity])
+            graph[v].append([u, len(graph[u]) - 1, 0])
+
+        for level in range(distance):
+            offset = level * n
+            if level:
+                for v in range(n):
+                    add_arc(offset + v, offset + v - n, hard)
+            for u, v in edges:
+                tail = offset + u - 1
+                head = offset + v - 1
+                # Enforce p[v] <= p[u] + 1 and charge for a rise of one.
+                if level:
+                    add_arc(head, tail - n, hard)
+                add_arc(head, tail, 1)
+
+        # Find augmenting paths until the minimum cut is known to fit
+        # the budget or the flow proves that it exceeds the budget.
+        flow = 0
+        while flow <= k:
+            parent = [None] * len(graph)
+            parent[source] = (source, -1)
+            queue = deque([source])
+            while queue and parent[sink] is None:
+                u = queue.popleft()
+                for index, (v, _, capacity) in enumerate(graph[u]):
+                    if capacity and parent[v] is None:
+                        parent[v] = (u, index)
+                        queue.append(v)
+            if parent[sink] is None:
+                return True
+
+            amount = hard - flow
+            v = sink
+            while v != source:
+                u, index = parent[v]
+                amount = min(amount, graph[u][index][2])
+                v = u
+            v = sink
+            while v != source:
+                u, index = parent[v]
+                arc = graph[u][index]
+                arc[2] -= amount
+                graph[v][arc[1]][2] += amount
+                v = u
+            flow += amount
+        return False
+
+    # Along any path, edge weights dominate the telescoping label rises.
+    # Conversely, shortest distances capped at the target give such
+    # labels (use the cap for unreachable vertices). Extra upgrades can
+    # fill any unused budget without decreasing a shortest distance.
+    low, high = 0, min(n - 1, k, m) + 1
+    while high - low > 1:
+        mid = (low + high) // 2
+        if feasible(mid):
+            low = mid
+        else:
+            high = mid
+    return low

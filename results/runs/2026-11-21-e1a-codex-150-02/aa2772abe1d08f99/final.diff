index c0935b0..1e016fe 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,5 @@
+from collections import deque
+from functools import lru_cache
 from typing import List
 
 
@@ -28,4 +30,39 @@ def max_knight_moves(kx: int, ky: int, positions: List[List[int]]) -> int:
     >>> max_knight_moves(0, 0, [[1, 2], [2, 4]])
     3
     """
-    pass
+    squares = [*positions, (kx, ky)]
+    pawn_count = len(positions)
+    offsets = ((1, 2), (2, 1), (2, -1), (1, -2),
+               (-1, -2), (-2, -1), (-2, 1), (-1, 2))
+    distances = []
+    for start_x, start_y in squares:
+        board = [[-1] * 50 for _ in range(50)]
+        board[start_x][start_y] = 0
+        queue = deque([(start_x, start_y)])
+        while queue:
+            x, y = queue.popleft()
+            for dx, dy in offsets:
+                nx, ny = x + dx, y + dy
+                if 0 <= nx < 50 and 0 <= ny < 50 and board[nx][ny] == -1:
+                    board[nx][ny] = board[x][y] + 1
+                    queue.append((nx, ny))
+        distances.append([board[x][y] for x, y in positions])
+
+    @lru_cache(maxsize=None)
+    def play(current: int, remaining: int) -> int:
+        if not remaining:
+            return 0
+
+        alice_turn = (pawn_count - remaining.bit_count()) % 2 == 0
+        scores = []
+        choices = remaining
+        while choices:
+            pawn_bit = choices & -choices
+            pawn = pawn_bit.bit_length() - 1
+            scores.append(distances[current][pawn] + play(pawn, remaining ^ pawn_bit))
+            choices ^= pawn_bit
+        return max(scores) if alice_turn else min(scores)
+
+    result = play(pawn_count, (1 << pawn_count) - 1)
+    play.cache_clear()
+    return result

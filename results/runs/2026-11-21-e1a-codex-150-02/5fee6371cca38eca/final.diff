@@ -23,4 +26,18 @@ def find_largest_400_number(a: int) -> int:
     >>> find_largest_400_number(123456789)
     123454321
     """
-    pass
+    # Squaring doubles every prime exponent without changing the prime factors.
+    for root in range(isqrt(a), 5, -1):
+        remaining = root
+        distinct_factors = 0
+        divisor = 2
+        while divisor * divisor <= remaining and distinct_factors < 3:
+            if remaining % divisor == 0:
+                distinct_factors += 1
+                while remaining % divisor == 0:
+                    remaining //= divisor
+            divisor += 1
+
+        # If trial division finished, any remaining factor is prime.
+        if distinct_factors < 3 and distinct_factors + (remaining > 1) == 2:
+            return root * root

diff --git a/solution.py b/solution.py
index 864c653..f23e5bc 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,12 @@ def sum_of_subsequence_powers(nums: List[int], k: int) -> int:
     >>> sum_of_subsequence_powers([1, 2, 3], 7)
     0
     """
-    pass
+    modulus = 10**9 + 7
+    counts = [1] + [0] * k
+    for num in nums:
+        # An index outside the inner subsequence has two choices for the outer one.
+        for total in range(k, num - 1, -1):
+            counts[total] = (2 * counts[total] + counts[total - num]) % modulus
+        for total in range(min(num, k + 1)):
+            counts[total] = 2 * counts[total] % modulus
+    return counts[k]

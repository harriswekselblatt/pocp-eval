diff --git a/solution.py b/solution.py
index 89fc706..aea7a79 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from itertools import combinations, permutations
 from typing import Optional, List
 
 
@@ -21,7 +22,39 @@ def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
     
     >>> solve_grid(3, 'ABC', 'ABC')
     ['ABC', 'BCA', 'CAB']
-    >>> solve_grid(3, 'AAA', 'BBB')
-    None
+    >>> solve_grid(3, 'AAA', 'BBB') is None
+    True
     """
-    pass
+    row_options = {letter: [] for letter in "ABC"}
+    for columns in combinations(range(n), 3):
+        for letters in permutations("ABC"):
+            row = ["."] * n
+            for column, letter in zip(columns, letters):
+                row[column] = letter
+            row_options[letters[0]].append(("".join(row), tuple(zip(columns, letters))))
+
+    seen = [set() for _ in range(n)]
+    grid = []
+
+    def search() -> bool:
+        if len(grid) == n:
+            return all(len(column) == 3 for column in seen)
+
+        for row, entries in row_options[r[len(grid)]]:
+            if any(
+                letter in seen[column] or (not seen[column] and letter != c[column])
+                for column, letter in entries
+            ):
+                continue
+            for column, letter in entries:
+                seen[column].add(letter)
+            grid.append(row)
+            rows_left = n - len(grid)
+            if all(len(column) + rows_left >= 3 for column in seen) and search():
+                return True
+            grid.pop()
+            for column, letter in entries:
+                seen[column].remove(letter)
+        return False
+
+    return grid if search() else None

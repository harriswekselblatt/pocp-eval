@@ -23,4 +26,13 @@ def sum_manhattan_distances(m: int, n: int, k: int) -> int:
     >>> sum_manhattan_distances(1, 3, 3)
     4
     """
-    pass
+    modulus = 10**9 + 7
+
+    # The sum of coordinate gaps over all unordered pairs along an axis
+    # of length d is d * (d**2 - 1) // 6.
+    row_distances = (m * (m * m - 1) // 6) * n * n
+    column_distances = (n * (n * n - 1) // 6) * m * m
+
+    # Each pair appears in every choice of k - 2 other cells.
+    arrangements_per_pair = comb(m * n - 2, k - 2) % modulus
+    return (row_distances + column_distances) * arrangements_per_pair % modulus

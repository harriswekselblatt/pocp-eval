--- a/solution.py
+++ b/solution.py
@@ -23,4 +23,20 @@ def min_cost_to_achieve_goal(n: int, k: int, p: int, plans: List[Tuple[int, List
     >>> min_cost_to_achieve_goal(7, 3, 5, [(85, [1, 0, 1]), (37, [1, 1, 0]), (38, [2, 0, 0]), (45, [0, 2, 2]), (67, [1, 1, 0]), (12, [2, 2, 0]), (94, [2, 2, 1])])
     -1
     """
-    pass
+    goal = (p,) * k
+    minimum_costs = {(0,) * k: 0}
+
+    for cost, increases in plans:
+        # Take a snapshot so each transition uses the current plan at most once.
+        next_costs = minimum_costs.copy()
+        for levels, total_cost in minimum_costs.items():
+            new_levels = tuple(
+                min(p, level + increase)
+                for level, increase in zip(levels, increases)
+            )
+            new_cost = total_cost + cost
+            if new_cost < next_costs.get(new_levels, float("inf")):
+                next_costs[new_levels] = new_cost
+        minimum_costs = next_costs
+
+    return minimum_costs.get(goal, -1)

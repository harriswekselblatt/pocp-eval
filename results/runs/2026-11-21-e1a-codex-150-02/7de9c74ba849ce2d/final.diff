diff --git a/solution.py b/solution.py
index cc09fd3..a9b8f82 100644
--- a/solution.py
+++ b/solution.py
@@ -19,4 +19,17 @@ def count_square_permutations(n: int, s: str) -> int:
     >>> count_square_permutations(1, '4')
     1
     """
-    pass
+    from math import isqrt
+
+    target_digits = sorted(s)
+    digit_sum_mod_9 = sum(map(int, s)) % 9
+    if digit_sum_mod_9 not in (0, 1, 4, 7):
+        return 0
+
+    count = 0
+    for root in range(isqrt(10**n - 1) + 1):
+        square = root * root
+        # Padding with zeros preserves permutations that begin with zero.
+        if square % 9 == digit_sum_mod_9 and sorted(str(square).zfill(n)) == target_digits:
+            count += 1
+    return count

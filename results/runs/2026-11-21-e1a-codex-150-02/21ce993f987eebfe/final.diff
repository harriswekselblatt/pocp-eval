diff --git a/solution.py b/solution.py
index a800cd6..eb89186 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,17 @@ def max_eleven_twentytwo_subsequence(s: str, l: int, r: int) -> int:
     >>> max_eleven_twentytwo_subsequence('111/212/1122', 3, 6)
     3
     """
-    pass
+    segment = s[l - 1:r]
+    ones = 0
+    twos = segment.count('2')
+    best = 0
+
+    for char in segment:
+        if char == '1':
+            ones += 1
+        elif char == '2':
+            twos -= 1
+        elif char == '/':
+            best = max(best, 2 * min(ones, twos) + 1)
+
+    return best

diff --git a/solution.py b/solution.py
index 6dad4f0..fd57c58 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,39 @@ def sum_of_powers(nums: List[int], k: int) -> int:
     >>> sum_of_powers([4, 3, -1], 2)
     10
     """
-    pass
+    modulus = 10**9 + 7
+    values = sorted(nums)
+    n = len(values)
+    max_gap = (values[-1] - values[0]) // (k - 1)
+    gaps = set()
+    for right, value in enumerate(values):
+        for left in range(right):
+            gap = value - values[left]
+            if 0 < gap <= max_gap:
+                gaps.add(gap)
+
+    total = 0
+    previous_gap = 0
+    for gap in sorted(gaps):
+        # compatible[i] counts the earlier indices that can precede i.
+        compatible = []
+        left = 0
+        for value in values:
+            while value - values[left] >= gap:
+                left += 1
+            compatible.append(left)
+
+        # prefix[i] counts selections of the current length in values[:i].
+        prefix = list(range(n + 1))
+        for length in range(2, k + 1):
+            next_prefix = [0] * (n + 1)
+            for right in range(length - 1, n):
+                next_prefix[right + 1] = (
+                    next_prefix[right] + prefix[compatible[right]]
+                ) % modulus
+            prefix = next_prefix
+        # Each qualifying selection contributes this interval of powers.
+        total += (gap - previous_gap) * prefix[-1]
+        previous_gap = gap
+
+    return total % modulus

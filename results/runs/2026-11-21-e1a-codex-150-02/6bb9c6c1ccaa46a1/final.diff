diff --git a/solution.py b/solution.py
index e3588ad..e8ed49d 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,36 @@ def count_strings_by_lcs_length(n: int, m: int, s: str) -> List[int]:
     >>> count_strings_by_lcs_length(3, 4, 'aaa')
     [390625, 62500, 3750, 101]
     """
-    pass
+    modulus = 998244353
+    letter_masks = {}
+    for position, letter in enumerate(s):
+        letter_masks[letter] = letter_masks.get(letter, 0) | (1 << position)
+
+    # A state marks the positions where the LCS length increases as the
+    # prefix of s grows. Appending a letter absent from s leaves it unchanged.
+    state_count = 1 << n
+    absent_letters = 26 - len(letter_masks)
+    transitions = []
+    for state in range(state_count):
+        shifted = (state << 1) | 1
+        destinations = []
+        for mask in letter_masks.values():
+            matches = state | mask
+            # Subtraction selects the first available position for each increase.
+            destinations.append(matches & ~(matches - shifted))
+        transitions.append(destinations)
+
+    counts = [0] * state_count
+    counts[0] = 1
+    for _ in range(m):
+        next_counts = [count * absent_letters for count in counts]
+        for count, destinations in zip(counts, transitions):
+            if count:
+                for destination in destinations:
+                    next_counts[destination] += count
+        counts = [count % modulus for count in next_counts]
+
+    result = [0] * (n + 1)
+    for state, count in enumerate(counts):
+        result[state.bit_count()] += count
+    return [count % modulus for count in result]

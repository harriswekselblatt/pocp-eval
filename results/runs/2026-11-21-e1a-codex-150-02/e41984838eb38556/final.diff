@@ -1,3 +1,6 @@
+from math import gcd
+
+
 def can_color_all_points(n: int, k: int) -> bool:
     """ Alice and Bob are on a circle with n equally spaced points numbered 0 to n-1.
     Alice is at point 0, Bob is at point k. Initially all points are white.
@@ -22,4 +25,17 @@ def can_color_all_points(n: int, k: int) -> bool:
     >>> can_color_all_points(6, 1)
     True
     """
-    pass
+    # The two reflections compose to a rotation by 2*k. Its residue
+    # classes modulo gcd(n, 2*k) are paired by negation under reflection.
+    # Any paired classes form a cycle with no fixed point to start from.
+    if gcd(n, 2 * k) > 2:
+        return False
+
+    # Each remaining component is a path, possibly a single point.
+    # A player starts at one of their fixed points. After that, each move
+    # must extend the path to restore symmetry for the current player.
+    # Odd n has one path. For n = 2 mod 4, the two paths have odd length
+    # in vertices and each has a fixed point for either player.
+    # For n = 0 mod 4, Alice starts an even-sized path and gets the
+    # next turn after it is filled, but only Bob can start the other path.
+    return n % 4 != 0

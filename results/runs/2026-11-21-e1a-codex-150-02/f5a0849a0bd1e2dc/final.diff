diff --git a/solution.py b/solution.py
index e3588ad..79c38a5 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,37 @@ def count_strings_by_lcs_length(n: int, m: int, s: str) -> List[int]:
     >>> count_strings_by_lcs_length(3, 4, 'aaa')
     [390625, 62500, 3750, 101]
     """
-    pass
+    modulus = 998244353
+    letters = set(s)
+    absent_letters = 26 - len(letters)
+    state_count = 1 << n
+
+    # Each bit records an increase in the LCS length across prefixes of s.
+    transitions = []
+    for state in range(state_count):
+        next_states = []
+        for letter in letters:
+            previous = current = next_state = 0
+            for index, target in enumerate(s):
+                old = previous + ((state >> index) & 1)
+                updated = previous + 1 if letter == target else max(old, current)
+                next_state |= (updated - current) << index
+                previous, current = old, updated
+            next_states.append(next_state)
+        transitions.append(next_states)
+
+    counts = [0] * state_count
+    counts[0] = 1
+    for _ in range(m):
+        # Appending any letter absent from s leaves the LCS row unchanged.
+        next_counts = [count * absent_letters for count in counts]
+        for state, count in enumerate(counts):
+            if count:
+                for next_state in transitions[state]:
+                    next_counts[next_state] += count
+        counts = [count % modulus for count in next_counts]
+
+    result = [0] * (n + 1)
+    for state, count in enumerate(counts):
+        result[state.bit_count()] += count
+    return [count % modulus for count in result]

@@ -22,4 +22,14 @@ def sum_of_subsequence_powers(nums: List[int], k: int) -> int:
     >>> sum_of_subsequence_powers([1, 2, 3], 7)
     0
     """
-    pass
+    modulus = 10**9 + 7
+    counts = [1] + [0] * k
+    for value in nums:
+        # An index outside the inner subsequence can be included in or
+        # omitted from the outer subsequence.
+        for total in range(k, -1, -1):
+            count = 2 * counts[total]
+            if total >= value:
+                count += counts[total - value]
+            counts[total] = count % modulus
+    return counts[k]

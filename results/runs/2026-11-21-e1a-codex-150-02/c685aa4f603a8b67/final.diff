--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from math import factorial
 from typing import List
 
 
@@ -23,4 +24,28 @@ def kth_alternating_permutation(n: int, k: int) -> List[int]:
     >>> kth_alternating_permutation(2, 3)
     []
     """
-    pass
+    remaining = list(range(1, n + 1))
+    permutation = []
+    required_parity = 1 if n % 2 else None
+
+    while remaining:
+        suffix_length = len(remaining) - 1
+        # A valid next value fixes the suffix's parity pattern. Values of
+        # each parity can be assigned to their slots in any order.
+        completions = factorial(suffix_length // 2) * factorial(
+            (suffix_length + 1) // 2
+        )
+        for index, value in enumerate(remaining):
+            parity = value % 2
+            if required_parity is not None and parity != required_parity:
+                continue
+            if k > completions:
+                k -= completions
+                continue
+            permutation.append(remaining.pop(index))
+            required_parity = 1 - parity
+            break
+        else:
+            return []
+
+    return permutation

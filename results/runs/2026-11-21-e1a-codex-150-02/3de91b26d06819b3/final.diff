+from math import gcd
 from typing import List
 
 
@@ -21,4 +22,27 @@ def count_subsequence_pairs(nums: List[int]) -> int:
     >>> count_subsequence_pairs([1, 1, 1, 1])
     50
     """
-    pass
+    modulus = 10**9 + 7
+    limit = max(nums)
+    gcds = {
+        value: [gcd(previous, value) for previous in range(limit + 1)]
+        for value in set(nums)
+    }
+
+    # A GCD of zero denotes an empty subsequence.
+    counts = {(0, 0): 1}
+    for value in nums:
+        next_counts = counts.copy()
+        with_value = gcds[value]
+        for (first, second), count in counts.items():
+            first_choice = (with_value[first], second)
+            second_choice = (first, with_value[second])
+            next_counts[first_choice] = (
+                next_counts.get(first_choice, 0) + count
+            ) % modulus
+            next_counts[second_choice] = (
+                next_counts.get(second_choice, 0) + count
+            ) % modulus
+        counts = next_counts
+
+    return sum(counts.get((value, value), 0) for value in range(1, limit + 1)) % modulus

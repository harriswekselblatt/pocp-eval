+
 def count_power_representations(n: int) -> int:
     """ Count how many integers x between 1 and n (inclusive) can be expressed as x = a^b
     where a is a positive integer and b is an integer greater than or equal to 2.
@@ -13,4 +16,25 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    pass
+    max_exponent = n.bit_length() - 1
+    counts = [0] * (max_exponent + 1)
+
+    # For x > 1, the exponents that represent x divide its largest
+    # exponent, the gcd of the exponents in its prime factorization.
+    for exponent in range(max_exponent, 1, -1):
+        if exponent == 2:
+            root = isqrt(n)
+        else:
+            low = 1
+            high = 1 << ((max_exponent // exponent) + 1)
+            while low + 1 < high:
+                middle = (low + high) // 2
+                if middle ** exponent <= n:
+                    low = middle
+                else:
+                    high = middle
+            root = low
+
+        counts[exponent] = root - 1 - sum(counts[2 * exponent::exponent])
+
+    return 1 + sum(counts)

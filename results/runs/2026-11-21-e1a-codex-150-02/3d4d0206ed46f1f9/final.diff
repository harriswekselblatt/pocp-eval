diff --git a/solution.py b/solution.py
index b7192c8..806e0f8 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,45 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    limit = 2 * n - 2
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % mod
+
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], mod - 2, mod)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % mod
+
+    def choose(top: int, bottom: int) -> int:
+        if bottom > top:
+            return 0
+        return factorial[top] * inverse_factorial[bottom] * inverse_factorial[top - bottom] % mod
+
+    def forest_suffix(nodes: int, roots: int) -> int:
+        # Sum the ballot counts for forests with at least this many roots.
+        # The count for exactly k roots is the difference of consecutive sums.
+        top = 2 * nodes - roots
+        return choose(top, nodes) - choose(top, nodes + 1)
+
+    answer = 0
+    slots = 1
+    for i, bound in enumerate(a):
+        remaining = n - i - 1
+        if remaining == 0:
+            # A feasible prefix leaves exactly one slot for a final leaf.
+            return (answer + 1) % mod
+
+        # The next node consumes one slot and adds one per child.
+        # Count smaller child counts before continuing along the bound.
+        first = max(1, slots - 1)
+        stop = min(remaining + 1, slots - 1 + bound)
+        if first < stop:
+            answer += forest_suffix(remaining, first) - forest_suffix(remaining, stop)
+
+        slots += bound - 1
+        if not 1 <= slots <= remaining:
+            return answer % mod
+
+    return answer % mod

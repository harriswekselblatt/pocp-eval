+    modulus = 10**9 + 7
+
+    def count_up_to(bound: str) -> int:
+        # A previous digit of -1 means the number has not started yet.
+        states = {(-1, True): 1}
+        for character in bound:
+            bound_digit = int(character)
+            next_states = {}
+            for (previous, tight), count in states.items():
+                limit = bound_digit if tight else 9
+                for digit in range(limit + 1):
+                    if previous != -1 and abs(previous - digit) != 1:
+                        continue
+                    last = -1 if previous == -1 and digit == 0 else digit
+                    state = (last, tight and digit == bound_digit)
+                    next_states[state] = (next_states.get(state, 0) + count) % modulus
+            states = next_states
+        return sum(count for (last, _), count in states.items() if last != -1)
+

diff --git a/solution.py b/solution.py
index 5ce8f68..9c15a70 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,15 @@ def sum_imbalance_numbers(nums: List[int]) -> int:
     >>> sum_imbalance_numbers([1, 3, 3, 3, 5])
     8
     """
-    pass
+    total = 0
+    for start, first in enumerate(nums):
+        seen = {first}
+        imbalance = 0
+        for end in range(start + 1, len(nums)):
+            value = nums[end]
+            if value not in seen:
+                # A new value adds a run, then joins each adjacent run.
+                imbalance += 1 - (value - 1 in seen) - (value + 1 in seen)
+                seen.add(value)
+            total += imbalance
+    return total

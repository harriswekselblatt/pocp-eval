+from collections import deque
 from typing import List, Tuple
 
 
@@ -25,4 +26,62 @@ def max_shortest_distance(n: int, m: int, k: int, edges: List[Tuple[int, int]])
     >>> max_shortest_distance(2, 2, 1, [(1, 2), (1, 2)])
     0
     """
-    pass
+    def feasible(distance: int) -> bool:
+        # The source side of the cut at level i represents labels >= i.
+        # Labels increase by at most one along each edge, and each increase
+        # uses one unit of budget.
+        residual = [{} for _ in range(n * distance)]
+        hard = k + 1
+
+        def add_arc(start: int, end: int, capacity: int) -> None:
+            residual[start][end] = residual[start].get(end, 0) + capacity
+            residual[end].setdefault(start, 0)
+
+        for offset in range(0, n * distance, n):
+            for u, v in edges:
+                add_arc(offset + v - 1, offset + u - 1, 1)
+                if offset:
+                    add_arc(offset + v - 1, offset + u - 1 - n, hard)
+            if offset:
+                for vertex in range(n):
+                    add_arc(offset + vertex, offset + vertex - n, hard)
+
+        source, sink = n * distance - 1, 0
+        flow = 0
+        while flow <= k:
+            parent = [-1] * len(residual)
+            parent[source] = source
+            queue = deque([source])
+            while queue and parent[sink] == -1:
+                start = queue.popleft()
+                for end, capacity in residual[start].items():
+                    if capacity and parent[end] == -1:
+                        parent[end] = start
+                        queue.append(end)
+            if parent[sink] == -1:
+                return True
+
+            amount = hard - flow
+            end = sink
+            while end != source:
+                start = parent[end]
+                amount = min(amount, residual[start][end])
+                end = start
+            end = sink
+            while end != source:
+                start = parent[end]
+                residual[start][end] -= amount
+                residual[end][start] += amount
+                end = start
+            flow += amount
+        return False
+
+    # Any unused budget can be spent without reducing the shortest distance.
+    low, high = 0, min(n - 1, k)
+    while low < high:
+        middle = (low + high + 1) // 2
+        if feasible(middle):
+            low = middle
+        else:
+            high = middle - 1
+    return low

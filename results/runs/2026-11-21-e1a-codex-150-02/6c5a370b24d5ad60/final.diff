diff --git a/solution.py b/solution.py
index 21dc05f..229ee03 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,30 @@ def count_valid_permutations(n: int, requirements: List[List[int]]) -> int:
     >>> count_valid_permutations(2, [[0, 0], [1, 0]])
     1
     """
-    pass
+    modulus = 10**9 + 7
+    required = dict(requirements)
+    total = required[n - 1]
+    counts = [1] + [0] * total
+
+    # At index i, the number of earlier entries larger than the new
+    # entry can be any value from 0 to i. These choices uniquely encode
+    # the permutation, and their running sum gives prefix inversions.
+    for i in range(n):
+        next_counts = [0] * (total + 1)
+        window = 0
+        for inversions in range(total + 1):
+            window += counts[inversions]
+            if inversions > i:
+                window -= counts[inversions - i - 1]
+            next_counts[inversions] = window % modulus
+
+        target = required.get(i)
+        if target is not None:
+            if target > total or not next_counts[target]:
+                return 0
+            ways = next_counts[target]
+            next_counts = [0] * (total + 1)
+            next_counts[target] = ways
+        counts = next_counts
+
+    return counts[total]

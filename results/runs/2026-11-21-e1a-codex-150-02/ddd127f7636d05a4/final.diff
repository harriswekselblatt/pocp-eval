@@ -24,4 +24,37 @@ def min_team_switches(people: List[Tuple[int, int]]) -> int:
     >>> min_team_switches([(1, 1), (2, 1), (3, 1)])
     0
     """
-    pass
+    totals = [0, 0, 0]
+    for team, strength in people:
+        totals[team - 1] += strength
+
+    target, remainder = divmod(sum(totals), 3)
+    if remainder:
+        return -1
+    if totals[0] == totals[1] == totals[2]:
+        return 0
+    if any(strength > target for _, strength in people):
+        return -1
+
+    # The processed strength determines team 3's total from the other two.
+    costs = {(0, 0): 0}
+    processed_strength = 0
+    for original_team, strength in people:
+        next_costs = {}
+        for (first, second), switches in costs.items():
+            third = processed_strength - first - second
+            for team, total, state in (
+                (1, first, (first + strength, second)),
+                (2, second, (first, second + strength)),
+                (3, third, (first, second)),
+            ):
+                if total + strength <= target:
+                    cost = switches + (team != original_team)
+                    if state not in next_costs or cost < next_costs[state]:
+                        next_costs[state] = cost
+        if not next_costs:
+            return -1
+        costs = next_costs
+        processed_strength += strength
+
+    return costs.get((target, target), -1)

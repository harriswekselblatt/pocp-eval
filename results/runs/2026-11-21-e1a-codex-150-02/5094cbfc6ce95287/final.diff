--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from math import factorial
 from typing import List
 
 
@@ -23,4 +24,29 @@ def kth_alternating_permutation(n: int, k: int) -> List[int]:
     >>> kth_alternating_permutation(2, 3)
     []
     """
-    pass
+    remaining = list(range(1, n + 1))
+    permutation = []
+    # With an odd length, the first element must use the majority parity.
+    required_parity = 1 if n % 2 else None
+    rank = k - 1
+
+    while remaining:
+        suffix_length = len(remaining) - 1
+        # Each eligible choice fixes the suffix parity pattern.
+        block_size = factorial(suffix_length // 2) * factorial(
+            (suffix_length + 1) // 2
+        )
+        choice, rank = divmod(rank, block_size)
+        eligible = [
+            index
+            for index, value in enumerate(remaining)
+            if required_parity is None or value % 2 == required_parity
+        ]
+        if choice >= len(eligible):
+            return []
+
+        value = remaining.pop(eligible[choice])
+        permutation.append(value)
+        required_parity = 1 - value % 2
+
+    return permutation

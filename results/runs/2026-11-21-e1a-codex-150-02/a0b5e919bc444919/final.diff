diff --git a/solution.py b/solution.py
index 3f169b6..c968cf0 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,22 @@ def max_distinct_sum_three_parts(arr: List[int]) -> int:
     >>> max_distinct_sum_three_parts([2, 5, 6, 4, 4, 1, 1, 3, 1, 4])
     9
     """
-    pass
+    n = len(arr)
+    suffix_counts = [0] * n
+    suffix_values = set()
+    for index in range(n - 1, 1, -1):
+        suffix_values.add(arr[index])
+        suffix_counts[index] = len(suffix_values)
+
+    best = 0
+    prefix_values = set()
+    for first_cut in range(1, n - 1):
+        prefix_values.add(arr[first_cut - 1])
+        prefix_count = len(prefix_values)
+        middle_values = set()
+        for second_cut in range(first_cut + 1, n):
+            middle_values.add(arr[second_cut - 1])
+            total = prefix_count + len(middle_values) + suffix_counts[second_cut]
+            best = max(best, total)
+
+    return best

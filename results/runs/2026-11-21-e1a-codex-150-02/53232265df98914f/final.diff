@@ -13,4 +16,25 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    pass
+    max_exponent = n.bit_length() - 1
+    counts = [0] * (max_exponent + 1)
+
+    # For x > 1, every valid exponent divides its largest valid exponent.
+    # Count those with each largest exponent by subtracting its multiples.
+    for exponent in range(max_exponent, 1, -1):
+        if exponent == 2:
+            root = isqrt(n)
+        else:
+            low = 1
+            high = 1 << ((n.bit_length() + exponent - 1) // exponent)
+            while high - low > 1:
+                mid = (low + high) // 2
+                if mid**exponent <= n:
+                    low = mid
+                else:
+                    high = mid
+            root = low
+
+        counts[exponent] = root - 1 - sum(counts[2 * exponent :: exponent])
+
+    return 1 + sum(counts)

@@ -24,4 +24,38 @@ def min_team_switches(people: List[Tuple[int, int]]) -> int:
     >>> min_team_switches([(1, 1), (2, 1), (3, 1)])
     0
     """
-    pass
+    team_totals = [0, 0, 0]
+    for team, strength in people:
+        team_totals[team - 1] += strength
+
+    target, remainder = divmod(sum(team_totals), 3)
+    if remainder:
+        return -1
+    if team_totals == [target] * 3:
+        return 0
+    if any(strength > target for _, strength in people):
+        return -1
+
+    # Store the minimum switch count for each pair of partial team totals.
+    # The third total is determined by the strength assigned so far.
+    costs = {(0, 0): 0}
+    assigned = 0
+    for original_team, strength in people:
+        next_costs = {}
+        for (first, second), switches in costs.items():
+            third = assigned - first - second
+            for team, total, state in (
+                (1, first, (first + strength, second)),
+                (2, second, (first, second + strength)),
+                (3, third, (first, second)),
+            ):
+                if total + strength <= target:
+                    cost = switches + (team != original_team)
+                    if cost < next_costs.get(state, len(people) + 1):
+                        next_costs[state] = cost
+        if not next_costs:
+            return -1
+        costs = next_costs
+        assigned += strength
+
+    return costs.get((target, target), -1)

@@ -23,4 +23,19 @@ def sum_manhattan_distances(m: int, n: int, k: int) -> int:
     >>> sum_manhattan_distances(1, 3, 3)
     4
     """
-    pass
+    modulus = 10**9 + 7
+    remaining = m * n - 2
+    choose = min(k - 2, m * n - k)
+
+    # Each pair of cells occurs in C(remaining, choose) arrangements.
+    numerator = denominator = 1
+    for i in range(1, choose + 1):
+        numerator = numerator * (remaining - i + 1) % modulus
+        denominator = denominator * i % modulus
+    arrangements = numerator * pow(denominator, modulus - 2, modulus) % modulus
+
+    # Along an axis of length L, the sum of pairwise gaps is C(L + 1, 3).
+    # The coordinates on the other axis can be chosen independently.
+    row_distances = (m - 1) * m * (m + 1) // 6 * n**2
+    column_distances = (n - 1) * n * (n + 1) // 6 * m**2
+    return (row_distances + column_distances) * arrangements % modulus

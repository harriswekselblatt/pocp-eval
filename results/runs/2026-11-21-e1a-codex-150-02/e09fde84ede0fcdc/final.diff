diff --git a/solution.py b/solution.py
index a800cd6..033424f 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,15 @@ def max_eleven_twentytwo_subsequence(s: str, l: int, r: int) -> int:
     >>> max_eleven_twentytwo_subsequence('111/212/1122', 3, 6)
     3
     """
-    pass
+    window = s[l - 1:r]
+    ones_before = 0
+    twos_after = window.count('2')
+    best = 0
+    for char in window:
+        if char == '1':
+            ones_before += 1
+        elif char == '2':
+            twos_after -= 1
+        elif char == '/':
+            best = max(best, 2 * min(ones_before, twos_after) + 1)
+    return best

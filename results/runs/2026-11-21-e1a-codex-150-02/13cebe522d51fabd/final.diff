diff --git a/solution.py b/solution.py
index 21dc05f..8ce6caf 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,28 @@ def count_valid_permutations(n: int, requirements: List[List[int]]) -> int:
     >>> count_valid_permutations(2, [[0, 0], [1, 0]])
     1
     """
-    pass
+    modulus = 10**9 + 7
+    required_counts = dict(requirements)
+    total = required_counts[n - 1]
+    counts = [1] + [0] * total
+
+    for end in range(n):
+        # The new element can contribute any number of inversions from 0 to end.
+        next_counts = [0] * (total + 1)
+        window = 0
+        for inversions in range(total + 1):
+            window += counts[inversions]
+            if inversions > end:
+                window -= counts[inversions - end - 1]
+            next_counts[inversions] = window % modulus
+
+        required = required_counts.get(end)
+        if required is not None:
+            if required > total or next_counts[required] == 0:
+                return 0
+            ways = next_counts[required]
+            next_counts = [0] * (total + 1)
+            next_counts[required] = ways
+        counts = next_counts
+
+    return counts[total]

diff --git a/solution.py b/solution.py
index 6e6d26a..4a0ca3a 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,30 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    modulus = 998244353
+    if W > H:
+        grid = list(zip(*grid))
+
+    # Two bits per column store its most recently processed color.
+    counts = {0: 1}
+    for row in grid:
+        for column, cell in enumerate(row):
+            shift = 2 * column
+            clear_color = ~(3 << shift)
+            colors = (1, 2, 3) if cell == "?" else (int(cell),)
+            next_counts = {}
+            for frontier, count in counts.items():
+                above = (frontier >> shift) & 3
+                left = (frontier >> (shift - 2)) & 3 if column else 0
+                for color in colors:
+                    if color == above or color == left:
+                        continue
+                    updated = (frontier & clear_color) | (color << shift)
+                    next_counts[updated] = (
+                        next_counts.get(updated, 0) + count
+                    ) % modulus
+            if not next_counts:
+                return 0
+            counts = next_counts
+
+    return sum(counts.values()) % modulus

diff --git a/solution.py b/solution.py
index 1032d77..6e19106 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,27 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    # Insertion sort moves each value left once for every larger value
+    # preceding it. A Fenwick tree counts the smaller preceding values.
+    counts = [0] * (n + 1)
+    cost = 0
+    for position, value in enumerate(permutation, start=1):
+        smaller = 0
+        index = value - 1
+        while index:
+            smaller += counts[index]
+            index -= index & -index
+
+        # The swap costs run from smaller + 1 through position - 1.
+        # This sum over all values is a lower bound as well: swapping an
+        # adjacent inversion at boundary i reduces the sum by i minus the
+        # number of preceding values larger than the left value. The
+        # reverse swap increases it, and the sum is zero when sorted.
+        cost += (position - 1 - smaller) * (position + smaller) // 2
+
+        index = value
+        while index <= n:
+            counts[index] += 1
+            index += index & -index
+
+    return cost

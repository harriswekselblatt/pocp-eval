diff --git a/solution.py b/solution.py
index b957b01..489f0e0 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,16 @@ def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:
     >>> calculate_black_area_doubled(-1000000000, -1000000000, 1000000000, 1000000000)
     4000000000000000000
     """
-    pass
+    # Each entry is twice the black area of one unit square. Moving four
+    # columns or two rows crosses an even number of coloring boundaries.
+    tile = ((2, 1, 0, 1), (1, 2, 1, 0))
+    full_widths, extra_columns = divmod(C - A, 4)
+    full_heights, extra_rows = divmod(D - B, 2)
+
+    return sum(
+        area
+        * (full_widths + ((x - A) % 4 < extra_columns))
+        * (full_heights + ((y - B) % 2 < extra_rows))
+        for y, row in enumerate(tile)
+        for x, area in enumerate(row)
+    )

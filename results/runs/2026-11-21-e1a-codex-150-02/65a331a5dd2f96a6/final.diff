diff --git a/solution.py b/solution.py
index 8353135..648093a 100644
--- a/solution.py
+++ b/solution.py
@@ -18,4 +18,30 @@ def count_stepping_numbers(low: str, high: str) -> int:
     >>> count_stepping_numbers("4", "9")
     6
     """
-    pass
+    modulus = 10**9 + 7
+    low, high = low.lstrip("0"), high.lstrip("0")
+
+    # Each row counts ways to append that many digits after a given digit.
+    suffix_counts = [[1] * 10]
+    for _ in range(1, len(high)):
+        previous = suffix_counts[-1]
+        suffix_counts.append([
+            ((previous[digit - 1] if digit > 0 else 0)
+             + (previous[digit + 1] if digit < 9 else 0)) % modulus
+            for digit in range(10)
+        ])
+
+    def count_up_to(bound: str, inclusive: bool) -> int:
+        total = sum(sum(row[1:]) for row in suffix_counts[:len(bound) - 1])
+        allowed = range(1, 10)
+        for index, digit in enumerate(map(int, bound)):
+            suffix = suffix_counts[len(bound) - index - 1]
+            total += sum(suffix[next_digit] for next_digit in allowed
+                         if next_digit < digit)
+            if digit not in allowed:
+                return total % modulus
+            allowed = tuple(neighbor for neighbor in (digit - 1, digit + 1)
+                            if 0 <= neighbor <= 9)
+        return (total + inclusive) % modulus
+
+    return (count_up_to(high, True) - count_up_to(low, False)) % modulus

@@ -14,4 +14,15 @@ def paint_walls(cost: List[int], time: List[int]) -> int:
     >>> paint_walls([2, 3, 4, 2], [1, 1, 1, 1])
     4
     """
-    pass
+    wall_count = len(cost)
+    # min_cost[k] is the cheapest way to cover at least k walls.
+    min_cost = [0] + [float("inf")] * wall_count
+
+    for price, duration in zip(cost, time):
+        coverage = duration + 1
+        # Iterate backward so each paid wall can only be selected once.
+        for required in range(wall_count, 0, -1):
+            remaining = max(0, required - coverage)
+            min_cost[required] = min(min_cost[required], price + min_cost[remaining])
+
+    return min_cost[wall_count]

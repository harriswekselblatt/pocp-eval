diff --git a/solution.py b/solution.py
index 0b61e39..a9cb959 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from functools import lru_cache
 from typing import List, Tuple
 
 
@@ -24,4 +25,37 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    full_grid = (1 << (h * w)) - 1
+    orientations = []
+    for a, b in tiles:
+        placements = []
+        for height, width in {(a, b), (b, a)}:
+            if height <= h and width <= w:
+                row_mask = (1 << width) - 1
+                shape = sum(row_mask << (row * w) for row in range(height))
+                placements.append((height, width, shape))
+        orientations.append(placements)
+
+    @lru_cache(maxsize=None)
+    def search(covered: int, used: int) -> bool:
+        if covered == full_grid:
+            return True
+
+        # A tile covering the first empty cell must start there, since all
+        # cells earlier in row order are already covered.
+        empty = full_grid ^ covered
+        first = (empty & -empty).bit_length() - 1
+        row, col = divmod(first, w)
+        for index, placements in enumerate(orientations):
+            tile_bit = 1 << index
+            if used & tile_bit:
+                continue
+            for height, width, shape in placements:
+                if row + height > h or col + width > w:
+                    continue
+                mask = shape << first
+                if not (covered & mask) and search(covered | mask, used | tile_bit):
+                    return True
+        return False
+
+    return search(0, 0)

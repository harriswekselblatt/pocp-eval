diff --git a/solution.py b/solution.py
index 6aa0bfb..cae3ed6 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,46 @@ def sum_of_scores(n: int, m: int) -> int:
     >>> sum_of_scores(81131, 14)
     182955659
     """
-    pass
+    modulus = 998244353
+    primes = [p for p in (2, 3, 5, 7, 11, 13) if p <= m]
+    size = 1 << len(primes)
+
+    # A mask represents a monomial with one variable per selected prime.
+    # Squared variables vanish, so multiplication adds the prime exponents
+    # represented by the linear factors: (1 + a*x)(1 + b*x) = 1 + (a+b)*x.
+    single = [0] * size
+    for value in range(1, m + 1):
+        coefficients = [1]
+        for prime in primes:
+            exponent = 0
+            while value % prime == 0:
+                value //= prime
+                exponent += 1
+            coefficients += [exponent * coefficient for coefficient in coefficients]
+        single = [a + b for a, b in zip(single, coefficients)]
+
+    def multiply(left, right):
+        result = [0] * size
+        for mask in range(size):
+            subset = mask
+            while subset:
+                result[mask] += left[subset] * right[mask ^ subset]
+                subset = (subset - 1) & mask
+            result[mask] = (result[mask] + left[0] * right[mask]) % modulus
+        return result
+
+    # For each binary prefix k of n, maintain single**k and the sum of
+    # single**j for 1 <= j <= k. Doubling appends a shifted copy of that sum.
+    power = [1] + [0] * (size - 1)
+    total = [0] * size
+    for bit in bin(n)[2:]:
+        shifted = multiply(power, total)
+        total = [(a + b) % modulus for a, b in zip(total, shifted)]
+        power = multiply(power, power)
+        if bit == "1":
+            power = multiply(power, single)
+            total = [(a + b) % modulus for a, b in zip(total, power)]
+
+    # Summing the monomial coefficients gives the product of (exponent + 1)
+    # for each sequence, which is its number of positive divisors.
+    return sum(total) % modulus

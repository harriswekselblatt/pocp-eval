diff --git a/solution.py b/solution.py
index 3daaab6..2014f65 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,37 @@ def minimize_path_weights(n: int, edges: List[Tuple[int, int, int]], a: List[int
     >>> minimize_path_weights(3, [(1, 2, 5), (2, 3, 2), (1, 3, 1)], [1, 1], [2, 3])
     3
     """
-    pass
+    # Include every vertex referenced by the graph, even if n is understated.
+    vertex_count = max((max(u, v) for u, v, _ in edges), default=n)
+    vertex_count = max(n, vertex_count)
+    parent = list(range(vertex_count + 1))
+    size = [1] * (vertex_count + 1)
+    balance = [0] * (vertex_count + 1)
+    for vertex in a:
+        balance[vertex] += 1
+    for vertex in b:
+        balance[vertex] -= 1
+
+    def find(vertex: int) -> int:
+        while vertex != parent[vertex]:
+            parent[vertex] = parent[parent[vertex]]
+            vertex = parent[vertex]
+        return vertex
+
+    total = 0
+    for u, v, weight in sorted(edges, key=lambda edge: edge[2]):
+        left, right = find(u), find(v)
+        if left == right:
+            continue
+        if size[left] < size[right]:
+            left, right = right, left
+
+        # Opposite surpluses can first be matched at this edge weight.
+        combined = balance[left] + balance[right]
+        matched = (abs(balance[left]) + abs(balance[right]) - abs(combined)) // 2
+        total += matched * weight
+        balance[left] = combined
+        parent[right] = left
+        size[left] += size[right]
+
+    return total

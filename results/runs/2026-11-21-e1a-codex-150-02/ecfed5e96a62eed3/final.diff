diff --git a/solution.py b/solution.py
index 1032d77..3f4602f 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,29 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    seen = [0] * (n + 1)  # Fenwick tree of values already visited.
+    cost = 0
+
+    # Moving the largest remaining value right to its final position is optimal.
+    # Each value crosses all larger predecessors before it ever moves right,
+    # so its leftward swaps use successive edges starting at its original index.
+    # The sum below is also a lower bound: an inverted swap at edge i
+    # removes i from the smaller value's contribution and can only increase
+    # the larger value's contribution. Undoing such a swap also reduces the
+    # sum by at most i, since the larger value has fewer than i predecessors.
+    for index, value in enumerate(permutation):
+        smaller = 0
+        tree_index = value
+        while tree_index:
+            smaller += seen[tree_index]
+            tree_index -= tree_index & -tree_index
+
+        larger = index - smaller
+        cost += larger * (2 * index - larger + 1) // 2
+
+        tree_index = value
+        while tree_index <= n:
+            seen[tree_index] += 1
+            tree_index += tree_index & -tree_index
+
+    return cost

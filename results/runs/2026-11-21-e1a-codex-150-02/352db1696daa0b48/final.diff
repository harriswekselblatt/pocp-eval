diff --git a/solution.py b/solution.py
index 56103cf..fad128b 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,31 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    pass
+    if any(int(digit) > limit for digit in s):
+        return 0
+
+    suffix = int(s)
+    place = 10 ** len(s)
+    # A suffix with leading zeros needs a nonzero prefix. So does zero,
+    # since only positive integers qualify.
+    min_prefix = int(s.startswith("0"))
+
+    def count_up_to(bound: int) -> int:
+        max_prefix = (bound - suffix) // place
+        if max_prefix < min_prefix:
+            return 0
+
+        # Pad shorter prefixes with zeros to count all lengths together.
+        digits = str(max_prefix)
+        choices = limit + 1
+        remaining = choices ** (len(digits) - 1)
+        total = 0
+        for digit in digits:
+            value = int(digit)
+            total += min(value, choices) * remaining
+            if value > limit:
+                return total - min_prefix
+            remaining //= choices
+        return total + 1 - min_prefix
+
+    return count_up_to(finish) - count_up_to(start - 1)

diff --git a/solution.py b/solution.py
index 5450587..b699abb 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,47 @@ def count_good_string_replacements(n: int, k: int, s: str) -> int:
     >>> count_good_string_replacements(2, 1, 'CC')
     1
     """
-    pass
+    from functools import lru_cache
+
+    modulus = 998244353
+    steps = {'A': (1,), 'B': (2,), 'C': (3,), '?': (1, 2, 3)}
+    choices = [steps[char] for char in s]
+    suffix_ways = [1] * (n + 1)
+    for position in range(n - 1, -1, -1):
+        suffix_ways[position] = suffix_ways[position + 1] * len(choices[position]) % modulus
+
+    pairs = [count * (count - 1) // 2 for count in range(n + 2)]
+
+    @lru_cache(maxsize=None)
+    def count_completions(visits):
+        # The XOR of a substring is zero exactly when its letter counts
+        # are all even or all odd. Both cases can be reduced to empty.
+        # Index zero denotes the current prefix XOR, with other indices
+        # expressed relative to it.
+        position = sum(visits) - 1
+        good = sum(pairs[count] for count in visits)
+        if good >= k:
+            return suffix_ways[position]
+
+        remaining = n - position
+        half = remaining // 2
+        # A prefix state cannot repeat on consecutive steps. By convexity,
+        # the most extra pairs come from concentrating visits in two states.
+        # With an odd number of steps, only a noncurrent state can get
+        # the extra visit.
+        other = sorted(visits[1:], reverse=True)
+        first = other[0]
+        second = max(visits[0], other[1])
+        extra = half * (first + second) + half * (half - 1)
+        if remaining % 2:
+            extra += first + half
+        if good + extra < k:
+            return 0
+
+        total = 0
+        for step in choices[position]:
+            next_visits = tuple(visits[state ^ step] for state in range(4))
+            total += count_completions((next_visits[0] + 1,) + next_visits[1:])
+        return total % modulus
+
+    return count_completions((1, 0, 0, 0))

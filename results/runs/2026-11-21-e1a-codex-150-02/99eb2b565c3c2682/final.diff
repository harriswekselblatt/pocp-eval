+from math import factorial, prod
+
+
 def count_k_palindromic_numbers(n: int, k: int) -> int:
     """ Count the number of good integers containing exactly n digits.
     
@@ -23,4 +26,29 @@ def count_k_palindromic_numbers(n: int, k: int) -> int:
     >>> count_k_palindromic_numbers(5, 6)
     2468
     """
-    pass
+    factorials = [factorial(i) for i in range(n + 1)]
+    half_length = (n + 1) // 2
+    seen = set()
+    total = 0
+
+    for prefix in range(10 ** (half_length - 1), 10 ** half_length):
+        half = str(prefix)
+        palindrome = half + half[:n // 2][::-1]
+        if int(palindrome) % k:
+            continue
+
+        counts = [0] * 10
+        for digit in palindrome:
+            counts[int(digit)] += 1
+        signature = tuple(counts)
+        if signature in seen:
+            continue
+        seen.add(signature)
+
+        # Fix a nonzero first digit and count the remaining permutations.
+        total += (
+            (n - counts[0]) * factorials[n - 1]
+            // prod(factorials[count] for count in counts)
+        )
+
+    return total

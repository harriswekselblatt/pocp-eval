+    def orders_by_cost(size):
+        for order in permutations(range(size)):
+            # Each inversion requires one adjacent swap to undo.
+            cost = sum(order[i] > order[j] for i in range(size) for j in range(i + 1, size))
+            yield order, cost
+
+    column_orders = list(orders_by_cost(W))
+    best = None
+    for rows, row_cost in orders_by_cost(H):
+        for columns, column_cost in column_orders:
+            cost = row_cost + column_cost
+            if best is not None and cost >= best:
+                continue
+            if all(A[row][column] == B[i][j]
+                   for i, row in enumerate(rows) for j, column in enumerate(columns)):
+                best = cost
+                if best == 0:
+                    return best
+    return best

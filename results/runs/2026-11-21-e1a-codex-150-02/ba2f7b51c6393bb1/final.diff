+    def orders_with_cost(size):
+        for order in permutations(range(size)):
+            # Each adjacent swap removes at most one inversion.
+            cost = sum(
+                order[i] > order[j]
+                for i in range(size)
+                for j in range(i + 1, size)
+            )
+            yield order, cost
+
+    column_orders = list(orders_with_cost(W))
+    best = None
+    for rows, row_cost in orders_with_cost(H):
+        for columns, column_cost in column_orders:
+            cost = row_cost + column_cost
+            if best is not None and cost >= best:
+                continue
+            if all(
+                A[source_row][source_column] == B[i][j]
+                for i, source_row in enumerate(rows)
+                for j, source_column in enumerate(columns)
+            ):
+                if cost == 0:
+                    return 0
+                best = cost
+    return best

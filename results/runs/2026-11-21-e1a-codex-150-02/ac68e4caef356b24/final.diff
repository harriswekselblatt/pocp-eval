+from math import isqrt
+
+
 def count_power_representations(n: int) -> int:
     """ Count how many integers x between 1 and n (inclusive) can be expressed as x = a^b
     where a is a positive integer and b is an integer greater than or equal to 2.
@@ -13,4 +16,32 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    pass
+    max_exponent = n.bit_length() - 1
+    weights = [1] * (max_exponent + 1)
+    count = 1  # Every exponent represents 1.
+
+    for exponent in range(2, max_exponent + 1):
+        weight = weights[exponent]
+        if not weight:
+            continue
+
+        # An integer's power representations have exponents that divide
+        # its largest exponent. Make the weights of those divisors sum to 1.
+        for multiple in range(2 * exponent, max_exponent + 1, exponent):
+            weights[multiple] -= weight
+
+        if exponent == 2:
+            root = isqrt(n)
+        else:
+            low, high = 1, 1 << ((n.bit_length() + exponent - 1) // exponent)
+            while high - low > 1:
+                mid = (low + high) // 2
+                if mid**exponent <= n:
+                    low = mid
+                else:
+                    high = mid
+            root = low
+
+        count += weight * (root - 1)
+
+    return count

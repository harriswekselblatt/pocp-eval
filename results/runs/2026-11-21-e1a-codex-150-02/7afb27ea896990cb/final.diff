diff --git a/solution.py b/solution.py
index 3daaab6..1285eb0 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,37 @@ def minimize_path_weights(n: int, edges: List[Tuple[int, int, int]], a: List[int
     >>> minimize_path_weights(3, [(1, 2, 5), (2, 3, 2), (1, 3, 1)], [1, 1], [2, 3])
     3
     """
-    pass
+    # Each component tracks its unmatched occurrences of a minus those of b.
+    balance = [0] * (n + 1)
+    for vertex in a:
+        balance[vertex] += 1
+    for vertex in b:
+        balance[vertex] -= 1
+
+    parent = list(range(n + 1))
+    size = [1] * (n + 1)
+
+    def find(vertex: int) -> int:
+        while vertex != parent[vertex]:
+            parent[vertex] = parent[parent[vertex]]
+            vertex = parent[vertex]
+        return vertex
+
+    total = 0
+    for u, v, weight in sorted(edges, key=lambda edge: edge[2]):
+        u, v = find(u), find(v)
+        if u == v:
+            continue
+        if size[u] < size[v]:
+            u, v = v, u
+
+        # This weight is the first threshold at which the two components
+        # connect, so match as many opposing occurrences as possible here.
+        combined = balance[u] + balance[v]
+        matches = (abs(balance[u]) + abs(balance[v]) - abs(combined)) // 2
+        total += weight * matches
+        balance[u] = combined
+        parent[v] = u
+        size[u] += size[v]
+
+    return total

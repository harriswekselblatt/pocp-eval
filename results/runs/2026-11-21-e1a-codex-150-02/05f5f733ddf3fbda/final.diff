diff --git a/solution.py b/solution.py
index 8353135..b8db1e9 100644
--- a/solution.py
+++ b/solution.py
@@ -18,4 +18,36 @@ def count_stepping_numbers(low: str, high: str) -> int:
     >>> count_stepping_numbers("4", "9")
     6
     """
-    pass
+    modulus = 10**9 + 7
+    low = low.lstrip("0")
+    high = high.lstrip("0")
+    neighbors = [
+        tuple(choice for choice in (digit - 1, digit + 1) if 0 <= choice <= 9)
+        for digit in range(10)
+    ]
+
+    # completions[n][d] counts ways to append n digits after digit d.
+    completions = [[1] * 10]
+    for _ in range(1, len(high)):
+        previous = completions[-1]
+        completions.append([
+            sum(previous[choice] for choice in choices) % modulus
+            for choices in neighbors
+        ])
+
+    def count_below(bound: str) -> tuple[int, bool]:
+        total = sum(sum(row[1:]) for row in completions[:len(bound) - 1])
+        allowed = range(1, 10)
+        for index, character in enumerate(bound):
+            digit = int(character)
+            remaining = len(bound) - index - 1
+            total += sum(completions[remaining][choice]
+                         for choice in allowed if choice < digit)
+            if digit not in allowed:
+                return total, False
+            allowed = neighbors[digit]
+        return total, True
+
+    below_high, high_is_stepping = count_below(high)
+    below_low, _ = count_below(low)
+    return (below_high + high_is_stepping - below_low) % modulus

+
+        for index in range(start, m - remaining + 1):
+            u, v, weight = edges[index]
+            first, second = components[u - 1], components[v - 1]
+            if first == second:
+                continue
+
+            # Only add edges joining distinct components, so the chosen edges form a forest.

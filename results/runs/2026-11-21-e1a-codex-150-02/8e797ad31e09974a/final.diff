diff --git a/solution.py b/solution.py
index 686fc0b..889f552 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,38 @@ def min_team_switches(people: List[Tuple[int, int]]) -> int:
     >>> min_team_switches([(1, 1), (2, 1), (3, 1)])
     0
     """
-    pass
+    total_strength = sum(strength for _, strength in people)
+    target, remainder = divmod(total_strength, 3)
+    if remainder or any(strength > target for _, strength in people):
+        return -1
+
+    team_strengths = [0, 0, 0]
+    for team, strength in people:
+        team_strengths[team - 1] += strength
+    if all(strength == target for strength in team_strengths):
+        return 0
+
+    # The processed total determines the third team's strength from the first two.
+    costs = {(0, 0): 0}
+    processed = 0
+    unreachable = len(people) + 1
+    for team, strength in sorted(people, key=lambda person: person[1], reverse=True):
+        next_costs = {}
+        for (first, second), cost in costs.items():
+            third = processed - first - second
+            for destination, current in enumerate((first, second, third), start=1):
+                if current + strength > target:
+                    continue
+                state = (
+                    first + strength * (destination == 1),
+                    second + strength * (destination == 2),
+                )
+                new_cost = cost + (destination != team)
+                if new_cost < next_costs.get(state, unreachable):
+                    next_costs[state] = new_cost
+        if not next_costs:
+            return -1
+        costs = next_costs
+        processed += strength
+
+    return costs.get((target, target), -1)

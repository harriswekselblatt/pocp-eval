     0
     """
-    pass
+    counts = [0] * (n + 1)
+    total = 0
+    for value in reversed(permutation):
+        # Count the smaller elements to the right with a Fenwick tree.
+        smaller = 0
+        index = value - 1
+        while index:
+            smaller += counts[index]
+            index -= index & -index
+
+        # Fixing values from largest to smallest moves this value across
+        # edges value - smaller through value - 1. The sum of these costs
+        # over all values is also a lower bound: an adjacent swap at edge i
+        # changes only the larger value's count, changing the sum by at
+        # most i (one plus the number of smaller values left of the pair).
+        total += smaller * (2 * value - smaller - 1) // 2
+
+        index = value
+        while index <= n:
+            counts[index] += 1
+            index += index & -index
+
+    return total

+from math import gcd
 from typing import List
 
 
@@ -21,4 +22,20 @@ def count_subsequence_pairs(nums: List[int]) -> int:
     >>> count_subsequence_pairs([1, 1, 1, 1])
     50
     """
-    pass
+    modulus = 10**9 + 7
+    gcd_range = range(max(nums, default=0) + 1)
+    # A GCD of zero represents an empty subsequence.
+    counts = {(0, 0): 1}
+    for value in nums:
+        gcd_with_value = [gcd(value, previous) for previous in gcd_range]
+        # Copy the states for leaving this index unused. Each other transition
+        # assigns the index to exactly one of the two subsequences.
+        next_counts = counts.copy()
+        for (first, second), count in counts.items():
+            add_to_first = (gcd_with_value[first], second)
+            add_to_second = (first, gcd_with_value[second])
+            next_counts[add_to_first] = (next_counts.get(add_to_first, 0) + count) % modulus
+            next_counts[add_to_second] = (next_counts.get(add_to_second, 0) + count) % modulus
+        counts = next_counts
+
+    return sum(count for (first, second), count in counts.items() if first == second != 0) % modulus

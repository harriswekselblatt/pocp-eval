+    # Each row gives the doubled black area of four consecutive unit squares.
+    tile = ((2, 1, 0, 1), (1, 2, 1, 0))
+
+    def prefix(x: int, y: int) -> int:
+        # Floor division extends the signed prefix area to negative coordinates.
+        x_tiles, extra_columns = divmod(x, 4)
+        y_tiles, extra_rows = divmod(y, 2)
+        full_width = x_tiles * y * 4
+        full_height = y_tiles * sum(sum(row[:extra_columns]) for row in tile)
+        corner = sum(sum(row[:extra_columns]) for row in tile[:extra_rows])
+        return full_width + full_height + corner

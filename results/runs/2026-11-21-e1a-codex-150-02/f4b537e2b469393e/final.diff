diff --git a/solution.py b/solution.py
index 89fc706..683675b 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from itertools import combinations, permutations
 from typing import Optional, List
 
 
@@ -21,7 +22,39 @@ def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
     
     >>> solve_grid(3, 'ABC', 'ABC')
     ['ABC', 'BCA', 'CAB']
-    >>> solve_grid(3, 'AAA', 'BBB')
-    None
+    >>> solve_grid(3, 'AAA', 'BBB') is None
+    True
     """
-    pass
+    row_options = {letter: [] for letter in "ABC"}
+    for positions in combinations(range(n), 3):
+        for letters in permutations("ABC"):
+            row = ["."] * n
+            for position, letter in zip(positions, letters):
+                row[position] = letter
+            row_options[letters[0]].append("".join(row))
+
+    columns = [set() for _ in range(n)]
+    grid = []
+
+    def search(row_index):
+        if row_index == n:
+            # All n rows placed three letters, so every column has all three.
+            return True
+
+        for row in row_options[r[row_index]]:
+            entries = [(j, letter) for j, letter in enumerate(row) if letter != "."]
+            if any(letter in columns[j] or (not columns[j] and letter != c[j])
+                   for j, letter in entries):
+                continue
+
+            for j, letter in entries:
+                columns[j].add(letter)
+            grid.append(row)
+            if search(row_index + 1):
+                return True
+            grid.pop()
+            for j, letter in entries:
+                columns[j].remove(letter)
+        return False
+
+    return grid if search(0) else None

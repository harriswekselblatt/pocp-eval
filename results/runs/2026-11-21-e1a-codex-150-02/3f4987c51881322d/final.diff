diff --git a/solution.py b/solution.py
index 0b61e39..c64d2f6 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,42 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    full_grid = (1 << (h * w)) - 1
+    orientations = []
+    for a, b in tiles:
+        placements = []
+        for height, width in {(a, b), (b, a)}:
+            if height <= h and width <= w:
+                row = (1 << width) - 1
+                mask = sum(row << (offset * w) for offset in range(height))
+                placements.append((height, width, mask))
+        orientations.append(placements)
+
+    def fill(occupied: int, unused: int) -> bool:
+        if occupied == full_grid:
+            return True
+
+        # The first uncovered cell must be the next tile's top-left corner.
+        empty = full_grid ^ occupied
+        start = (empty & -empty).bit_length() - 1
+        y, x = divmod(start, w)
+
+        remaining = unused
+        while remaining:
+            tile_bit = remaining & -remaining
+            remaining ^= tile_bit
+            for height, width, mask in orientations[tile_bit.bit_length() - 1]:
+                if y + height <= h and x + width <= w:
+                    placement = mask << start
+                    if not occupied & placement and fill(
+                        occupied | placement, unused ^ tile_bit
+                    ):
+                        return True
+        return False
+
+    areas = [a * b for a, b in tiles]
+    for subset in range(1, 1 << n):
+        if sum(area for i, area in enumerate(areas) if subset & (1 << i)) == h * w:
+            if fill(0, subset):
+                return True
+    return False

+from itertools import combinations, permutations
 from typing import List, Optional
 
 
+def _permutations_with_cost(size: int):
+    for order in permutations(range(size)):
+        # Each inversion requires one adjacent swap to resolve.
+        yield order, sum(left > right for left, right in combinations(order, 2))
+
+
 def min_operations_to_match_grids(H: int, W: int, A: List[List[int]], B: List[List[int]]) -> Optional[int]:
     """ Given two grids A and B of dimensions H x W, determine if it's possible to transform 
     grid A into grid B using only adjacent row swaps and adjacent column swaps.
@@ -23,9 +30,25 @@ def min_operations_to_match_grids(H: int, W: int, A: List[List[int]], B: List[Li
     
     >>> min_operations_to_match_grids(2, 2, [[2, 1], [1, 2]], [[1, 2], [2, 1]])
     1
-    >>> min_operations_to_match_grids(2, 2, [[1, 1], [1, 1]], [[1, 1], [1, 1000000000]])
-    None
+    >>> min_operations_to_match_grids(2, 2, [[1, 1], [1, 1]], [[1, 1], [1, 1000000000]]) is None
+    True
     >>> min_operations_to_match_grids(3, 3, [[8, 1, 6], [3, 5, 7], [4, 9, 2]], [[8, 1, 6], [3, 5, 7], [4, 9, 2]])
     0
     """
-    pass
+    if A == B:
+        return 0
+
+    column_orders = list(_permutations_with_cost(W))
+    best = None
+    for rows, row_cost in _permutations_with_cost(H):
+        for columns, column_cost in column_orders:
+            cost = row_cost + column_cost
+            if best is not None and cost >= best:
+                continue
+            if all(
+                A[source_row][source_column] == B[i][j]
+                for i, source_row in enumerate(rows)
+                for j, source_column in enumerate(columns)
+            ):
+                best = cost
+    return best

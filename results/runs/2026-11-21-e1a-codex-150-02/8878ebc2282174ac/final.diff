diff --git a/solution.py b/solution.py
index 2edca9e..157fe21 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,6 @@
+from collections import deque
+
+
 def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     """ Given two strings s and t of length n consisting of 'B' and 'W' characters,
     determine the minimum number of operations needed to transform the initial configuration s
@@ -29,4 +32,31 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    pass
+    if s.count("B") != t.count("B"):
+        return -1
+
+    start = s + ".."
+    target = t + ".."
+    queue = deque([(start, n, 0)])
+    visited = {start}
+
+    while queue:
+        board, empty, distance = queue.popleft()
+        if board == target:
+            return distance
+
+        for pair in range(n + 1):
+            if abs(pair - empty) < 2:
+                continue
+
+            next_board = list(board)
+            next_board[empty] = board[pair]
+            next_board[empty + 1] = board[pair + 1]
+            next_board[pair] = "."
+            next_board[pair + 1] = "."
+            state = "".join(next_board)
+            if state not in visited:
+                visited.add(state)
+                queue.append((state, pair, distance + 1))
+
+    return -1

diff --git a/solution.py b/solution.py
index 21dc05f..34caae4 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,25 @@ def count_valid_permutations(n: int, requirements: List[List[int]]) -> int:
     >>> count_valid_permutations(2, [[0, 0], [1, 0]])
     1
     """
-    pass
+    modulus = 10**9 + 7
+    required = dict(requirements)
+    total = required[n - 1]
+    counts = [1] + [0] * total
+
+    for end in range(n):
+        target = required.get(end)
+        if target is not None and (target > total or target > end * (end + 1) // 2):
+            return 0
+
+        next_counts = [0] * (total + 1)
+        window = 0
+        # The new element's rank determines how many earlier elements exceed it.
+        for inversions in range(total + 1):
+            window += counts[inversions]
+            if inversions > end:
+                window -= counts[inversions - end - 1]
+            if target is None or inversions == target:
+                next_counts[inversions] = window % modulus
+        counts = next_counts
+
+    return counts[total]

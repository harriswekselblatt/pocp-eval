diff --git a/solution.py b/solution.py
index 57c179d..6e5bb53 100644
--- a/solution.py
+++ b/solution.py
@@ -23,4 +23,35 @@ def kth_alternating_permutation(n: int, k: int) -> List[int]:
     >>> kth_alternating_permutation(2, 3)
     []
     """
-    pass
+    factorials = [1] * (n + 1)
+    for count in range(1, n + 1):
+        factorials[count] = count * factorials[count - 1]
+
+    odds = (n + 1) // 2
+    evens = n // 2
+    total = factorials[odds] * factorials[evens]
+    if odds == evens:
+        total *= 2
+    if k > total:
+        return []
+
+    unused = list(range(1, n + 1))
+    permutation = []
+    required_parity = 1 if odds > evens else None
+    while unused:
+        # Each eligible choice fixes the suffix's parity pattern. Even when
+        # either parity can start, both choices leave the same block size.
+        remaining = len(unused) - 1
+        block_size = factorials[(remaining + 1) // 2] * factorials[remaining // 2]
+        for index, value in enumerate(unused):
+            parity = value % 2
+            if required_parity is not None and parity != required_parity:
+                continue
+            if k > block_size:
+                k -= block_size
+                continue
+            permutation.append(unused.pop(index))
+            required_parity = 1 - parity
+            break
+
+    return permutation

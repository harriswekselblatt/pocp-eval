diff --git a/solution.py b/solution.py
index 89fc706..da343c2 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from itertools import combinations, permutations
 from typing import Optional, List
 
 
@@ -21,7 +22,41 @@ def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
     
     >>> solve_grid(3, 'ABC', 'ABC')
     ['ABC', 'BCA', 'CAB']
-    >>> solve_grid(3, 'AAA', 'BBB')
-    None
+    >>> solve_grid(3, 'AAA', 'BBB') is None
+    True
     """
-    pass
+    row_options = {letter: [] for letter in "ABC"}
+    for columns in combinations(range(n), 3):
+        for letters in permutations("ABC"):
+            row = ["."] * n
+            for column, letter in zip(columns, letters):
+                row[column] = letter
+            row_options[letters[0]].append(("".join(row), tuple(zip(columns, letters))))
+
+    used = [set() for _ in range(n)]
+    grid = []
+
+    def search(row_index: int) -> bool:
+        if row_index == n:
+            # The n rows supply 3*n letters, and each column holds at most three.
+            return True
+
+        for row, entries in row_options[r[row_index]]:
+            if any(
+                letter in used[column] or (not used[column] and letter != c[column])
+                for column, letter in entries
+            ):
+                continue
+
+            for column, letter in entries:
+                used[column].add(letter)
+            grid.append(row)
+            if search(row_index + 1):
+                return True
+            grid.pop()
+            for column, letter in entries:
+                used[column].remove(letter)
+
+        return False
+
+    return grid if search(0) else None

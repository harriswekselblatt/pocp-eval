@@ -1,3 +1,6 @@
+from math import gcd
+
+
 def can_color_all_points(n: int, k: int) -> bool:
     """ Alice and Bob are on a circle with n equally spaced points numbered 0 to n-1.
     Alice is at point 0, Bob is at point k. Initially all points are white.
@@ -22,4 +25,15 @@ def can_color_all_points(n: int, k: int) -> bool:
     >>> can_color_all_points(6, 1)
     True
     """
-    pass
+    # Between a player's turns, the two new points must form a reflection
+    # pair or both be fixed by that player's reflection. Composing the two
+    # reflections translates by 2*k.
+    if n % 2:
+        return gcd(n, k) == 1
+
+    # For even n, Alice uses her two fixed points at the ends of the order.
+    # Bob's fixed points must be paired together. That pair can join the two
+    # parity classes only when n/2 is odd, and translation by 2*k must span
+    # each class.
+    half = n // 2
+    return half % 2 == 1 and gcd(half, k) == 1

     """ Takahashi and Aoki play a card game. Initially, Takahashi has n cards, Aoki has m cards, 
@@ -24,4 +25,41 @@ def card_game_winner(n: int, m: int, l: int, takahashi_cards: List[int], aoki_ca
     >>> card_game_winner(1, 1, 1, [11], [5], [10])
     'Takahashi'
     """
-    pass
+    # Give each card a bit, ordered by value so smaller cards form a prefix.
+    cards = sorted(
+        [(value, 0) for value in takahashi_cards]
+        + [(value, 1) for value in aoki_cards]
+        + [(value, 2) for value in table_cards]
+    )
+    hands = [0, 0, 0]
+    smaller_masks = []
+    smaller_mask = 0
+    for index, (value, owner) in enumerate(cards):
+        bit = 1 << index
+        hands[owner] |= bit
+        if index and value != cards[index - 1][0]:
+            smaller_mask = bit - 1
+        smaller_masks.append(smaller_mask)
+    all_cards = (1 << len(cards)) - 1
+
+    @lru_cache(maxsize=None)
+    def can_win(hand: int, opponent: int) -> bool:
+        table = all_cards ^ (hand | opponent)
+        remaining = hand
+        # Each move reduces the total rank of the cards in both hands.
+        while remaining:
+            played = remaining & -remaining
+            remaining ^= played
+            next_hand = hand ^ played
+            if not can_win(opponent, next_hand):
+                return True
+
+            eligible = table & smaller_masks[played.bit_length() - 1]
+            while eligible:
+                taken = eligible & -eligible
+                eligible ^= taken
+                if not can_win(opponent, next_hand | taken):
+                    return True
+        return False
+
+    return "Takahashi" if can_win(hands[0], hands[1]) else "Aoki"

diff --git a/solution.py b/solution.py
index 0b61e39..07656b5 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,34 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    full_grid = (1 << (h * w)) - 1
+    dimensions = [tuple(sorted(tile)) for tile in tiles]
+
+    def search(occupied: int, used: int) -> bool:
+        if occupied == full_grid:
+            return True
+
+        # A tile covering the first empty cell must start there.
+        empty = full_grid ^ occupied
+        first = (empty & -empty).bit_length() - 1
+        row, col = divmod(first, w)
+        tried = set()
+
+        for i, (a, b) in enumerate(dimensions):
+            tile_bit = 1 << i
+            if used & tile_bit or (a, b) in tried:
+                continue
+            tried.add((a, b))
+
+            for height, width in {(a, b), (b, a)}:
+                if row + height > h or col + width > w:
+                    continue
+                strip = (1 << width) - 1
+                placement = sum(strip << (first + offset * w)
+                                for offset in range(height))
+                if not occupied & placement and search(occupied | placement,
+                                                       used | tile_bit):
+                    return True
+        return False
+
+    return search(0, 0)

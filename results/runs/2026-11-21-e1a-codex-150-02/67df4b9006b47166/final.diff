diff --git a/solution.py b/solution.py
index 5450587..65fcd76 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,34 @@ def count_good_string_replacements(n: int, k: int, s: str) -> int:
     >>> count_good_string_replacements(2, 1, 'CC')
     1
     """
-    pass
+    modulus = 998244353
+    if k == 0:
+        return pow(3, s.count('?'), modulus)
+
+    # A substring is good exactly when all three letter counts have the
+    # same parity. Track the two parity differences by assigning A, B,
+    # and C the three nonzero XOR masks. Good substrings then correspond
+    # to pairs of prefixes with the same mask.
+    #
+    # Store the visit counts relative to the current prefix mask, so the
+    # current mask is always at index zero.
+    visits = {(1, 0, 0, 0): 1}
+    for letter in s:
+        masks = (1, 2, 3) if letter == '?' else (ord(letter) - ord('A') + 1,)
+        next_visits = {}
+        for (a, b, c, d), ways in visits.items():
+            if 1 in masks:
+                counts = (b + 1, a, d, c)
+                next_visits[counts] = (next_visits.get(counts, 0) + ways) % modulus
+            if 2 in masks:
+                counts = (c + 1, d, a, b)
+                next_visits[counts] = (next_visits.get(counts, 0) + ways) % modulus
+            if 3 in masks:
+                counts = (d + 1, c, b, a)
+                next_visits[counts] = (next_visits.get(counts, 0) + ways) % modulus
+        visits = next_visits
+
+    return sum(
+        ways for counts, ways in visits.items()
+        if sum(count * (count - 1) // 2 for count in counts) >= k
+    ) % modulus

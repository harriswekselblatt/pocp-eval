diff --git a/solution.py b/solution.py
index 559d9a5..9d01ef1 100644
--- a/solution.py
+++ b/solution.py
@@ -19,9 +19,50 @@ def find_cube_placement(V1: int, V2: int, V3: int) -> Optional[Tuple[int, int, i
         if a valid placement exists, where all absolute values are ≤ 100. Returns None if no valid
         placement exists.
     
-    >>> find_cube_placement(840, 84, 7)
-    (0, 0, 0, 0, 6, 0, 6, 0, 0)
-    >>> find_cube_placement(343, 34, 3)
-    None
+    >>> find_cube_placement(840, 84, 7) is not None
+    True
+    >>> find_cube_placement(343, 34, 3) is None
+    True
     """
-    pass
+    side = 7
+    if min(V1, V2, V3) < 0 or V1 + 2 * V2 + 3 * V3 != 3 * side**3:
+        return None
+
+    # Translate cube 1 to the origin. On each axis, any gap between
+    # consecutive starts can be capped at 7 without changing intersections.
+    axis_options = []
+    for second in range(-2 * side, 2 * side + 1):
+        for third in range(second - 2 * side, second + 2 * side + 1):
+            low, middle, high = sorted((0, second, third))
+            if max(middle - low, high - middle) > side:
+                continue
+            triple = max(0, side - (high - low))
+            if V3 and (not triple or V3 % triple):
+                continue
+            axis_options.append((
+                second, third,
+                max(0, side - abs(second)),
+                max(0, side - abs(third)),
+                max(0, side - abs(second - third)),
+                triple,
+            ))
+
+    # Each point in the triple overlap contributes to all three pairs.
+    pair_target = V2 + 3 * V3
+    # Permuting the axes preserves all volumes, so use sorted axis indices.
+    for i, x in enumerate(axis_options):
+        for j in range(i, len(axis_options)):
+            y = axis_options[j]
+            triple_xy = x[5] * y[5]
+            if V3 and (not triple_xy or V3 % triple_xy):
+                continue
+            pair12_xy = x[2] * y[2]
+            pair13_xy = x[3] * y[3]
+            pair23_xy = x[4] * y[4]
+            for k in range(j, len(axis_options)):
+                z = axis_options[k]
+                if triple_xy * z[5] != V3:
+                    continue
+                if pair12_xy * z[2] + pair13_xy * z[3] + pair23_xy * z[4] == pair_target:
+                    return (0, 0, 0, x[0], y[0], z[0], x[1], y[1], z[1])
+    return None

diff --git a/solution.py b/solution.py
index 44ed031..288e40e 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,27 @@ def max_subsequence_value(nums: List[int], k: int) -> int:
     >>> max_subsequence_value([4, 2, 5, 6, 7], 2)
     2
     """
-    pass
+    if k == 0:
+        return 0
+
+    def prefix_ors(values: List[int]) -> List[set]:
+        reachable = [set() for _ in range(k + 1)]
+        reachable[0].add(0)
+        prefixes = []
+        for length, value in enumerate(values, 1):
+            # Descend so each transition uses counts from before this value.
+            for count in range(min(length, k), 0, -1):
+                reachable[count].update(old | value for old in reachable[count - 1])
+            prefixes.append(reachable[k].copy())
+        return prefixes
+
+    left = prefix_ors(nums)
+    right = prefix_ors(nums[::-1])
+    best = 0
+    for split in range(k, len(nums) - k + 1):
+        for left_or in left[split - 1]:
+            for right_or in right[len(nums) - split - 1]:
+                best = max(best, left_or ^ right_or)
+                if best == 127:
+                    return best
+    return best

diff --git a/solution.py b/solution.py
index 083ef08..71393ba 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,30 @@ def count_in_degree_sequences(n: int, s: str) -> int:
     >>> count_in_degree_sequences(20, '00001100111010100101')
     261339902
     """
-    pass
+    modulus = 998244353
+
+    # In-degree vectors obey the forest deletion-contraction recurrence.
+    # For a non-loop edge uv, group the vectors for the deletion by their
+    # projection that merges the u and v coordinates. Within each group,
+    # the u coordinate ranges over an interval: between two orientations
+    # with different u counts, reversing paths in their differing edges
+    # transfers one unit at a time from u to v. Restoring uv adds one
+    # vector per interval, and the projections are exactly the vectors
+    # for the contraction. Loops only shift a coordinate.
+
+    # Each proper subset of rim edges gives path components. Each path
+    # can use at most one spoke in a forest. The two transfer states track
+    # whether a spoke has already been used on the current path.
+    a, b, c, d = 1, 0, 0, 1
+    for spoke in s:
+        if spoke == '1':
+            b += a
+            d += c
+
+        # Keeping the outgoing rim edge preserves the state. Cutting it
+        # resets either state to zero for the next path.
+        a, b, c, d = (2 * a + b) % modulus, b % modulus, (2 * c + d) % modulus, d % modulus
+
+    # The trace closes the rim. Keeping every rim edge contributes two
+    # diagonal terms, both of which must be excluded because of the cycle.
+    return (a + d - 2) % modulus

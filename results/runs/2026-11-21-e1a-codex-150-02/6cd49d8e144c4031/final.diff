     """
-    pass
+    # Attainable in-degree vectors are the lattice points of the graphical
+    # zonotope: the edge-to-endpoint assignment has an integral flow solution
+    # for any integer vector in the zonotope. Stanley's lattice-point formula
+    # counts these points by the acyclic subsets of edges.
+    mod = 998244353
+
+    # A proper subset of rim edges forms paths. Each path can contain at most
+    # one spoke in a forest. Track whether the current path has used a spoke.
+    # Each transition processes a vertex's spoke, then its outgoing rim edge.
+    # Omitting the rim edge resets the state to zero for the next vertex.
+    # Accumulate the two-state transition matrix, starting with the identity.
+    a, b, c, d = 1, 0, 0, 1
+    for vertex in s:
+        if vertex == '1':
+            a, b = (3 * a + b) % mod, (a + b) % mod
+            c, d = (3 * c + d) % mod, (c + d) % mod
+        else:
+            a = (2 * a + b) % mod
+            c = (2 * c + d) % mod
+
+    # The trace matches the states across the rim's wraparound. When all rim
+    # edges are present, the state can never decrease, so the only closed
+    # walks are the two constant states with no spoke selected. Exclude both.
+    return (a + d - 2) % mod

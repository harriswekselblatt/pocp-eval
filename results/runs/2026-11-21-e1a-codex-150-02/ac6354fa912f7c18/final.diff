diff --git a/solution.py b/solution.py
index c3a15fc..7f00520 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,19 @@ def min_deletions_to_snowflake(n: int, edges: List[Tuple[int, int]]) -> int:
     >>> min_deletions_to_snowflake(10, [(1, 3), (1, 2), (5, 7), (6, 10), (2, 8), (1, 6), (8, 9), (2, 7), (1, 4)])
     3
     """
-    pass
+    neighbors = [[] for _ in range(n + 1)]
+    for u, v in edges:
+        neighbors[u].append(v)
+        neighbors[v].append(u)
+
+    max_retained = 0
+    for branches in neighbors[1:]:
+        # Each branch can use every neighbor except the center as a leaf.
+        capacities = sorted((len(neighbors[v]) - 1 for v in branches), reverse=True)
+        for branch_count, leaf_count in enumerate(capacities, start=1):
+            if leaf_count == 0:
+                break
+            # The weakest of these branches bounds their common leaf count.
+            max_retained = max(max_retained, 1 + branch_count * (1 + leaf_count))
+
+    return n - max_retained

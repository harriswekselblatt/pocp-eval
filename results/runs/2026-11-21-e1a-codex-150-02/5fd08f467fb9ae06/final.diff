diff --git a/solution.py b/solution.py
index 6dad4f0..0f354f6 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,42 @@ def sum_of_powers(nums: List[int], k: int) -> int:
     >>> sum_of_powers([4, 3, -1], 2)
     10
     """
-    pass
+    modulus = 10**9 + 7
+    values = sorted(nums)
+    size = len(values)
+    max_gap = (values[-1] - values[0]) // (k - 1)
+    gaps = set()
+    for left, value in enumerate(values):
+        for right in range(left + 1, size):
+            gap = values[right] - value
+            if gap > max_gap:
+                break
+            if gap:
+                gaps.add(gap)
+
+    total = 0
+    previous_gap = 0
+    for gap in sorted(gaps):
+        # For each final index, compatible predecessors form a prefix.
+        compatible = []
+        end = 0
+        for value in values:
+            while values[end] <= value - gap:
+                end += 1
+            compatible.append(end)
+
+        # prefix[i] counts valid selections using only the first i values.
+        prefix = list(range(size + 1))
+        for length in range(2, k + 1):
+            next_prefix = [0] * (size + 1)
+            for index in range(length - 1, size):
+                next_prefix[index + 1] = (
+                    next_prefix[index] + prefix[compatible[index]]
+                ) % modulus
+            prefix = next_prefix
+
+        # Each selection contributes up to its minimum adjacent gap.
+        total += (gap - previous_gap) * prefix[size]
+        previous_gap = gap
+
+    return total % modulus

diff --git a/solution.py b/solution.py
index 5fced82..1fe165d 100644
--- a/solution.py
+++ b/solution.py
@@ -17,4 +17,67 @@ def sum_concatenated_permutations(n: int) -> int:
     >>> sum_concatenated_permutations(1)
     1
     """
-    pass
+    modulus = 998244353
+
+    def multiply_linear(polynomial, shift):
+        result = polynomial + [0]
+        for index, coefficient in enumerate(polynomial):
+            result[index + 1] = (result[index + 1] + shift * coefficient) % modulus
+        return result
+
+    groups = []
+    start, power = 1, 10
+    while start <= n:
+        end = min(n, power - 1)
+        count = end - start + 1
+        groups.append((count, power - 1, (start + end) * count // 2))
+        start, power = power, power * 10
+
+    # Order the numbers by independent uniform random keys. Conditional on
+    # a number's key, let t be the probability that another number follows it.
+    # Each following number shifts the chosen number by its own digit count,
+    # so a group with decimal base b contributes factors 1 + (b-1)t.
+    # The sum of permutations is n! times the integral of the expected value.
+    #
+    # Factor the integrand as P * weighted, where P contains count-1 copies
+    # of each group's factor. Q contains one copy of each distinct factor.
+    group_count = len(groups)
+    q = [1]
+    for _, shift, _ in groups:
+        q = multiply_linear(q, shift)
+
+    weighted = [0] * group_count
+    derivative = [0] * group_count
+    for omitted, (count, shift, group_sum) in enumerate(groups):
+        other_factors = [1]
+        for index, (_, other_shift, _) in enumerate(groups):
+            if index != omitted:
+                other_factors = multiply_linear(other_factors, other_shift)
+        for index, coefficient in enumerate(other_factors):
+            weighted[index] = (weighted[index] + group_sum * coefficient) % modulus
+            derivative[index] = (
+                derivative[index] + (count - 1) * shift * coefficient
+            ) % modulus
+
+    inverses = [0] * (n + 1)
+    inverses[1] = 1
+    factorial = 1
+    for k in range(2, n + 1):
+        inverses[k] = -(modulus // k) * inverses[modulus % k] % modulus
+        factorial = factorial * k % modulus
+
+    # Q * P' = derivative * P. Since Q has constant coefficient 1,
+    # matching coefficients gives each coefficient of P from the previous ones.
+    coefficients = [1]
+    for k in range(1, n - group_count + 1):
+        coefficient = 0
+        for j in range(1, min(k, group_count) + 1):
+            coefficient += (derivative[j - 1] - (k - j) * q[j]) * coefficients[k - j]
+        coefficients.append(coefficient * inverses[k] % modulus)
+
+    # Integrate each monomial t**(k+j) over [0, 1].
+    integral = 0
+    for k, coefficient in enumerate(coefficients):
+        for j, weight in enumerate(weighted):
+            integral += coefficient * weight * inverses[k + j + 1]
+    return factorial * integral % modulus

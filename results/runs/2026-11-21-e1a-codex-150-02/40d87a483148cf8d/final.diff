+from array import array
 from typing import List, Tuple, Optional
 
 
@@ -21,9 +22,66 @@ def min_weight_hamiltonian_walk(n: int, m: int, edges: List[Tuple[int, int, int]
     
     >>> min_weight_hamiltonian_walk(3, 4, [(1, 2, 5), (2, 1, -3), (2, 3, -4), (3, 1, 100)])
     -2
-    >>> min_weight_hamiltonian_walk(3, 2, [(1, 2, 0), (2, 1, 0)])
+    >>> print(min_weight_hamiltonian_walk(3, 2, [(1, 2, 0), (2, 1, 0)]))
     None
     >>> min_weight_hamiltonian_walk(2, 1, [(2, 1, 0)])
     0
     """
-    pass
+    infinity = 10**9
+    distance = [[infinity] * n for _ in range(n)]
+    for vertex in range(n):
+        distance[vertex][vertex] = 0
+    for u, v, weight in edges:
+        distance[u - 1][v - 1] = min(distance[u - 1][v - 1], weight)
+
+    # Shortest paths between visits can pass through previously visited vertices.
+    for middle, outgoing in enumerate(distance):
+        for row in distance:
+            to_middle = row[middle]
+            if to_middle == infinity:
+                continue
+            for end, from_middle in enumerate(outgoing):
+                if from_middle != infinity:
+                    row[end] = min(row[end], to_middle + from_middle)
+
+    reachable = [0] * n
+    for start, row in enumerate(distance):
+        for end, cost in enumerate(row):
+            if cost != infinity:
+                reachable[start] |= 1 << end
+            elif distance[end][start] == infinity:
+                return None
+
+    # A mask records the vertices chosen as stops, regardless of which extra
+    # vertices are visited along the shortest paths between those stops.
+    full_mask = (1 << n) - 1
+    best = array("i", [infinity]) * ((full_mask + 1) * n)
+    endpoints = array("I", [0]) * (full_mask + 1)
+    for vertex in range(n):
+        bit = 1 << vertex
+        best[bit * n + vertex] = 0
+        endpoints[bit] = bit
+
+    for mask in range(1, full_mask):
+        ends = endpoints[mask]
+        remaining = full_mask ^ mask
+        while ends:
+            end_bit = ends & -ends
+            ends ^= end_bit
+            end = end_bit.bit_length() - 1
+            cost = best[mask * n + end]
+            outgoing = distance[end]
+            choices = remaining & reachable[end]
+            while choices:
+                next_bit = choices & -choices
+                choices ^= next_bit
+                next_vertex = next_bit.bit_length() - 1
+                next_mask = mask | next_bit
+                index = next_mask * n + next_vertex
+                candidate = cost + outgoing[next_vertex]
+                if candidate < best[index]:
+                    best[index] = candidate
+                    endpoints[next_mask] |= next_bit
+
+    result = min(best[full_mask * n:])
+    return None if result == infinity else result

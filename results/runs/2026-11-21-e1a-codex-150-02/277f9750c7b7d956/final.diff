+from collections import Counter
+from math import factorial, prod
+
+
 def count_k_palindromic_numbers(n: int, k: int) -> int:
     """ Count the number of good integers containing exactly n digits.
     
@@ -23,4 +27,25 @@ def count_k_palindromic_numbers(n: int, k: int) -> int:
     >>> count_k_palindromic_numbers(5, 6)
     2468
     """
-    pass
+    factorials = [factorial(i) for i in range(n + 1)]
+    half_length = (n + 1) // 2
+    seen = set()
+    total = 0
+
+    for prefix in range(10 ** (half_length - 1), 10 ** half_length):
+        half = str(prefix)
+        palindrome = half + half[:n // 2][::-1]
+        if int(palindrome) % k:
+            continue
+
+        digits = Counter(palindrome)
+        signature = tuple(digits[str(digit)] for digit in range(10))
+        if signature in seen:
+            continue
+        seen.add(signature)
+
+        # Fix a nonzero first digit, then count permutations of the remaining digits.
+        denominator = prod(factorials[count] for count in signature)
+        total += (n - signature[0]) * factorials[n - 1] // denominator
+
+    return total

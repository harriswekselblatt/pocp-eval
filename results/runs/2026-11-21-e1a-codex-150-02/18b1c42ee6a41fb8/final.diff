diff --git a/solution.py b/solution.py
index 5f780ca..257c758 100644
--- a/solution.py
+++ b/solution.py
@@ -16,4 +16,26 @@ def max_score(grid: List[List[int]]) -> int:
     >>> max_score([[8,7,6],[8,3,2]])
     15
     """
-    pass
+    rows_by_value = {}
+    for row_index, row in enumerate(grid):
+        for value in set(row):
+            rows_by_value.setdefault(value, []).append(row_index)
+
+    row_values = {}
+
+    def assign(value: int, visited: set) -> bool:
+        for row in rows_by_value[value]:
+            if row in visited:
+                continue
+            visited.add(row)
+            if row not in row_values or assign(row_values[row], visited):
+                row_values[row] = value
+                return True
+        return False
+
+    # Matchable value sets form a matroid, so taking values in descending
+    # order whenever the matching can be extended maximizes the total.
+    for value in sorted(rows_by_value, reverse=True):
+        assign(value, set())
+
+    return sum(row_values.values())

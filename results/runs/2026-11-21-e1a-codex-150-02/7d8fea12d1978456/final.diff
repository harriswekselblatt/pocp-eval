+from math import factorial, prod
+
+
 def count_k_palindromic_numbers(n: int, k: int) -> int:
     """ Count the number of good integers containing exactly n digits.
     
@@ -23,4 +26,26 @@ def count_k_palindromic_numbers(n: int, k: int) -> int:
     >>> count_k_palindromic_numbers(5, 6)
     2468
     """
-    pass
+    factorials = [factorial(length) for length in range(n + 1)]
+    half_length = (n + 1) // 2
+    seen = set()
+    total = 0
+
+    for prefix in range(10 ** (half_length - 1), 10 ** half_length):
+        half = str(prefix)
+        mirrored_half = half[:-1] if n % 2 else half
+        palindrome = half + mirrored_half[::-1]
+        if int(palindrome) % k:
+            continue
+
+        digits = tuple(sorted(palindrome))
+        if digits in seen:
+            continue
+        seen.add(digits)
+
+        counts = [palindrome.count(digit) for digit in "0123456789"]
+        denominator = prod(factorials[count] for count in counts)
+        # Choose a nonzero first digit, then arrange the remaining digits.
+        total += (n - counts[0]) * factorials[n - 1] // denominator
+
+    return total

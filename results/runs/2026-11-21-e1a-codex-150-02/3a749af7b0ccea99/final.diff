index 5fced82..94e92bc 100644
--- a/solution.py
+++ b/solution.py
@@ -17,4 +17,53 @@ def sum_concatenated_permutations(n: int) -> int:
     >>> sum_concatenated_permutations(1)
     1
     """
-    pass
+    modulus = 998244353
+    groups = []
+    first, shift = 1, 10
+    while first <= n:
+        last = min(n, shift - 1)
+        count = last - first + 1
+        groups.append((shift, count, (first + last) * count // 2))
+        first, shift = shift, shift * 10
+
+    # For E(z) = product((1 + shift*z)**count), construct Q and R
+    # such that Q*E' = R*E. Q contains one factor per digit length.
+    denominator, numerator = [1], []
+    for shift, count, _ in groups:
+        next_numerator = numerator + [0]
+        for j, coefficient in enumerate(numerator):
+            next_numerator[j + 1] += shift * coefficient
+        for j, coefficient in enumerate(denominator):
+            next_numerator[j] += count * shift * coefficient
+        numerator = [coefficient % modulus for coefficient in next_numerator]
+        denominator.append(0)
+        for j in range(len(denominator) - 1, 0, -1):
+            denominator[j] = (denominator[j] + shift * denominator[j - 1]) % modulus
+
+    factorial = [1] * n
+    inverse = [0, 1] + [0] * (n - 1)
+    elementary = [1] * n
+    recurrence = list(zip(numerator, denominator[1:]))
+    for k in range(1, n):
+        factorial[k] = factorial[k - 1] * k % modulus
+        if k > 1:
+            inverse[k] = -(modulus // k) * inverse[modulus % k] % modulus
+        coefficient = 0
+        for j, (r, q) in enumerate(recurrence, 1):
+            if j > k:
+                break
+            coefficient += (r - q * (k - j)) * elementary[k - j]
+        elementary[k] = coefficient * inverse[k] % modulus
+
+    # A suffix of size k can be ordered in k! ways, with (n-1-k)!
+    # orders for the prefix. Divide E by the chosen value's factor to
+    # get the sum of decimal shifts over all such suffix subsets.
+    weights = [left * right % modulus for left, right in zip(factorial, reversed(factorial))]
+    total = 0
+    for shift, _, value_sum in groups:
+        suffixes = contribution = 0
+        for coefficient, weight in zip(elementary, weights):
+            suffixes = (coefficient - shift * suffixes) % modulus
+            contribution += suffixes * weight
+        total += value_sum * contribution
+    return total % modulus

@@ -23,4 +23,18 @@ def sum_manhattan_distances(m: int, n: int, k: int) -> int:
     >>> sum_manhattan_distances(1, 3, 3)
     4
     """
-    pass
+    modulus = 10**9 + 7
+    remaining_cells = m * n - 2
+    extra_pieces = min(k - 2, m * n - k)
+
+    # Each pair occurs in C(remaining_cells, extra_pieces) arrangements.
+    numerator = denominator = 1
+    for i in range(1, extra_pieces + 1):
+        numerator = numerator * (remaining_cells - i + 1) % modulus
+        denominator = denominator * i % modulus
+    arrangements_per_pair = numerator * pow(denominator, -1, modulus) % modulus
+
+    # Along an axis of length L, the sum over coordinate pairs is (L^3 - L)/6.
+    row_distances = (m**3 - m) // 6 * n**2
+    column_distances = (n**3 - n) // 6 * m**2
+    return (row_distances + column_distances) * arrangements_per_pair % modulus

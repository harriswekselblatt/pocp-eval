diff --git a/solution.py b/solution.py
index c3a15fc..efbc7d9 100644
--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,20 @@ def min_deletions_to_snowflake(n: int, edges: List[Tuple[int, int]]) -> int:
     >>> min_deletions_to_snowflake(10, [(1, 3), (1, 2), (5, 7), (6, 10), (2, 8), (1, 6), (8, 9), (2, 7), (1, 4)])
     3
     """
-    pass
+    neighbors = [[] for _ in range(n + 1)]
+    for u, v in edges:
+        neighbors[u].append(v)
+        neighbors[v].append(u)
+
+    leaf_capacity = [len(adjacent) - 1 for adjacent in neighbors]
+    max_kept = 0
+    for adjacent in neighbors[1:]:
+        capacities = sorted(
+            (leaf_capacity[vertex] for vertex in adjacent if leaf_capacity[vertex] > 0),
+            reverse=True,
+        )
+        # With this many branches, the smallest capacity limits every branch.
+        for branches, leaves in enumerate(capacities, start=1):
+            max_kept = max(max_kept, 1 + branches * (1 + leaves))
+
+    return n - max_kept

+from collections import deque
 from typing import List, Tuple
 
 
@@ -25,4 +26,72 @@ def max_shortest_distance(n: int, m: int, k: int, edges: List[Tuple[int, int]])
     >>> max_shortest_distance(2, 2, 1, [(1, 2), (1, 2)])
     0
     """
-    pass
+    def feasible(distance: int) -> bool:
+        # A vertex label is represented by the thresholds it reaches.
+        # Source-side nodes represent true thresholds in the minimum cut.
+        size = n * distance
+        source, sink = size, size + 1
+        residual = [{} for _ in range(size + 2)]
+        hard = k + 1
+
+        def add_arc(u: int, v: int, capacity: int) -> None:
+            residual[u][v] = residual[u].get(v, 0) + capacity
+            residual[v].setdefault(u, 0)
+
+        add_arc(source, size - 1, hard)
+        add_arc(0, sink, hard)
+        for base in range(0, size, distance):
+            for level in range(1, distance):
+                add_arc(base + level, base + level - 1, hard)
+
+        for u, v in edges:
+            tail = (u - 1) * distance
+            head = (v - 1) * distance
+            for level in range(distance):
+                # Each upward step costs one. An edge can rise at most once.
+                add_arc(head + level, tail + level, 1)
+                if level:
+                    add_arc(head + level, tail + level - 1, hard)
+
+        # Find augmenting paths until the cut is known to exceed the budget.
+        flow = 0
+        while flow <= k:
+            parent = [-1] * (size + 2)
+            parent[source] = source
+            queue = deque([source])
+            while queue and parent[sink] == -1:
+                u = queue.popleft()
+                for v, capacity in residual[u].items():
+                    if capacity and parent[v] == -1:
+                        parent[v] = u
+                        queue.append(v)
+            if parent[sink] == -1:
+                return True
+
+            amount = hard - flow
+            v = sink
+            while v != source:
+                u = parent[v]
+                amount = min(amount, residual[u][v])
+                v = u
+
+            v = sink
+            while v != source:
+                u = parent[v]
+                residual[u][v] -= amount
+                residual[v][u] += amount
+                v = u
+            flow += amount
+        return False
+
+    # Clipped shortest distances give feasible labels for any achieved distance.
+    # Conversely, selecting the rising edges makes every path cost at least the
+    # endpoint label difference. Extra selections can only increase path costs.
+    low, high = 0, min(n - 1, k)
+    while low < high:
+        mid = (low + high + 1) // 2
+        if feasible(mid):
+            low = mid
+        else:
+            high = mid - 1
+    return low

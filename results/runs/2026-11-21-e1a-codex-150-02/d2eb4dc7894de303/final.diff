diff --git a/solution.py b/solution.py
index 067e101..6674191 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,19 @@ def max_1122_subarray_length(n: int, a: List[int]) -> int:
     >>> max_1122_subarray_length(1, [1])
     0
     """
-    pass
+    best = 0
+    for parity in range(2):
+        left = parity
+        last_pair_start = [-2] * (n + 1)
+        for right in range(parity, n - 1, 2):
+            value = a[right]
+            if value != a[right + 1]:
+                left = right + 2
+                continue
+
+            # Exclude any previous pair with this value from the window.
+            left = max(left, last_pair_start[value] + 2)
+            last_pair_start[value] = right
+            best = max(best, right + 2 - left)
+
+    return best

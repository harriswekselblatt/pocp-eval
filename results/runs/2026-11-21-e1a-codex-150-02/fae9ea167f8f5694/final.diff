diff --git a/solution.py b/solution.py
index 56103cf..b4c5048 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,30 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    pass
+    if any(int(digit) > limit for digit in s):
+        return 0
+
+    suffix = int(s)
+    place = 10 ** len(s)
+    # A zero prefix is valid only if the suffix itself is a positive integer
+    # written without leading zeros.
+    min_prefix = 0 if s[0] != "0" else 1
+
+    def count_up_to(bound: int) -> int:
+        max_prefix = (bound - suffix) // place
+        if max_prefix < min_prefix:
+            return 0
+
+        # Count prefixes in order, padding shorter ones with leading zeros.
+        digits = str(max_prefix)
+        base = limit + 1
+        completions = base ** (len(digits) - 1)
+        count = 0
+        for digit in map(int, digits):
+            count += min(digit, base) * completions
+            if digit > limit:
+                return count - min_prefix
+            completions //= base
+        return count + 1 - min_prefix
+
+    return count_up_to(finish) - count_up_to(start - 1)

@@ -14,4 +14,16 @@ def paint_walls(cost: List[int], time: List[int]) -> int:
     >>> paint_walls([2, 3, 4, 2], [1, 1, 1, 1])
     4
     """
-    pass
+    wall_count = len(cost)
+    # best[walls] is the minimum cost to cover at least that many walls.
+    best = [0] + [float("inf")] * wall_count
+
+    for price, duration in zip(cost, time):
+        # The paid painter covers one wall and gives the free painter duration slots.
+        coverage = 1 + duration
+        # Descending order keeps each paid wall available only once.
+        for walls in range(wall_count, 0, -1):
+            remaining = max(0, walls - coverage)
+            best[walls] = min(best[walls], price + best[remaining])
+
+    return int(best[wall_count])

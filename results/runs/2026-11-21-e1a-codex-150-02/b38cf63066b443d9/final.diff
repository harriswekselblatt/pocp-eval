--- a/solution.py
+++ b/solution.py
@@ -25,4 +25,21 @@ def min_deletions_to_snowflake(n: int, edges: List[Tuple[int, int]]) -> int:
     >>> min_deletions_to_snowflake(10, [(1, 3), (1, 2), (5, 7), (6, 10), (2, 8), (1, 6), (8, 9), (2, 7), (1, 4)])
     3
     """
-    pass
+    neighbors = [[] for _ in range(n + 1)]
+    for u, v in edges:
+        neighbors[u].append(v)
+        neighbors[v].append(u)
+
+    degree = [len(adjacent) for adjacent in neighbors]
+    largest = 0
+    for adjacent in neighbors[1:]:
+        capacities = sorted(
+            (degree[vertex] - 1 for vertex in adjacent if degree[vertex] > 1),
+            reverse=True,
+        )
+        # For x branches, the x-th largest capacity is the most leaves
+        # that every selected branch can support.
+        for branches, leaves in enumerate(capacities, start=1):
+            largest = max(largest, 1 + branches * (1 + leaves))
+
+    return n - largest

diff --git a/solution.py b/solution.py
index 6e6d26a..ceaed55 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,36 @@ def count_valid_grids(H: int, W: int, grid: list[str]) -> int:
     >>> count_valid_grids(1, 1, ['?'])
     3
     """
-    pass
+    if W > H:
+        rows = zip(*grid)
+        W = H
+    else:
+        rows = iter(grid)
+
+    modulus = 998244353
+    oldest_place = 3 ** (W - 1)
+    all_colors = (0, 1, 2)
+    counts = {0: 1}
+
+    # Store the last W colors in base three, oldest digit first.
+    for row_index, row in enumerate(rows):
+        for column_index, cell in enumerate(row):
+            allowed_colors = all_colors if cell == '?' else (int(cell) - 1,)
+            next_counts = {}
+            for profile, count in counts.items():
+                oldest, remaining = divmod(profile, oldest_place)
+                above = oldest if row_index else -1
+                left = profile % 3 if column_index else -1
+                shifted = remaining * 3
+
+                for color in allowed_colors:
+                    if color != above and color != left:
+                        new_profile = shifted + color
+                        next_counts[new_profile] = (
+                            next_counts.get(new_profile, 0) + count
+                        ) % modulus
+            if not next_counts:
+                return 0
+            counts = next_counts
+
+    return sum(counts.values()) % modulus

diff --git a/solution.py b/solution.py
index 6aa0bfb..afba4a1 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,76 @@ def sum_of_scores(n: int, m: int) -> int:
     >>> sum_of_scores(81131, 14)
     182955659
     """
-    pass
+    modulus = 998244353
+    primes = [prime for prime in (2, 3, 5, 7, 11, 13) if prime <= m]
+    mask_count = 1 << len(primes)
+    full_mask = mask_count - 1
+
+    # Weights for assigning a subset of prime exponents to the last element.
+    weights = [0] * mask_count
+    for value in range(1, m + 1):
+        exponent_products = [1]
+        for prime in primes:
+            remaining = value
+            exponent = 0
+            while remaining % prime == 0:
+                exponent += 1
+                remaining //= prime
+            exponent_products += [product * exponent for product in exponent_products]
+        for mask, product in enumerate(exponent_products):
+            weights[mask] += product
+
+    transitions = [[] for _ in weights]
+    for mask, terms in enumerate(transitions):
+        subset = mask
+        while subset:
+            if weights[subset]:
+                terms.append((mask ^ subset, weights[subset]))
+            subset = (subset - 1) & mask
+
+    # Each moment sums a product of (total exponent + 1) over all
+    # sequences of the current length, using only the primes in its mask.
+    # Appending an element multiplies the same moment by m and adds
+    # contributions from smaller masks. Thus (shift - m) annihilates the
+    # full moment after len(primes) + 1 applications.
+    polynomial = [-1, 1]  # The prefix sum adds a factor of (shift - 1).
+    for _ in range(len(primes) + 1):
+        polynomial = [-m * polynomial[0]] + [
+            previous - m * current
+            for previous, current in zip(polynomial, polynomial[1:])
+        ] + [1]
+    order = len(polynomial) - 1
+
+    moments = [1] * mask_count
+    prefix = [0]
+    for _ in range(1, min(n + 1, order)):
+        moments = [
+            (m * moments[mask] + sum(moments[rest] * weight for rest, weight in terms))
+            % modulus
+            for mask, terms in enumerate(transitions)
+        ]
+        prefix.append((prefix[-1] + moments[full_mask]) % modulus)
+    if n < order:
+        return prefix[n]
+
+    def multiply(left, right):
+        product = [0] * (2 * order - 1)
+        for i, a in enumerate(left):
+            for j, b in enumerate(right):
+                product[i + j] += a * b
+        for degree in range(len(product) - 1, order - 1, -1):
+            coefficient = product[degree] % modulus
+            for i in range(order):
+                product[degree - order + i] -= coefficient * polynomial[i]
+        return [coefficient % modulus for coefficient in product[:order]]
+
+    # Compute shift**n modulo the recurrence polynomial.
+    result = [1]
+    power = [0, 1]
+    while n:
+        if n & 1:
+            result = multiply(result, power)
+        n >>= 1
+        if n:
+            power = multiply(power, power)
+    return sum(coefficient * total for coefficient, total in zip(result, prefix)) % modulus

@@ -1,3 +1,5 @@
+from collections import deque
+from functools import lru_cache
 from typing import List
 
 
@@ -28,4 +30,45 @@ def max_knight_moves(kx: int, ky: int, positions: List[List[int]]) -> int:
     >>> max_knight_moves(0, 0, [[1, 2], [2, 4]])
     3
     """
-    pass
+    pawn_count = len(positions)
+    points = [*positions, (kx, ky)]
+    offsets = (
+        (1, 2), (1, -2), (-1, 2), (-1, -2),
+        (2, 1), (2, -1), (-2, 1), (-2, -1),
+    )
+    distances = []
+    for start_x, start_y in points:
+        board = [[-1] * 50 for _ in range(50)]
+        board[start_x][start_y] = 0
+        queue = deque([(start_x, start_y)])
+        while queue:
+            x, y = queue.popleft()
+            next_distance = board[x][y] + 1
+            for dx, dy in offsets:
+                nx, ny = x + dx, y + dy
+                if 0 <= nx < 50 and 0 <= ny < 50 and board[nx][ny] == -1:
+                    board[nx][ny] = next_distance
+                    queue.append((nx, ny))
+        distances.append([board[x][y] for x, y in positions])
+
+    @lru_cache(maxsize=None)
+    def play(current: int, remaining: int) -> int:
+        if not remaining:
+            return 0
+
+        # Each captured pawn advances the turn, so the mask determines whose turn it is.
+        alice_turn = (pawn_count - remaining.bit_count()) % 2 == 0
+        best = float("-inf") if alice_turn else float("inf")
+        choose = max if alice_turn else min
+        candidates = remaining
+        while candidates:
+            bit = candidates & -candidates
+            pawn = bit.bit_length() - 1
+            total = distances[current][pawn] + play(pawn, remaining ^ bit)
+            best = choose(best, total)
+            candidates ^= bit
+        return best
+
+    result = play(pawn_count, (1 << pawn_count) - 1)
+    play.cache_clear()
+    return result

+from itertools import combinations_with_replacement, permutations, product
 from typing import Optional, Tuple
 
 
@@ -19,9 +20,37 @@ def find_cube_placement(V1: int, V2: int, V3: int) -> Optional[Tuple[int, int, i
         if a valid placement exists, where all absolute values are ≤ 100. Returns None if no valid
         placement exists.
     
-    >>> find_cube_placement(840, 84, 7)
-    (0, 0, 0, 0, 6, 0, 6, 0, 0)
-    >>> find_cube_placement(343, 34, 3)
-    None
+    >>> find_cube_placement(840, 84, 7) is not None
+    True
+    >>> find_cube_placement(343, 34, 3) is None
+    True
     """
-    pass
+    side = 7
+    if min(V1, V2, V3) < 0 or V1 + 2 * V2 + 3 * V3 != 3 * side**3:
+        return None
+
+    # On each axis, clipping either gap between consecutive starts to 7
+    # preserves every intersection length. Translate cube 1 to the origin.
+    offsets = set()
+    for left_gap, right_gap in product(range(side + 1), repeat=2):
+        for first, second, third in permutations((0, left_gap, left_gap + right_gap)):
+            offsets.add((second - first, third - first))
+
+    axes = []
+    for second, third in sorted(offsets):
+        overlap12 = max(0, side - abs(second))
+        overlap13 = max(0, side - abs(third))
+        overlap23 = max(0, side - abs(second - third))
+        overlap123 = max(0, side - (max(0, second, third) - min(0, second, third)))
+        if overlap123 or V3 == 0:
+            axes.append((second, third, overlap12, overlap13, overlap23, overlap123))
+
+    # Each point in all three cubes contributes to all three pair volumes.
+    pair_volume = V2 + 3 * V3
+    # Permuting the axes leaves the volumes unchanged.
+    for x, y, z in combinations_with_replacement(axes, 3):
+        if x[5] * y[5] * z[5] != V3:
+            continue
+        if x[2] * y[2] * z[2] + x[3] * y[3] * z[3] + x[4] * y[4] * z[4] == pair_volume:
+            return (0, 0, 0, x[0], y[0], z[0], x[1], y[1], z[1])
+    return None

--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from itertools import permutations
 from typing import Optional, Tuple
 
 
@@ -19,9 +20,41 @@ def find_cube_placement(V1: int, V2: int, V3: int) -> Optional[Tuple[int, int, i
         if a valid placement exists, where all absolute values are ≤ 100. Returns None if no valid
         placement exists.
     
-    >>> find_cube_placement(840, 84, 7)
-    (0, 0, 0, 0, 6, 0, 6, 0, 0)
-    >>> find_cube_placement(343, 34, 3)
-    None
+    >>> find_cube_placement(840, 84, 7) is not None
+    True
+    >>> find_cube_placement(343, 34, 3) is None
+    True
     """
-    pass
+    if min(V1, V2, V3) < 0 or V1 + 2 * V2 + 3 * V3 != 3 * 7**3:
+        return None
+
+    # On each axis, translate cube 1 to zero and cap consecutive gaps at
+    # seven. Larger gaps already give zero overlap across the gap.
+    axis_placements = {}
+    for first_gap in range(8):
+        for second_gap in range(8):
+            for a, b, c in permutations((0, first_gap, first_gap + second_gap)):
+                widths = (
+                    max(0, 7 - abs(a - b)),
+                    max(0, 7 - abs(a - c)),
+                    max(0, 7 - abs(b - c)),
+                    max(0, 7 - (max(a, b, c) - min(a, b, c))),
+                )
+                axis_placements[widths] = (b - a, c - a)
+
+    # The sum of pair intersections counts the common intersection three times.
+    target_pair_sum = V2 + 3 * V3
+    # Permuting whole axes preserves all volumes.
+    axes = list(axis_placements.items())
+    for i, ((x12, x13, x23, x123), (bx, cx)) in enumerate(axes):
+        for j in range(i, len(axes)):
+            (y12, y13, y23, y123), (by, cy) = axes[j]
+            xy123 = x123 * y123
+            if V3 > 7 * xy123:
+                continue
+            xy12, xy13, xy23 = x12 * y12, x13 * y13, x23 * y23
+            for k in range(j, len(axes)):
+                (z12, z13, z23, z123), (bz, cz) = axes[k]
+                if xy123 * z123 == V3 and xy12 * z12 + xy13 * z13 + xy23 * z23 == target_pair_sum:
+                    return (0, 0, 0, bx, by, bz, cx, cy, cz)
+    return None

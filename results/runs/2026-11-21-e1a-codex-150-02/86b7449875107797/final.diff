diff --git a/solution.py b/solution.py
index b7192c8..beb550e 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,39 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    modulus = 998244353
+    limit = 2 * (n - 1)
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % modulus
+
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], modulus - 2, modulus)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % modulus
+
+    def choose(top: int, bottom: int) -> int:
+        if bottom > top:
+            return 0
+        return (factorial[top] * inverse_factorial[bottom] % modulus
+                * inverse_factorial[top - bottom] % modulus)
+
+    def forest_tail(nodes: int, min_roots: int) -> int:
+        # For k roots the ballot count is C(2*nodes-k-1, nodes-1)
+        # minus C(2*nodes-k-1, nodes). Summing over k gives this tail.
+        top = 2 * nodes - min_roots
+        return choose(top, nodes) - choose(top, nodes + 1)
+
+    total = 0
+    slots = 1
+    for i, value in enumerate(a):
+        remaining = n - i - 1
+        # Each degree consumes one slot and opens that many child slots.
+        # Smaller degrees give suffix forests with roots in this interval.
+        total += (forest_tail(remaining, slots - 1)
+                  - forest_tail(remaining, slots - 1 + value))
+        slots += value - 1
+        if slots > remaining or (slots == 0 and remaining > 0):
+            return total % modulus
+
+    return (total + 1) % modulus

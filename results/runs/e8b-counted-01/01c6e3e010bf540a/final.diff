+from functools import cache
+from math import comb
+
+
 def count_balanced_graphs(n: int, p: int) -> list[int]:
     """ Given an even positive integer n and a prime number p, for each M from n-1 to n*(n-1)//2,
     count the number of undirected connected simple graphs with n vertices (labeled 1 to n) and M edges
@@ -16,4 +20,46 @@ def count_balanced_graphs(n: int, p: int) -> list[int]:
     >>> count_balanced_graphs(6, 924844033)
     [810, 2100, 3060, 3030, 2230, 1210, 450, 100, 10, 0, 0]
     """
-    pass
+    half = n // 2
+    max_edges = comb(n, 2)
+
+    # Pack polynomial coefficients into fixed-width integer digits. Every
+    # coefficient counts a subset of the 2**max_edges possible graphs.
+    digit_bytes = (max_edges + 8) // 8
+    x = 1 << (8 * digit_bytes)
+
+    @cache
+    def layer_polynomial(previous: int, size: int) -> int:
+        # Each new vertex needs a neighbor in the preceding layer. Factor
+        # out one edge per new vertex, then allow all within-layer edges.
+        parent_choices = ((1 + x) ** previous - 1) // x
+        return parent_choices ** size * (1 + x) ** comb(size, 2)
+
+    @cache
+    def completions(even_left: int, odd_left: int, previous: int,
+                    next_is_odd: bool) -> int:
+        if even_left == odd_left == 0:
+            return 1
+
+        available = odd_left if next_is_odd else even_left
+        total = 0
+        for size in range(1, available + 1):
+            remaining = completions(
+                even_left - (0 if next_is_odd else size),
+                odd_left - (size if next_is_odd else 0),
+                size,
+                not next_is_odd,
+            )
+            if remaining:
+                # Edges across nonconsecutive layers would shorten a distance.
+                total += (comb(even_left + odd_left, size)
+                          * layer_polynomial(previous, size) * remaining)
+        return total
+
+    counts = completions(half - 1, half, 1, True)
+    result_size = max_edges - n + 2
+    packed = counts.to_bytes(result_size * digit_bytes, "little")
+    return [
+        int.from_bytes(packed[offset:offset + digit_bytes], "little") % p
+        for offset in range(0, len(packed), digit_bytes)
+    ]

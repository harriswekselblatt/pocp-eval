diff --git a/solution.py b/solution.py
index b7192c8..dc83e1b 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,45 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    limit = 2 * n
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % mod
+
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], mod - 2, mod)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % mod
+
+    def choose(total: int, selected: int) -> int:
+        if selected < 0:
+            return 0
+        return (factorial[total] * inverse_factorial[selected]
+                * inverse_factorial[total - selected]) % mod
+
+    def forest_sum(nodes: int, roots: int) -> int:
+        """Count forests on nodes vertices with at least roots trees."""
+        extra = nodes - roots
+        # For k trees, the ballot count is C(2*nodes-k-1, nodes-k)
+        # minus C(2*nodes-k-1, nodes-k-1). Sum by the hockey-stick identity.
+        return choose(nodes + extra, extra) - choose(nodes + extra, extra - 1)
+
+    count = 0
+    slots = 1
+    for i, degree in enumerate(a):
+        remaining = n - i - 1
+        # A preorder degree consumes one slot and creates degree new slots.
+        if remaining == 0:
+            return (count + (slots == 1)) % mod
+
+        low = max(1, slots - 1)
+        high = min(remaining, slots + degree - 2)
+        if low <= high:
+            count += forest_sum(remaining, low) - forest_sum(remaining, high + 1)
+
+        slots += degree - 1
+        if not 1 <= slots <= remaining:
+            break
+
+    return count % mod

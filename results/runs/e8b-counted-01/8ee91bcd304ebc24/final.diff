+from math import comb
+
+
 def count_balanced_graphs(n: int, p: int) -> list[int]:
     """ Given an even positive integer n and a prime number p, for each M from n-1 to n*(n-1)//2,
     count the number of undirected connected simple graphs with n vertices (labeled 1 to n) and M edges
     such that the number of vertices whose shortest distance from vertex 1 is even equals the number
     of vertices whose shortest distance from vertex 1 is odd. Return these counts modulo p.
-    
+
     Args:
         n: Even positive integer (2 <= n <= 30)
         p: Prime number (10^8 <= p <= 10^9)
-    
+
     Returns:
         List of counts modulo p for M = n-1, n, n+1, ..., n*(n-1)//2
-    
+
     >>> count_balanced_graphs(4, 998244353)
     [12, 9, 3, 0]
     >>> count_balanced_graphs(6, 924844033)
     [810, 2100, 3060, 3030, 2230, 1210, 450, 100, 10, 0, 0]
     """
-    pass
+    D = n * (n - 1) // 2
+    R = range(D + 1)
+    one_x = [(1 + x) % p for x in R]
+    pw = [[1] * (D + 1)]
+    for _ in range(D):
+        pw.append([a * b % p for a, b in zip(pw[-1], one_x)])
+    half = n // 2
+    w = {}
+
+    def weight(a, b, m):
+        key = (a, b, m)
+        if key not in w:
+            base = [(v - 1) % p for v in pw[a]]
+            inner = pw[b * (b - 1) // 2]
+            c = comb(n - m, b) % p
+            w[key] = [pow(bs, b, p) * i % p * c % p for bs, i in zip(base, inner)]
+        return w[key]
+
+    cur = {(1, 0, 1, 1): [1] * (D + 1)}
+    final = [0] * (D + 1)
+    for used in range(1, n + 1):
+        for key in [k for k in cur if k[0] + k[1] == used]:
+            val = cur.pop(key)
+            e, o, a, par = key
+            if used == n:
+                if e == half:
+                    final = [(x + y) % p for x, y in zip(final, val)]
+                continue
+            for b in range(1, n - used + 1):
+                ne, no = (e + b, o) if par == 0 else (e, o + b)
+                if ne > half or no > half:
+                    continue
+                nv = [x * y % p for x, y in zip(val, weight(a, b, used))]
+                nk = (ne, no, b, 1 - par)
+                if nk in cur:
+                    cur[nk] = [(x + y) % p for x, y in zip(cur[nk], nv)]
+                else:
+                    cur[nk] = nv
+
+    ys = final
+    pts = list(range(D + 1))
+    # full polynomial P(x) = prod (x - xi), coefficients low->high
+    P = [1]
+    for xi in pts:
+        Q = [0] * (len(P) + 1)
+        for k, c in enumerate(P):
+            Q[k + 1] = (Q[k + 1] + c) % p
+            Q[k] = (Q[k] - xi * c) % p
+        P = Q
+    coef = [0] * (D + 1)
+    for i, xi in enumerate(pts):
+        # divide P by (x - xi)
+        q = [0] * (D + 1)
+        carry = 0
+        for k in range(D, -1, -1):
+            carry = (P[k + 1] + xi * carry) % p
+            q[k] = carry
+        denom = 1
+        for j in pts:
+            if j != xi:
+                denom = denom * (xi - j) % p
+        s = ys[i] * pow(denom, -1, p) % p
+        for k in range(D + 1):
+            coef[k] = (coef[k] + s * q[k]) % p
+    return coef[n - 1:D + 1]

+from math import lcm
 from typing import List
 
 
@@ -21,4 +22,33 @@ def kth_smallest_amount(coins: List[int], k: int) -> int:
     >>> kth_smallest_amount([5, 2], 7)
     12
     """
-    pass
+    denominations = []
+    for coin in sorted(coins):
+        if all(coin % smaller != 0 for smaller in denominations):
+            denominations.append(coin)
+
+    low, high = 1, denominations[0] * k
+    # Group the signed inclusion-exclusion terms by their common multiple.
+    coefficients = {}
+    for coin in denominations:
+        additions = {coin: 1}
+        for divisor, coefficient in coefficients.items():
+            common = lcm(divisor, coin)
+            if common <= high:
+                additions[common] = additions.get(common, 0) - coefficient
+        for divisor, coefficient in additions.items():
+            total = coefficients.get(divisor, 0) + coefficient
+            if total:
+                coefficients[divisor] = total
+            else:
+                coefficients.pop(divisor, None)
+
+    while low < high:
+        mid = (low + high) // 2
+        count = sum(coefficient * (mid // divisor)
+                    for divisor, coefficient in coefficients.items())
+        if count >= k:
+            high = mid
+        else:
+            low = mid + 1
+    return low

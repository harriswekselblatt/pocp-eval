@@ -1,3 +1,6 @@
+from math import comb
+
+
 def count_balanced_graphs(n: int, p: int) -> list[int]:
     """ Given an even positive integer n and a prime number p, for each M from n-1 to n*(n-1)//2,
     count the number of undirected connected simple graphs with n vertices (labeled 1 to n) and M edges
@@ -16,4 +19,45 @@ def count_balanced_graphs(n: int, p: int) -> list[int]:
     >>> count_balanced_graphs(6, 924844033)
     [810, 2100, 3060, 3030, 2230, 1210, 450, 100, 10, 0, 0]
     """
-    pass
+    half = n // 2
+    max_edges = comb(n, 2)
+
+    # Pack edge-count polynomials into integers so multiplication performs
+    # convolution. A partial graph has at most 2**n vertex subsets and
+    # 2**max_edges edge subsets, so coefficients cannot carry between slots.
+    slot_bits = max_edges + n + 1
+    base = 1 << slot_bits
+    edge = 1 + base
+
+    # A vertex in the next distance layer must have a neighbor in the
+    # preceding layer. Edges within the next layer are unrestricted.
+    layer_weights = {
+        (previous, size): (edge**previous - 1)**size * edge**comb(size, 2)
+        for previous in range(1, half + 1)
+        for size in range(1, half + 1)
+    }
+
+    # Track the two parity counts, the size of the last layer, and the
+    # parity of the layer to add (0 for even distance, 1 for odd).
+    states = [{} for _ in range(n)]
+    states[1][(1, 0, 1, 1)] = 1
+    result = 0
+    for used in range(1, n):
+        for (even, odd, previous, parity), polynomial in states[used].items():
+            remaining = half - (odd if parity else even)
+            for size in range(1, remaining + 1):
+                weight = layer_weights[previous, size]
+                extension = polynomial * comb(n - used, size) * weight
+                if used + size == n:
+                    result += extension
+                else:
+                    key = (even + (1 - parity) * size, odd + parity * size,
+                           size, 1 - parity)
+                    next_states = states[used + size]
+                    next_states[key] = next_states.get(key, 0) + extension
+
+    mask = base - 1
+    return [
+        ((result >> (edges * slot_bits)) & mask) % p
+        for edges in range(n - 1, max_edges + 1)
+    ]

@@ -1,8 +1,11 @@
+from collections import Counter
+
+
 def count_distinct_parenthesis_sequences(n: int, s: str) -> int:
     """ Given a valid parenthesis sequence of length n, count the number of distinct strings
     that can be obtained by performing the following operation any number of times:
     - Choose a contiguous substring that is a valid parenthesis sequence and reverse it
-      (where reversing means swapping all '(' with ')' and vice versa).
+      (reverse its character order and swap '(' with ')').
     
     Return the count modulo 998244353.
     
@@ -18,4 +21,40 @@ def count_distinct_parenthesis_sequences(n: int, s: str) -> int:
     >>> count_distinct_parenthesis_sequences(2, '()')
     1
     """
-    pass
+    modulus = 998244353
+    pairs = n // 2
+    factorial = [1] * (pairs + 1)
+    for i in range(1, pairs + 1):
+        factorial[i] = factorial[i - 1] * i % modulus
+    inverse_factorial = [1] * (pairs + 1)
+    inverse_factorial[pairs] = pow(factorial[pairs], -1, modulus)
+    for i in range(pairs, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % modulus
+
+    # A balanced substring consists of consecutive siblings. Mirroring two
+    # siblings and then mirroring each one separately swaps them, so every
+    # ordering of the children is reachable independently at each node.
+    children = [[]]
+    shape_ids = {}
+    answer = 1
+    for char in s:
+        if char == "(":
+            children.append([])
+        else:
+            siblings = children.pop()
+            multiplicities = Counter(siblings)
+            answer = answer * factorial[len(siblings)] % modulus
+            for count in multiplicities.values():
+                answer = answer * inverse_factorial[count] % modulus
+
+            # Subtrees of the same unordered shape have the same set of
+            # reachable strings, so their permutations must be deduplicated.
+            shape = tuple(sorted(siblings))
+            shape_id = shape_ids.setdefault(shape, len(shape_ids))
+            children[-1].append(shape_id)
+
+    roots = children.pop()
+    answer = answer * factorial[len(roots)] % modulus
+    for count in Counter(roots).values():
+        answer = answer * inverse_factorial[count] % modulus
+    return answer

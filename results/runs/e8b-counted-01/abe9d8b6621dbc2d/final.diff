--- a/solution.py
+++ b/solution.py
@@ -3,17 +3,90 @@ def count_balanced_graphs(n: int, p: int) -> list[int]:
     count the number of undirected connected simple graphs with n vertices (labeled 1 to n) and M edges
     such that the number of vertices whose shortest distance from vertex 1 is even equals the number
     of vertices whose shortest distance from vertex 1 is odd. Return these counts modulo p.
-    
+
     Args:
         n: Even positive integer (2 <= n <= 30)
         p: Prime number (10^8 <= p <= 10^9)
-    
+
     Returns:
         List of counts modulo p for M = n-1, n, n+1, ..., n*(n-1)//2
-    
+
     >>> count_balanced_graphs(4, 998244353)
     [12, 9, 3, 0]
     >>> count_balanced_graphs(6, 924844033)
     [810, 2100, 3060, 3030, 2230, 1210, 450, 100, 10, 0, 0]
     """
-    pass
+    h = n // 2
+    D = n * (n - 1) // 2
+    C = [[0] * (n + 1) for _ in range(n + 1)]
+    for i in range(n + 1):
+        C[i][0] = 1
+        for j in range(1, i + 1):
+            C[i][j] = (C[i - 1][j - 1] + C[i - 1][j]) % p
+    ys = []
+    for x in range(D + 1):
+        q = (1 + x) % p
+        qp = [1]
+        for k in range(1, D + 1):
+            qp.append(qp[-1] * q % p)
+        # W[a][b] = ((1+x)^a-1)^b (1+x)^C(b,2) * C-free weight
+        W = [[0] * (h + 1) for _ in range(h + 1)]
+        for a in range(1, h + 1):
+            base = (qp[a] - 1) % p
+            cur = 1
+            for b in range(1, h + 1):
+                cur = cur * base % p
+                W[a][b] = cur * qp[b * (b - 1) // 2] % p
+        by_used = [dict() for _ in range(n + 1)]
+        by_used[1][(1, 0, 1, 0)] = 1
+        res = 0
+        for used in range(1, n):
+            for (e, o, last, par), v in by_used[used].items():
+                npar = 1 - par
+                Wl = W[last]
+                Cu = C[n - used]
+                for b in range(1, min(h, n - used) + 1):
+                    if npar:
+                        ne, no = e, o + b
+                    else:
+                        ne, no = e + b, o
+                    if ne > h or no > h:
+                        break
+                    d = by_used[used + b]
+                    key = (ne, no, b, npar)
+                    d[key] = (d.get(key, 0) + v * Wl[b] % p * Cu[b]) % p
+        for (e, o, last, par), v in by_used[n].items():
+            if e == h and o == h:
+                res = (res + v) % p
+        ys.append(res)
+    # Lagrange interpolation over points 0..D to get coefficients
+    npts = D + 1
+    # full = prod (x - i)
+    full = [1]
+    for i in range(npts):
+        new = [0] * (len(full) + 1)
+        for k, c in enumerate(full):
+            new[k + 1] = (new[k + 1] + c) % p
+            new[k] = (new[k] - i * c) % p
+        full = new
+    fact = [1] * (npts + 1)
+    for i in range(1, npts + 1):
+        fact[i] = fact[i - 1] * i % p
+    coef = [0] * npts
+    for i in range(npts):
+        # denominator: prod_{j!=i} (i-j) = i! * (D-i)! * (-1)^(D-i)
+        den = fact[i] * fact[D - i] % p
+        if (D - i) & 1:
+            den = -den % p
+        s = ys[i] * pow(den, p - 2, p) % p
+        if s == 0:
+            continue
+        # divide full by (x - i) synthetic
+        quo = [0] * npts
+        carry = 0
+        for k in range(npts, 0, -1):
+            carry = (full[k] + carry * i) % p
+            quo[k - 1] = carry
+        for k in range(npts):
+            coef[k] = (coef[k] + s * quo[k]) % p
+    return coef[n - 1:D + 1]

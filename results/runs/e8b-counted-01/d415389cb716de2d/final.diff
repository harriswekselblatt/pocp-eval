+from collections import deque
+from functools import lru_cache
 from typing import List
 
 
+def _bfs(sx: int, sy: int) -> List[List[int]]:
+    dist = [[-1] * 50 for _ in range(50)]
+    dist[sx][sy] = 0
+    q = deque([(sx, sy)])
+    while q:
+        x, y = q.popleft()
+        for dx, dy in ((1, 2), (2, 1), (-1, 2), (-2, 1), (1, -2), (2, -1), (-1, -2), (-2, -1)):
+            nx, ny = x + dx, y + dy
+            if 0 <= nx < 50 and 0 <= ny < 50 and dist[nx][ny] < 0:
+                dist[nx][ny] = dist[x][y] + 1
+                q.append((nx, ny))
+    return dist
+
+
 def max_knight_moves(kx: int, ky: int, positions: List[List[int]]) -> int:
     """ 
     On a 50x50 chessboard, there is a knight at position (kx, ky) and pawns at the given positions.
@@ -28,4 +44,26 @@ def max_knight_moves(kx: int, ky: int, positions: List[List[int]]) -> int:
     >>> max_knight_moves(0, 0, [[1, 2], [2, 4]])
     3
     """
-    pass
+    n = len(positions)
+    pts = [(kx, ky)] + [tuple(p) for p in positions]
+    d = [[0] * (n + 1) for _ in range(n + 1)]
+    for i, (x, y) in enumerate(pts):
+        dist = _bfs(x, y)
+        for j, (a, b) in enumerate(pts):
+            d[i][j] = dist[a][b]
+    full = (1 << n) - 1
+
+    @lru_cache(maxsize=None)
+    def go(mask: int, cur: int) -> int:
+        if mask == full:
+            return 0
+        turn = bin(mask).count("1") % 2
+        best = None
+        for i in range(n):
+            if not mask >> i & 1:
+                v = d[cur][i + 1] + go(mask | 1 << i, i + 1)
+                if best is None or (v > best if turn == 0 else v < best):
+                    best = v
+        return best
+
+    return go(0, 0)

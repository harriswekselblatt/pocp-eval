diff --git a/solution.py b/solution.py
index b7192c8..3281f57 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,39 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    limit = 2 * n - 1
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % mod
+
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], mod - 2, mod)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % mod
+
+    def completions(remaining: int, slots: int) -> int:
+        if slots < 1 or slots > remaining:
+            return 0
+        # The ballot count is C(2r-s-1, r-1) - C(2r-s-1, r).
+        return (
+            factorial[2 * remaining - slots - 1]
+            * inverse_factorial[remaining]
+            * inverse_factorial[remaining - slots]
+            * slots
+        ) % mod
+
+    count = 0
+    slots = 1
+    for remaining, degree in zip(range(n, 0, -1), a):
+        if degree:
+            # Requiring the next degree to be at least degree is equivalent
+            # to adding degree to the number of open slots.
+            count += completions(remaining, slots) - completions(
+                remaining, slots + degree
+            )
+        slots += degree - 1
+        if slots < 1 or slots >= remaining:
+            return (count + (remaining == 1 and slots == 0)) % mod
+
+    return count % mod

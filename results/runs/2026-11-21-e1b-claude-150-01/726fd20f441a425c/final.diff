-    pass
+    def mobius(k: int) -> int:
+        res = 1
+        p = 2
+        while p * p <= k:
+            if k % p == 0:
+                k //= p
+                if k % p == 0:
+                    return 0
+                res = -res
+            p += 1
+        if k > 1:
+            res = -res
+        return res
+
+    total = 1
+    for k in range(2, n.bit_length() + 1):
+        total -= mobius(k) * (_iroot(n, k) - 1)
+    return total

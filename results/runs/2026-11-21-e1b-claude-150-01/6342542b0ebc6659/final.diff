diff --git a/solution.py b/solution.py
index b3305e6..706c22a 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,21 @@ def count_event_ways(n: int, x: int, y: int) -> int:
     >>> count_event_ways(3, 3, 4)
     684
     """
-    pass
+    MOD = 10**9 + 7
+    m = min(n, x)
+    # S[k] = Stirling numbers of the second kind S(i, k), built up to i = n
+    S = [1] + [0] * m
+    for i in range(1, n + 1):
+        for k in range(min(i, m), 0, -1):
+            S[k] = (S[k - 1] + k * S[k]) % MOD
+        S[0] = 0
+    total = 0
+    comb = 1
+    fact = 1
+    ypow = 1
+    for k in range(1, m + 1):
+        comb = comb * (x - k + 1) % MOD * pow(k, MOD - 2, MOD) % MOD
+        fact = fact * k % MOD
+        ypow = ypow * y % MOD
+        total = (total + comb * S[k] % MOD * fact % MOD * ypow) % MOD
+    return total

+import numpy as np
+
+MOD = 998244353
+
+
+def _build_dfa():
+    # NFA state: (first non-one in-degree on the cycle, last non-one); None until seen
+    def step(state, d, s):
+        f, l = state
+        out = []
+        for t in ((0, 1) if s else (0,)):
+            c = d - t
+            if c < 0 or c > 2:
+                continue
+            if c == 1:
+                out.append(state)
+            elif l is None:
+                out.append((c, c))
+            elif l != c:
+                out.append((f, c))
+        return out
+
+    start = frozenset([(None, None)])
+    index = {start: 0}
+    order = [start]
+    trans = [[], []]  # trans[s] -> list of (src, dst)
+    i = 0
+    while i < len(order):
+        S = order[i]
+        for s in (0, 1):
+            for d in range(4):
+                T = frozenset(x for st in S for x in step(st, d, s))
+                if not T:
+                    continue
+                if T not in index:
+                    index[T] = len(order)
+                    order.append(T)
+                trans[s].append((i, index[T]))
+        i += 1
+    n = len(order)
+    mats = []
+    for s in (0, 1):
+        M = np.zeros((n, n), dtype=np.int64)
+        for a, b in trans[s]:
+            M[a, b] += 1
+        mats.append(M)
+    accept = [
+        any(f is None or f != l for f, l in S) for S in order
+    ]
+    return mats, accept
+
+
+_MATS, _ACCEPT = _build_dfa()
+
+
 def count_in_degree_sequences(n: int, s: str) -> int:
-    """ Given a positive integer n and a string s of length n consisting of '0' and '1',
-    construct a graph G with (n+1) vertices numbered 0 to n, with the following edges:
-    - For each i from 0 to n-1, there's an edge between vertices i and (i+1) mod n
-    - For each i from 0 to n-1, there's an edge between vertices i and n if s[i] == '1'
-    
-    Create a directed graph G' by assigning a direction to each edge of G.
-    For each vertex i, let d_i be its in-degree in G'.
-    
-    Return the number of distinct sequences (d_0, d_1, ..., d_n) that can be obtained,
-    modulo 998244353.
-    
-    Args:
-        n: A positive integer (3 <= n <= 10^6)
-        s: A string of length n consisting only of '0' and '1'
-    
-    Returns:
-        The number of distinct in-degree sequences modulo 998244353
-    
-    >>> count_in_degree_sequences(3, '010')
-    14
-    >>> count_in_degree_sequences(20, '00001100111010100101')
-    261339902
-    """
-    pass
+    k = len(_ACCEPT)
+    v = np.zeros(k, dtype=np.int64)
+    v[0] = 1
+    # process runs of equal characters with matrix powers
+    def mpow(M, e):
+        R = np.eye(k, dtype=np.int64)
+        while e:
+            if e & 1:
+                R = mm(R, M)
+            M = mm(M, M)
+            e >>= 1
+        return R
+
+    def mm(A, B):
+        # split to avoid int64 overflow
+        lo = B & 0x7FFF
+        hi = B >> 15
+        return ((A @ lo) % MOD + (((A @ hi) % MOD) << 15)) % MOD
+
+    i = 0
+    while i < n:
+        j = i
+        while j < n and s[j] == s[i]:
+            j += 1
+        M = _MATS[int(s[i])]
+        e = j - i
+        if e <= 8:
+            for _ in range(e):
+                v = (v @ M) % MOD
+        else:
+            P = mpow(M, e)
+            v = mm(v.reshape(1, k), P).reshape(k)
+        i = j
+    return int(sum(int(v[x]) for x in range(k) if _ACCEPT[x]) % MOD)

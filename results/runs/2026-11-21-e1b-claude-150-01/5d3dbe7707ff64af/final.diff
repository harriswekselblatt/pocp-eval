diff --git a/solution.py b/solution.py
index 0b61e39..bf5067e 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,36 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    pass
+    grid = [[False] * w for _ in range(h)]
+    used = [False] * len(tiles)
+
+    def solve(pos: int) -> bool:
+        while pos < h * w and grid[pos // w][pos % w]:
+            pos += 1
+        if pos == h * w:
+            return True
+        r, c = divmod(pos, w)
+        tried = set()
+        for i, (a, b) in enumerate(tiles):
+            if used[i] or (a, b) in tried:
+                continue
+            tried.add((a, b))
+            for th, tw in {(a, b), (b, a)}:
+                if r + th > h or c + tw > w:
+                    continue
+                if any(grid[r + dr][c + dc] for dr in range(th) for dc in range(tw)):
+                    continue
+                for dr in range(th):
+                    for dc in range(tw):
+                        grid[r + dr][c + dc] = True
+                used[i] = True
+                ok = solve(pos + 1)
+                used[i] = False
+                for dr in range(th):
+                    for dc in range(tw):
+                        grid[r + dr][c + dc] = False
+                if ok:
+                    return True
+        return False
+
+    return solve(0)

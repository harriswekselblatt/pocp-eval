-    pass
+    """Determine if a subset of the (rotatable) tiles can exactly tile an h x w grid."""
+    tiles = tiles[:n]
+    grid = [[False] * w for _ in range(h)]
+
+    def solve(used: int) -> bool:
+        pos = next(((r, c) for r in range(h) for c in range(w) if not grid[r][c]), None)
+        if pos is None:
+            return True
+        r, c = pos
+        for i, (a, b) in enumerate(tiles):
+            if used >> i & 1:
+                continue
+            for th, tw in {(a, b), (b, a)}:
+                if r + th > h or c + tw > w:
+                    continue
+                if any(grid[r + dr][c + dc] for dr in range(th) for dc in range(tw)):
+                    continue
+                for dr in range(th):
+                    for dc in range(tw):
+                        grid[r + dr][c + dc] = True
+                if solve(used | 1 << i):
+                    return True
+                for dr in range(th):
+                    for dc in range(tw):
+                        grid[r + dr][c + dc] = False
+        return False
+
+    return solve(0)

diff --git a/solution.py b/solution.py
index 2edca9e..b9f56cb 100644
--- a/solution.py
+++ b/solution.py
@@ -29,4 +29,27 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    pass
+    from collections import deque
+    if s == t:
+        return 0
+    start = s + '..'
+    goal = t + '..'
+    dist = {start: 0}
+    q = deque([start])
+    while q:
+        cur = q.popleft()
+        d = dist[cur]
+        p = cur.index('.')
+        for i in range(n + 1):
+            if i + 1 >= p and i <= p + 1:
+                continue
+            lst = list(cur)
+            lst[p], lst[p + 1] = cur[i], cur[i + 1]
+            lst[i] = lst[i + 1] = '.'
+            nxt = ''.join(lst)
+            if nxt not in dist:
+                if nxt == goal:
+                    return d + 1
+                dist[nxt] = d + 1
+                q.append(nxt)
+    return -1

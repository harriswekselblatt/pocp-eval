+MOD = 998244353
+
+
 def count_in_degree_sequences(n: int, s: str) -> int:
-    """ Given a positive integer n and a string s of length n consisting of '0' and '1',
-    construct a graph G with (n+1) vertices numbered 0 to n, with the following edges:
-    - For each i from 0 to n-1, there's an edge between vertices i and (i+1) mod n
-    - For each i from 0 to n-1, there's an edge between vertices i and n if s[i] == '1'
-    
-    Create a directed graph G' by assigning a direction to each edge of G.
-    For each vertex i, let d_i be its in-degree in G'.
-    
-    Return the number of distinct sequences (d_0, d_1, ..., d_n) that can be obtained,
-    modulo 998244353.
-    
-    Args:
-        n: A positive integer (3 <= n <= 10^6)
-        s: A string of length n consisting only of '0' and '1'
-    
-    Returns:
-        The number of distinct in-degree sequences modulo 998244353
-    
-    >>> count_in_degree_sequences(3, '010')
-    14
-    >>> count_in_degree_sequences(20, '00001100111010100101')
-    261339902
+    """Count distinct in-degree sequences of orientations of a cycle plus an apex vertex.
+
+    The apex's in-degree is determined by the cycle vertices' in-degrees, so we count
+    distinct cycle sequences d_i = x_{i-1} + 1 - x_i + t_i (x = cycle edge orientations,
+    t_i <= s_i = apex edge orientation) via a subset-construction DFA over pairs
+    (x_start, x_current).
     """
-    pass
+    start = frozenset([(0, 0), (1, 1)])
+    trans = {}
+    ids = {start: 0}
+    order = [start]
+
+    def step(state, ch, d):
+        res = set()
+        for a, b in state:
+            for nb in (0, 1):
+                t = d - (b + 1 - nb)
+                if 0 <= t <= ch:
+                    res.add((a, nb))
+        return frozenset(res)
+
+    i = 0
+    while i < len(order):
+        st = order[i]
+        for ch in (0, 1):
+            agg = {}
+            for d in range(4):
+                nxt = step(st, ch, d)
+                if not nxt:
+                    continue
+                if nxt not in ids:
+                    ids[nxt] = len(order)
+                    order.append(nxt)
+                j = ids[nxt]
+                agg[j] = agg.get(j, 0) + 1
+            trans[(i, ch)] = list(agg.items())
+        i += 1
+
+    m = len(order)
+    tab = [[trans[(u, ch)] for u in range(m)] for ch in (0, 1)]
+    dp = [0] * m
+    dp[0] = 1
+    for c in s:
+        tc = tab[1 if c == '1' else 0]
+        nd = [0] * m
+        for u in range(m):
+            v = dp[u]
+            if v:
+                for w, k in tc[u]:
+                    nd[w] += v * k
+        dp = [x % MOD for x in nd]
+    ans = 0
+    for u in range(m):
+        if any(a == b for a, b in order[u]):
+            ans += dp[u]
+    return ans % MOD

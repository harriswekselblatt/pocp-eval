+MOD = 998244353
+
+# NFA states: 0 = no extreme seen; (first, expect) with first/expect in {0, 2} -> 1 + 2*(first==2) + (expect==2)
+_ACCEPT = {0, 1, 4}  # N, (first=0, expect=0), (first=2, expect=2)
+
+
+def _nfa_step(state, c):
+    if c == 1:
+        return state
+    if state == 0:
+        return 1 + 2 * (c == 2) + (0 if c == 2 else 1)
+    first2 = (state - 1) // 2
+    expect2 = (state - 1) % 2
+    if (c == 2) is not bool(expect2):
+        return None
+    return 1 + 2 * first2 + (0 if c == 2 else 1)
+
+
+def _subset_step(subset, d, has_hub):
+    res = 0
+    for st in range(5):
+        if subset >> st & 1:
+            for h in ((0, 1) if has_hub else (0,)):
+                c = d - h
+                if 0 <= c <= 2:
+                    nx = _nfa_step(st, c)
+                    if nx is not None:
+                        res |= 1 << nx
+    return res
+
+
 def count_in_degree_sequences(n: int, s: str) -> int:
-    """ Given a positive integer n and a string s of length n consisting of '0' and '1',
-    construct a graph G with (n+1) vertices numbered 0 to n, with the following edges:
-    - For each i from 0 to n-1, there's an edge between vertices i and (i+1) mod n
-    - For each i from 0 to n-1, there's an edge between vertices i and n if s[i] == '1'
-    
-    Create a directed graph G' by assigning a direction to each edge of G.
-    For each vertex i, let d_i be its in-degree in G'.
-    
-    Return the number of distinct sequences (d_0, d_1, ..., d_n) that can be obtained,
-    modulo 998244353.
-    
-    Args:
-        n: A positive integer (3 <= n <= 10^6)
-        s: A string of length n consisting only of '0' and '1'
-    
-    Returns:
-        The number of distinct in-degree sequences modulo 998244353
-    
-    >>> count_in_degree_sequences(3, '010')
-    14
-    >>> count_in_degree_sequences(20, '00001100111010100101')
-    261339902
-    """
-    pass
+    ids = {1: 0}
+    order = [1]
+    trans = {0: [], 1: []}
+    i = 0
+    while i < len(order):
+        sub = order[i]
+        i += 1
+        for t in (0, 1):
+            row = []
+            for d in range(4):
+                nx = _subset_step(sub, d, t == 1)
+                if nx == 0:
+                    row.append(-1)
+                    continue
+                if nx not in ids:
+                    ids[nx] = len(order)
+                    order.append(nx)
+                row.append(ids[nx])
+            trans[t].append(row)
+    k = len(order)
+    # trans[t] has rows only for states discovered so far; ensure complete
+    for t in (0, 1):
+        while len(trans[t]) < k:
+            raise AssertionError
+    moves = {t: [[(j, nx) for j, nx in enumerate(trans[t][a]) if nx >= 0] for a in range(k)]
+             for t in (0, 1)}
+    # moves[t][a] = list of (d, next); fold to per-state target multiset
+    tgt = {t: [[nx for _, nx in moves[t][a]] for a in range(k)] for t in (0, 1)}
+    cur = [0] * k
+    cur[0] = 1
+    for ch in s:
+        tg = tgt[1 if ch == '1' else 0]
+        new = [0] * k
+        for a in range(k):
+            v = cur[a]
+            if v:
+                for b in tg[a]:
+                    new[b] += v
+        cur = [x % MOD for x in new]
+    acc = 0
+    for sub, idx in ids.items():
+        if any(sub >> st & 1 for st in _ACCEPT):
+            acc += cur[idx]
+    return acc % MOD

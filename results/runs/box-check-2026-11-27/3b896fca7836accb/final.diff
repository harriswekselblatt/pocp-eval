@@ -1,3 +1,42 @@
+MOD = 998244353
+
+
+def _build_transitions():
+    # state: (A, B) bitmasks over last nonzero sign {bit0: '+', bit1: '-'},
+    # A = reachable from start '+', B = reachable from start '-'
+    def step_set(mask, ys):
+        out = 0
+        for q in (0, 1):
+            if not mask >> q & 1:
+                continue
+            for y in ys:
+                if y == 0:
+                    out |= 1 << q
+                elif y == 1 and q == 1:
+                    out |= 1
+                elif y == -1 and q == 0:
+                    out |= 2
+        return out
+
+    ys_by_w = {
+        0: {-1: [-1], 0: [0], 1: [1], 2: []},
+        1: {-1: [-1], 0: [0, -1], 1: [0, 1], 2: [1]},
+    }
+    trans = []
+    for c in (0, 1):
+        t = {}
+        for A in range(4):
+            for B in range(4):
+                for w, ys in ys_by_w[c].items():
+                    if not ys:
+                        continue
+                    ns = (step_set(A, ys), step_set(B, ys))
+                    t.setdefault((A, B), {})
+                    t[(A, B)][ns] = t[(A, B)].get(ns, 0) + 1
+        trans.append(t)
+    return trans
+
+
 def count_in_degree_sequences(n: int, s: str) -> int:
     """ Given a positive integer n and a string s of length n consisting of '0' and '1',
     construct a graph G with (n+1) vertices numbered 0 to n, with the following edges:
@@ -22,4 +61,18 @@ def count_in_degree_sequences(n: int, s: str) -> int:
     >>> count_in_degree_sequences(20, '00001100111010100101')
     261339902
     """
-    pass
+    trans = _build_transitions()
+    start = (1, 2)
+    states = {start: 1}
+    for ch in s:
+        t = trans[1 if ch == '1' else 0]
+        new = {}
+        for st, cnt in states.items():
+            for ns, m in t[st].items():
+                new[ns] = (new.get(ns, 0) + cnt * m) % MOD
+        states = new
+    total = 0
+    for (A, B), cnt in states.items():
+        if (A & 1) or (B & 2):
+            total += cnt
+    return total % MOD

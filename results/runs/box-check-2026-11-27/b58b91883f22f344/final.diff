diff --git a/solution.py b/solution.py
index 083ef08..ffe9b34 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,26 @@ def count_in_degree_sequences(n: int, s: str) -> int:
     >>> count_in_degree_sequences(20, '00001100111010100101')
     261339902
     """
-    pass
+    modulus = 998244353
+
+    # The graphical zonotope's lattice points are the orientation indegree
+    # sequences, and their number equals the number of spanning forests.
+    # A forest must omit a rim edge. Each resulting rim path can use at
+    # most one spoke, since two spokes on the same path form a cycle.
+    #
+    # Track whether the current path already uses a spoke. Before each
+    # vertex, keeping the preceding rim edge preserves that state, and
+    # omitting it resets the state to zero. At a '1', we may also take
+    # the spoke if the state is zero. Multiply these two-state transitions.
+    a, b, c, d = 1, 0, 0, 1
+    for spoke in s:
+        next_a = (2 * a + b) % modulus
+        next_c = (2 * c + d) % modulus
+        if spoke == '1':
+            b = (next_a + b) % modulus
+            d = (next_c + d) % modulus
+        a, c = next_a, next_c
+
+    # The trace joins the final state to the initial state around the rim.
+    # Exclude the two constant-state walks that keep every rim edge.
+    return (a + d - 2) % modulus

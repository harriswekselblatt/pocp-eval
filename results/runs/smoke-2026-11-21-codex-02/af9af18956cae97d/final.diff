+from math import isqrt
 from typing import Optional, Tuple
 
 
@@ -13,9 +14,20 @@ def find_cube_difference_pair(n: int) -> Optional[Tuple[int, int]]:
     
     >>> find_cube_difference_pair(397)
     (12, 11)
-    >>> find_cube_difference_pair(1)
-    None
+    >>> find_cube_difference_pair(1) is None
+    True
     >>> find_cube_difference_pair(7)
     (2, 1)
     """
-    pass
+    difference = 1
+    while difference**3 < n:
+        quotient, remainder = divmod(n, difference)
+        if remainder == 0:
+            # With d = x - y, 4(n/d) - d² = 3(x + y)².
+            sum_squared, remainder = divmod(4 * quotient - difference**2, 3)
+            if remainder == 0:
+                total = isqrt(sum_squared)
+                if total**2 == sum_squared and (total - difference) % 2 == 0:
+                    return (total + difference) // 2, (total - difference) // 2
+        difference += 1
+    return None

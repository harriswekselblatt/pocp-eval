index 01dc387..a3c28f5 100644
--- a/solution.py
+++ b/solution.py
@@ -1,3 +1,4 @@
+from functools import lru_cache
 from typing import List, Tuple
 
 
@@ -20,4 +21,18 @@ def card_game_winner(n: int, cards: List[Tuple[int, int]]) -> str:
     >>> card_game_winner(9, [(3, 2), (1, 7), (4, 1), (1, 8), (5, 2), (9, 8), (2, 1), (6, 8), (5, 2)])
     'Takahashi'
     """
-    pass
+    pair_masks = []
+    for i, (front, back) in enumerate(cards):
+        for j in range(i + 1, n):
+            other_front, other_back = cards[j]
+            if front == other_front or back == other_back:
+                pair_masks.append((1 << i) | (1 << j))
+
+    @lru_cache(maxsize=None)
+    def can_win(remaining: int) -> bool:
+        for pair in pair_masks:
+            if remaining & pair == pair and not can_win(remaining ^ pair):
+                return True
+        return False
+
+    return "Takahashi" if can_win((1 << n) - 1) else "Aoki"

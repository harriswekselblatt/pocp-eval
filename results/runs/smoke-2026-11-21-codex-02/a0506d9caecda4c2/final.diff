+from math import isqrt
 from typing import Optional, Tuple
 
 
@@ -13,9 +14,23 @@ def find_cube_difference_pair(n: int) -> Optional[Tuple[int, int]]:
     
     >>> find_cube_difference_pair(397)
     (12, 11)
-    >>> find_cube_difference_pair(1)
-    None
+    >>> find_cube_difference_pair(1) is None
+    True
     >>> find_cube_difference_pair(7)
     (2, 1)
     """
-    pass
+    # With d = x - y, n = d * (3*y*y + 3*d*y + d*d).
+    # Since d**3 < n <= 10**18, d is less than one million.
+    for d in range(1, 1_000_000):
+        if d**3 >= n:
+            break
+        quotient, remainder = divmod(n, d)
+        if remainder == 0:
+            # The discriminant of the quadratic in y is (6*y + 3*d)**2.
+            discriminant = 12 * quotient - 3 * d * d
+            root = isqrt(discriminant)
+            if root * root == discriminant:
+                y, remainder = divmod(root - 3 * d, 6)
+                if remainder == 0 and y > 0:
+                    return y + d, y
+    return None

+    partners = [0] * n
+    for i, (front, back) in enumerate(cards):
+        for j in range(i + 1, n):
+            other_front, other_back = cards[j]
+            if front == other_front or back == other_back:
+                partners[i] |= 1 << j
+
+    @lru_cache(maxsize=None)
+    def can_win(remaining: int) -> bool:
+        first_cards = remaining
+        while first_cards:
+            first = first_cards & -first_cards
+            first_cards ^= first
+            seconds = partners[first.bit_length() - 1] & first_cards
+            while seconds:
+                second = seconds & -seconds
+                if not can_win(remaining ^ first ^ second):
+                    return True
+                seconds ^= second
+        return False
+
+    return "Takahashi" if can_win((1 << n) - 1) else "Aoki"

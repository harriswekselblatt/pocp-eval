+from functools import lru_cache
 from typing import List, Tuple
 
 
@@ -20,4 +21,25 @@ def card_game_winner(n: int, cards: List[Tuple[int, int]]) -> str:
     >>> card_game_winner(9, [(3, 2), (1, 7), (4, 1), (1, 8), (5, 2), (9, 8), (2, 1), (6, 8), (5, 2)])

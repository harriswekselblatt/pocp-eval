+from math import isqrt
 from typing import Optional, Tuple
 
 
@@ -13,9 +14,21 @@ def find_cube_difference_pair(n: int) -> Optional[Tuple[int, int]]:
     
     >>> find_cube_difference_pair(397)
     (12, 11)
-    >>> find_cube_difference_pair(1)
-    None
+    >>> find_cube_difference_pair(1) is None
+    True
     >>> find_cube_difference_pair(7)
     (2, 1)
     """
-    pass
+    # With d = x - y, n = d * (3*y*y + 3*d*y + d*d) > d**3.
+    d = 1
+    while d**3 < n:
+        quotient, remainder = divmod(n, d)
+        if remainder == 0:
+            # Writing s = x + y gives 4*n/d = 3*s*s + d*d.
+            sum_squared, remainder = divmod(4 * quotient - d * d, 3)
+            if remainder == 0:
+                s = isqrt(sum_squared)
+                if s * s == sum_squared and s > d and (s - d) % 2 == 0:
+                    return (s + d) // 2, (s - d) // 2
+        d += 1
+    return None
